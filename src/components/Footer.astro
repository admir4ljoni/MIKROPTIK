---
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="footer-container">
  <div class="container footer-content-wrapper">
    <div class="footer-grid">
      <!-- Column 1: Logo & Teks Brand (Pojok Kiri Footer) -->
      <div class="footer-brand-col">
        <div class="footer-logo-row">
          <img src={`${baseUrl}assets/logo_kabinet_full.svg`} alt="Logo Kabinet Naya Vikrama" class="footer-logo-kabinet" />
          <img src={`${baseUrl}assets/logo-himpunan.png`} alt="Logo HMP MIKROPTIK" />
          <img src={`${baseUrl}assets/logo-ptik.png`} alt="Logo PTIK UNS" />
        </div>
        <h3 class="footer-brand-title">MIKROPTIK</h3>
        <p class="footer-brand-desc">
          Himpunan Mahasiswa Pendidikan Teknik Informatika dan Komputer,<br />
          Fakultas Keguruan dan Ilmu Pendidikan, Universitas Sebelas Maret.
        </p>
      </div>

      <!-- Column 2: Sekretariat, Kontak & Icon Sosial Media (Pojok Kanan Footer) -->
      <div class="footer-contact-col">
        <h4 class="footer-col-heading">Sekretariat & Sosial Media</h4>
        <p class="footer-address">
          <span>Kampus V JPTK FKIP UNS, Jl. Jend. Ahmad Yani No. 200, Pabelan, Kartasura, Sukoharjo, Jawa Tengah 57162</span>
          <i class="fa-solid fa-location-dot footer-address-icon" aria-hidden="true"></i>
        </p>

        <!-- Social Media External FontAwesome Icons -->
        <div class="footer-social-row">
          <!-- Instagram -->
          <a
            href="https://instagram.com/mikroptik_uns"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-icon-btn"
            aria-label="Instagram MIKROPTIK"
            title="Instagram MIKROPTIK"
          >
            <i class="fa-brands fa-instagram"></i>
          </a>

          <!-- YouTube -->
          <a
            href="https://youtube.com/@mikroptikuns"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-icon-btn"
            aria-label="YouTube MIKROPTIK"
            title="YouTube MIKROPTIK"
          >
            <i class="fa-brands fa-youtube"></i>
          </a>

          <!-- TikTok -->
          <a
            href="https://tiktok.com/@mikroptik_uns"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-icon-btn"
            aria-label="TikTok MIKROPTIK"
            title="TikTok MIKROPTIK"
          >
            <i class="fa-brands fa-tiktok"></i>
          </a>

          <!-- X (Twitter) -->
          <a
            href="https://x.com/mikroptik_uns"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-social-icon-btn"
            aria-label="X (Twitter) MIKROPTIK"
            title="X (Twitter) MIKROPTIK"
          >
            <i class="fa-brands fa-x-twitter"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; 2026 HMP MIKROPTIK - Kabinet Naya Vikrama. All Rights Reserved.</p>
  </div>
</footer>
