---
const bentoItems = [
  {
    id: 1,
    title: "INFORMATICS COMPASS 2025",
    subtitle: "Rangkaian Pembekalan & Adaptasi",
    description: "Program pembekalan dan pengenalan dunia perkuliahan, budaya akademik, serta kurikulum prodi PTIK UNS bagi seluruh mahasiswa baru.",
    image: "https://picsum.photos/seed/proker1/1000/700",
    gridClass: "bento-col-2 bento-row-2"
  },
  {
    id: 2,
    title: "TECHNOFEST COMPETITION",
    subtitle: "Ajang Kompetisi IT Nasional",
    description: "Kompetisi nasional Web Development, UI/UX Design, dan Competitive Programming untuk mencetak inovator muda.",
    image: "https://picsum.photos/seed/proker2/700/1000",
    gridClass: "bento-col-1 bento-row-2"
  },
  {
    id: 3,
    title: "PTIK GOES TO COMMUNITY",
    subtitle: "Pengabdian & Literasi Digital",
    description: "Pelatihan literasi digital, branding sosial media, dan pembuatan website bagi UMKM desa binaan secara berkelanjutan.",
    image: "https://picsum.photos/seed/proker3/800/600",
    gridClass: "bento-col-1 bento-row-2"
  },
  {
    id: 4,
    title: "WORKSHOP & STUDY CLUB TECH",
    subtitle: "Pengembangan Skill Software",
    description: "Sesi harian & bulanan pengasahan skill coding, cloud, dan AI bersama praktisi alumni industri teknologi.",
    image: "https://picsum.photos/seed/proker4/800/600",
    gridClass: "bento-col-1 bento-row-1"
  },
  {
    id: 5,
    title: "PTIK CAREER & ALUMNI EXPO",
    subtitle: "Jejaring Karir & Industri",
    description: "Ajang temu alumni dan perusahaan mitra IT untuk membuka wawasan karir serta peluang magang mahasiswa.",
    image: "https://picsum.photos/seed/proker5/800/600",
    gridClass: "bento-col-1 bento-row-1"
  },
  {
    id: 6,
    title: "LKMM-TD NAYA VIKRAMA",
    subtitle: "Kaderisasi & Manajerial",
    description: "Latihan Keterampilan Manajemen Mahasiswa Tingkat Dasar untuk mencetak calon pemimpin proaktif.",
    image: "https://picsum.photos/seed/proker6/1000/600",
    gridClass: "bento-col-2 bento-row-1"
  },
  {
    id: 7,
    title: "PTIK SPORT & ART FESTIVAL",
    subtitle: "Ajang Minat & Bakat",
    description: "Pekan olahraga, e-sports, dan seni untuk mempererat solidaritas antar angkatan civitas akademika PTIK.",
    image: "https://picsum.photos/seed/proker7/1000/600",
    gridClass: "bento-col-2 bento-row-1"
  },
  {
    id: 8,
    title: "COMPILATION MAGAZINE & RESEARCH",
    subtitle: "Publikasi Riset & Jurnalistik",
    description: "Wadah penerbitan karya tulis ilmiah, proyek software terbaik, dan buletin seputar perkembangan teknologi kampus.",
    image: "https://picsum.photos/seed/proker8/1000/600",
    gridClass: "bento-col-2 bento-row-1"
  }
];
---

<div class="proker-bento-fullwidth-wrapper">
  <div class="proker-bento-grid">
    {bentoItems.map((item) => (
      <article class={`bento-card ${item.gridClass}`}>
        <!-- Background Full Image -->
        <img src={item.image} alt={item.title} class="bento-bg-img" loading="lazy" />

        <!-- Bottom Shadow Overlay Gradient -->
        <div class="bento-card-overlay">
          <div class="bento-card-content">
            <span class="bento-subtitle">{item.subtitle}</span>
            <h3 class="bento-title">{item.title}</h3>
            <p class="bento-desc">{item.description}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .proker-bento-fullwidth-wrapper {
    position: relative;
    width: 100%;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    margin-top: 1.5rem;
  }

  .proker-bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 260px;
    gap: 1.25rem;
    width: 100%;
  }

  /* Base Bento Card Style - Style Tegas (Corner Radius Kecil 4px, Border-Free) */
  .bento-card {
    position: relative;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    overflow: hidden;
    border: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
    cursor: pointer;
  }

  .bento-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(130, 9, 7, 0.45);
  }

  /* Compact Mosaic Grid Spans */
  .bento-col-1 {
    grid-column: span 1;
  }

  .bento-col-2 {
    grid-column: span 2;
  }

  .bento-row-1 {
    grid-row: span 1;
  }

  .bento-row-2 {
    grid-row: span 2;
  }

  /* Image Background Zoom */
  .bento-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover .bento-bg-img {
    transform: scale(1.06);
  }

  /* Bottom Shadow Overlay Gradient */
  .bento-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem;
    background: linear-gradient(
      to top,
      rgba(28, 22, 20, 0.97) 0%,
      rgba(28, 22, 20, 0.82) 45%,
      rgba(28, 22, 20, 0.25) 75%,
      transparent 100%
    );
    z-index: 2;
  }

  .bento-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .bento-subtitle {
    font-family: var(--font-heading);
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    color: var(--color-gold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .bento-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.2vw, 2.3rem);
    color: var(--color-white);
    line-height: 1.05;
    letter-spacing: 0.05em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .bento-desc {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 0.95vw, 0.98rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Responsive Mobile Adjustments */
  @media (max-width: 1100px) {
    .proker-bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 280px;
    }
  }

  @media (max-width: 768px) {
    .proker-bento-fullwidth-wrapper {
      padding: 0 0.75rem;
    }

    .proker-bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 320px;
      gap: 1rem;
    }

    .bento-col-1,
    .bento-col-2,
    .bento-row-1,
    .bento-row-2 {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
