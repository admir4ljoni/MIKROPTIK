---
interface Props {
  title: string;
  description: string;
  image?: string;
  date?: string;
}

const {
  title,
  description,
  image = "https://picsum.photos/seed/proker/600/400",
  date = "2025/2026",
} = Astro.props;
---

<article class="program-card gsap-card-item">
  <img src={image} alt={title} class="program-card-img" loading="lazy" />
  <div class="program-card-overlay"></div>
  <div class="program-card-body">
    <span class="program-card-date">{date}</span>
    <h3 class="program-card-title">{title}</h3>
    <p class="program-card-desc">{description}</p>
  </div>
</article>
