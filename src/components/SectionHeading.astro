---
interface Props {
  titleMain: string;
  titleAccent?: string;
  subtitle?: string;
  light?: boolean;
  align?: 'left' | 'center' | 'right';
}

const { 
  titleMain, 
  titleAccent = "", 
  subtitle = "", 
  light = false,
  align = 'center' 
} = Astro.props;
---

<div class={`section-heading-wrapper ${light ? 'light' : ''}`} style={`text-align: ${align};`}>
  <h2 class="section-heading-title gsap-reveal-heading">
    {titleMain}
    {titleAccent && <span class="text-accent-highlight">{titleAccent}</span>}
  </h2>
  {subtitle && <p class="section-heading-subtitle" style={`max-width: 600px; ${align === 'center' ? 'margin: 0.5rem auto 0;' : 'margin-top: 0.5rem;'}`}>{subtitle}</p>}
  <div class="section-heading-line" style={align !== 'center' ? 'margin-left: 0;' : ''}></div>
</div>
