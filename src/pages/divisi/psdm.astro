---
import DivisiLayout from "../../layouts/DivisiLayout.astro";
import DivisiHero from "../../components/DivisiHero.astro";
import DivisiProker from "../../components/DivisiProker.astro";
import DivisiFotoGaleri from "../../components/DivisiFotoGaleri.astro";
import DivisiSplitSection from "../../components/DivisiSplitSection.astro";
import SectionHeading from "../../components/SectionHeading.astro";

const divisiData = {
  name: "PSDM",
  badge: "DIVISI PSDM",
  tagline: "Pengembangan Potensi, Kompetensi & Karakter",
  slug: "psdm",
  bgImage: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO BERSAMA.webp",
  fotoKadiv: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO KADIV.webp",
  fotoStaffAhli: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF AHLI.webp",
  fotoStaffMuda1: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF MUDA 1.webp",
  fotoStaffMuda2: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF MUDA 2.webp",
  description:
    "Divisi Pengembangan Sumber Daya Mahasiswa (PSDM) HMP MIKROPTIK Kabinet Naya Vikrama merupakan divisi yang berfokus pada pengembangan potensi, kompetensi, dan karakter mahasiswa PTIK. PSDM berperan sebagai wadah sekaligus fasilitator bagi mahasiswa baru dalam beradaptasi dengan lingkungan perkuliahan, mengembangkan diri, serta membangun relasi di lingkungan kampus. Melalui berbagai program kerja, seperti Open Recruitment, PSDM juga membuka kesempatan bagi mahasiswa untuk bergabung, berkontribusi, dan bertumbuh bersama dalam organisasi.",
  proker: [
    "PSDM ADVENTURE",
    "SAMARU (Sambut Mahasiswa Baru)",
    "OSMARU (Orientasi Mahasiswa Baru)",
    "LDKM (Latihan Keterampilan Manajemen Mahasiswa)",
    "OPEN RECRUITMENT PENGURUS",
    "REORGANISASI HIMPUNAN",
  ],
  galeri: [
    {
      title: "Foto Bersama Divisi PSDM",
      src: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO BERSAMA.webp",
      isFeatured: true,
    },
    {
      title: "Kadiv PSDM",
      src: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO KADIV.webp",
    },
    {
      title: "Staff Ahli PSDM",
      src: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF AHLI.webp",
    },
    {
      title: "Staff Muda PSDM 1",
      src: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF MUDA 1.webp",
    },
    {
      title: "Staff Muda PSDM 2",
      src: "/assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF MUDA 2.webp",
    },
  ],
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  divisiSlug={divisiData.slug}
  prevDivisi={{ name: "BENDAHARA UMUM", slug: "bendahara-umum" }}
  nextDivisi={{ name: "MIKAT", slug: "mikat" }}
>
  <!-- Hero Section (100vh) -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Fasilitator pengembangan karakter, kaderisasi, adaptasi mahasiswa baru, serta regenerasi kepengurusan himpunan."
    bgImage={divisiData.bgImage}
    bgPosition="center 58%"
    brightness={0.72}
  />

  <!-- Section 1: Deskripsi Profil paired with Foto Kadiv (60/40 Viewport Segment) -->
  <DivisiSplitSection
    imageSrc={divisiData.fotoKadiv}
    imageAlt="Kadiv PSDM"
    reverse={false}
  >
    <SectionHeading
      titleMain="PROFIL"
      titleAccent="Divisi"
      subtitle="Peran dan fokus utama Divisi PSDM dalam membentuk insan akademis yang berkarakter"
      align="left"
    />
    <div class="brutalist-profile-box">
      <p class="brutalist-desc-text">{divisiData.description}</p>
    </div>
  </DivisiSplitSection>

  <!-- Section 2: Program Kerja paired with Foto Staff Ahli (60/40 Viewport Segment) -->
  <DivisiProker
    prokerList={divisiData.proker}
    imageSrc={divisiData.fotoStaffAhli}
    reverse={true}
  />

  <!-- Section 3: Galeri Dokumentasi 1 paired with Foto Staff Muda 1 (60/40 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri.slice(0, 3)}
    imageSrc={divisiData.fotoStaffMuda1}
    reverse={false}
  />

  <!-- Section 4: Galeri Dokumentasi 2 paired with Foto Staff Muda 2 (60/40 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri.slice(2)}
    imageSrc={divisiData.fotoStaffMuda2}
    reverse={true}
  />
</DivisiLayout>
