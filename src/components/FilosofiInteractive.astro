---
import { Flame, Zap, Cpu, ShieldCheck, Sparkles } from '@lucide/astro';

const defaultPhilosophy = {
  id: 0,
  icon: Sparkles,
  tag: "SIMBOL UTAMA KABINET",
  title: "Logo Kabinet Naya Vikrama 2026",
  highlightText: "Semangat Baru, Ketangguhan & Keberanian Melangkah",
  description: "Logo Naya Vikrama menghadirkan makna tentang semangat baru, ketangguhan, dan keberanian dalam melangkah. Setiap elemen di dalamnya mencerminkan karakter HMP MIKROPTIK yang progresif, adaptif, dan selalu siap menghadapi tantangan. Arahkan kursor langsung ke bagian obor api, sayap, buku, atau perisai logo di sebelah kiri untuk melihat filosofi detailnya."
};

const logoParts = [
  {
    id: 1,
    partKey: "api",
    icon: Flame,
    tag: "OBOR KEPEMIMPINAN",
    title: "1. Api Menjulang Ke Atas",
    image: "logo_kabinet_api.png",
    highlightText: "Semangat, Keberanian & Ketegasan Memimpin",
    description: "Api yang menjulang ke atas mencerminkan semangat, keberanian, dan ketegasan dalam memimpin. Layaknya menyala yang tidak mudah padam, unsur ini menggambarkan kepemimpinan yang menjaga arah, memberikan inspirasi, serta berani mengambil keputusan dalam menghadapi setiap tantangan."
  },
  {
    id: 2,
    partKey: "sayap1",
    icon: Zap,
    tag: "KOLABORASI HARMONIS",
    title: "2. Enam Sayap Kanan & Kiri",
    image: "logo_kabinet_sayap_1.png",
    highlightText: "Sinergi 2 Bidang & 4 Divisi Organisasi",
    description: "Enam sayap di kanan dan kiri melambangkan dua bidang empat divisi: Bidang Sekertaris Umum, Bidang Bendahara Umum, Divisi PSDM, Divisi Humas, Divisi Media, Divisi Mikat. Bahwa organisasi bergerak oleh kolaborasi bidang & divisi yang bekerja harmonis untuk mencapai tujuan bersama."
  },
  {
    id: 3,
    partKey: "buku",
    icon: Cpu,
    tag: "LANDASAN KNOWLEDGE",
    title: "3. Buku & Kebebasan Berpikir",
    image: "logo_kabinet_buku.png",
    highlightText: "Landasan Pengetahuan & Rumah Belajar",
    description: "Buku-buku menjadi simbol bahwa setiap langkah dan kebebasan berfikir selalu berlandaskan pengetahuan, serta menegaskan peran organisasi sebagai rumah belajar bagi setiap anggotanya."
  },
  {
    id: 4,
    partKey: "sayap2",
    icon: ShieldCheck,
    tag: "FONDASI KOKOH",
    title: "4. Perisai Penopang Organisasi",
    image: "logo_kabinet_sayap_2.png",
    highlightText: "Nilai Dasar & Dukungan Solid",
    description: "Perisai penopang melambangkan fondasi yang kokoh yaitu nilai-nilai dasar, dukungan antar anggota, serta semangat kebersamaan yang menjadi akar dari setiap langkah. Bahwa organisasi mampu berdiri tegak dan melangkah maju karena memiliki penopang yang solid."
  }
];
---

<div class="filosofi-interactive-container" id="filosofi-interactive">
  <div class="filosofi-grid">
    <!-- SEBELAH KIRI: Pixel-Perfect Interactive Logo Stack -->
    <div class="filosofi-visual-left">
      <div class="logo-stack-box" id="logo-stack-box">
        <!-- Part 1: Api -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_api.png`}
          alt="Api Menjulang Ke Atas"
          class="logo-layer-img"
          data-part="1"
        />
        <!-- Part 2: Sayap 1 -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_sayap_1.png`}
          alt="Enam Sayap Kanan & Kiri"
          class="logo-layer-img"
          data-part="2"
        />
        <!-- Part 3: Buku -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_buku.png`}
          alt="Buku-buku Pengetahuan"
          class="logo-layer-img"
          data-part="3"
        />
        <!-- Part 4: Sayap 2 / Perisai -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_sayap_2.png`}
          alt="Perisai Penopang Organisasi"
          class="logo-layer-img"
          data-part="4"
        />

        <!-- Hint Text di bawah Logo -->
        <div class="logo-interactive-hint">
          <span>Arahkan kursor langsung ke gambar bentuk logo untuk melihat filosofinya</span>
        </div>
      </div>
    </div>

    <!-- SEBELAH KANAN: Dynamic Philosophy Card & Part Selectors -->
    <div class="filosofi-content-right">
      <!-- Default Philosophy Card -->
      <div class="filosofi-card active" id="card-part-0" data-card="0">
        <div class="filosofi-card-header">
          <span class="filosofi-badge-tag">
            <Sparkles size={16} style="display: inline-block; vertical-align: middle; margin-right: 6px;" />
            {defaultPhilosophy.tag}
          </span>
        </div>
        <h3 class="filosofi-card-title">{defaultPhilosophy.title}</h3>
        <p class="filosofi-card-highlight">{defaultPhilosophy.highlightText}</p>
        <p class="filosofi-card-desc">{defaultPhilosophy.description}</p>
      </div>

      <!-- Individual Parts Philosophy Cards -->
      {logoParts.map((part) => (
        <div class="filosofi-card" id={`card-part-${part.id}`} data-card={part.id}>
          <div class="filosofi-card-header">
            <span class="filosofi-badge-tag">
              <part.icon size={16} style="display: inline-block; vertical-align: middle; margin-right: 6px;" />
              {part.tag}
            </span>
          </div>
          <h3 class="filosofi-card-title">{part.title}</h3>
          <p class="filosofi-card-highlight">{part.highlightText}</p>
          <p class="filosofi-card-desc">{part.description}</p>
        </div>
      ))}

      <!-- Part Selector Quick List -->
      <div class="filosofi-part-list">
        {logoParts.map((part) => (
          <button
            class="filosofi-part-btn"
            data-part-trigger={part.id}
            aria-label={`Lihat filosofi ${part.title}`}
          >
            <span class="part-btn-num">0{part.id}</span>
            <span class="part-btn-title">{part.title}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .filosofi-interactive-container {
    position: relative;
    width: 100%;
    margin-top: 1.5rem;
  }

  .filosofi-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 3rem;
    align-items: center;
    width: 100%;
  }

  /* SEBELAH KIRI: Visual Container */
  .filosofi-visual-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .logo-stack-box {
    position: relative;
    width: clamp(300px, 36vw, 460px);
    height: clamp(300px, 36vw, 460px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    border-radius: var(--radius-sm);
    background: radial-gradient(circle at center, rgba(130, 9, 7, 0.25) 0%, rgba(28, 22, 20, 0.85) 70%);
    border: 1.5px solid rgba(212, 179, 84, 0.25);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
    cursor: crosshair;
  }

  /* Layer Images Stacked Absolutely (Pointer-events handled via pixel inspection) */
  .logo-layer-img {
    position: absolute;
    inset: 1.5rem;
    width: calc(100% - 3rem);
    height: calc(100% - 3rem);
    object-fit: contain;
    pointer-events: none;
    filter: grayscale(0%) opacity(1);
    transition: filter 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.4s ease;
    will-change: filter, transform, opacity;
  }

  /* State Saat Salah Satu Part Di-hover/Di-click */
  .logo-stack-box.is-hovered .logo-layer-img {
    filter: grayscale(100%) opacity(0.25);
    transform: scale(0.98);
  }

  .logo-stack-box.is-hovered .logo-layer-img.active-part {
    filter: grayscale(0%) opacity(1) drop-shadow(0 0 40px rgba(212, 179, 84, 0.9));
    transform: scale(1.06);
    z-index: 20;
  }

  .logo-interactive-hint {
    position: absolute;
    bottom: -2.4rem;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.05em;
    pointer-events: none;
  }

  /* SEBELAH KANAN: Philosophy Card Panel */
  .filosofi-content-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    min-height: 380px;
    justify-content: center;
  }

  /* Card Display Area */
  .filosofi-card {
    display: none;
    flex-direction: column;
    gap: 1rem;
    padding: 2.25rem;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    background: rgba(28, 22, 20, 0.85);
    backdrop-filter: blur(12px);
    border: 1.5px solid rgba(212, 179, 84, 0.3);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.45);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filosofi-card.active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .filosofi-card-header {
    display: flex;
    align-items: center;
  }

  .filosofi-badge-tag {
    background: rgba(130, 9, 7, 0.85);
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 179, 84, 0.4);
    text-transform: uppercase;
  }

  .filosofi-card-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw, 2.8rem);
    color: var(--color-white);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .filosofi-card-highlight {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    color: var(--color-gold);
    letter-spacing: 0.05em;
  }

  .filosofi-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.92rem, 1.1vw, 1.05rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.65;
  }

  /* Part Selector Buttons List */
  .filosofi-part-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }

  .filosofi-part-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body);
    font-size: 0.88rem;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: left;
  }

  .filosofi-part-btn:hover,
  .filosofi-part-btn.active-btn {
    background: rgba(130, 9, 7, 0.75);
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .part-btn-num {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-gold);
  }

  .part-btn-title {
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .filosofi-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .filosofi-part-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const stackBox = document.getElementById('logo-stack-box');
    const layerImgs = document.querySelectorAll('.logo-layer-img');
    const cards = document.querySelectorAll('.filosofi-card');
    const partBtns = document.querySelectorAll('.filosofi-part-btn');

    if (!stackBox || layerImgs.length === 0) return;

    let activePartId = '0';
    const partContexts: { [key: string]: CanvasRenderingContext2D } = {};
    const CANVAS_SIZE = 250;

    // Load each part PNG into offscreen canvas 2D contexts for 100% pixel-perfect alpha detection
    const imgElements = Array.from(layerImgs) as HTMLImageElement[];
    imgElements.forEach(img => {
      const partId = img.getAttribute('data-part') || '0';
      const c = document.createElement('canvas');
      c.width = CANVAS_SIZE;
      c.height = CANVAS_SIZE;
      const ctx = c.getContext('2d', { willReadFrequently: true });

      const tempImg = new Image();
      tempImg.crossOrigin = 'anonymous';
      tempImg.onload = () => {
        if (ctx) {
          ctx.drawImage(tempImg, 0, 0, CANVAS_SIZE, CANVAS_SIZE);
          partContexts[partId] = ctx;
        }
      };
      tempImg.src = img.src;
    });

    function activatePart(partId: string) {
      if (activePartId === partId) return;
      activePartId = partId;

      if (partId === '0') {
        stackBox.classList.remove('is-hovered');
        layerImgs.forEach(img => img.classList.remove('active-part'));
      } else {
        stackBox.classList.add('is-hovered');
        layerImgs.forEach(img => {
          if (img.getAttribute('data-part') === partId) {
            img.classList.add('active-part');
          } else {
            img.classList.remove('active-part');
          }
        });
      }

      cards.forEach(card => {
        if (card.getAttribute('data-card') === partId) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });

      partBtns.forEach(btn => {
        if (btn.getAttribute('data-part-trigger') === partId) {
          btn.classList.add('active-btn');
        } else {
          btn.classList.remove('active-btn');
        }
      });
    }

    // Inspect non-transparent pixels (alpha > 35) on the exact cursor position over the logo shapes
    function detectPartAtPosition(xRatio: number, yRatio: number): string {
      const px = Math.floor(xRatio * CANVAS_SIZE);
      const py = Math.floor(yRatio * CANVAS_SIZE);

      if (px < 0 || px >= CANVAS_SIZE || py < 0 || py >= CANVAS_SIZE) return '0';

      // Order of inspection: Api (1), Buku (3), Sayap Kanan (2), Sayap Kiri (4)
      const partOrder = ['1', '3', '2', '4'];
      for (const partId of partOrder) {
        const ctx = partContexts[partId];
        if (ctx) {
          try {
            const alpha = ctx.getImageData(px, py, 1, 1).data[3];
            if (alpha > 35) {
              return partId;
            }
          } catch (e) {
            // Ignore cross-origin canvas security errors
          }
        }
      }
      return '0';
    }

    // Mousemove directly over the visual logo box
    stackBox.addEventListener('mousemove', (e) => {
      const rect = stackBox.getBoundingClientRect();
      const xRatio = (e.clientX - rect.left) / rect.width;
      const yRatio = (e.clientY - rect.top) / rect.height;

      const detectedPart = detectPartAtPosition(xRatio, yRatio);
      activatePart(detectedPart);
    });

    stackBox.addEventListener('mouseleave', () => {
      activatePart('0');
    });

    // Touch support for mobile devices directly on logo box
    stackBox.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        const touch = e.touches[0];
        const rect = stackBox.getBoundingClientRect();
        const xRatio = (touch.clientX - rect.left) / rect.width;
        const yRatio = (touch.clientY - rect.top) / rect.height;

        const detectedPart = detectPartAtPosition(xRatio, yRatio);
        activatePart(detectedPart);
      }
    }, { passive: true });

    // Buttons fallback click/hover listeners
    partBtns.forEach(btn => {
      const partId = btn.getAttribute('data-part-trigger') || '0';

      btn.addEventListener('mouseenter', () => {
        activatePart(partId);
      });

      btn.addEventListener('click', () => {
        activatePart(partId);
      });
    });
  });
</script>
