---
import { ChevronLeft, ChevronRight, Info } from '@lucide/astro';

// Kosongkan kegiatan di kalender untuk saat ini sesuai permintaan
const eventsData: { [key: string]: Array<{ id: number; title: string; category: string; division: string; dateStr: string; location: string; desc: string }> } = {};

const monthNames = [
  "Januari", "Februari", "Maret", "April", "Mei", "Juni",
  "Juli", "Agustus", "September", "Oktober", "November", "Desember"
];
---

<div class="custom-calendar-section-wrapper" id="custom-calendar-root">
  <div class="custom-calendar-container">
    <!-- SEBELAH KIRI: Fixed-Height Monthly Calendar Grid -->
    <div class="calendar-grid-box">
      <!-- Calendar Header: Month Title & Navigation -->
      <div class="calendar-box-header">
        <div class="calendar-month-title">
          <span class="month-name-text" id="month-name-text">Agustus</span>
          <span class="year-gold-text" id="year-text">2026</span>
        </div>

        <div class="calendar-nav-buttons">
          <button class="cal-nav-btn" id="prev-month-btn" aria-label="Bulan Sebelumnya">
            <ChevronLeft size={18} />
          </button>
          <button class="cal-nav-btn" id="next-month-btn" aria-label="Bulan Berikutnya">
            <ChevronRight size={18} />
          </button>
        </div>
      </div>

      <!-- Days of Week Header (MIN - SAB) -->
      <div class="calendar-weekdays-row">
        <span>MIN</span>
        <span>SEN</span>
        <span>SEL</span>
        <span>RAB</span>
        <span>KAM</span>
        <span>JUM</span>
        <span>SAB</span>
      </div>

      <!-- Dates Grid Cells (Fixed 42 Cells: 6 Rows x 7 Days) -->
      <div class="calendar-days-grid" id="calendar-days-grid">
        <!-- Injected via JavaScript -->
      </div>
    </div>

    <!-- SEBELAH KANAN: Events List Panel for Selected Month -->
    <div class="calendar-detail-panel" id="calendar-detail-panel">
      <!-- Empty State View (Tampil Jika Tidak Ada Kegiatan di Bulan Tersebut) -->
      <div class="calendar-empty-state active" id="calendar-empty-state">
        <div class="empty-icon-box">
          <Info size={36} style="color: var(--color-gold);" />
        </div>
        <h4 class="empty-state-title">Tidak Ada Kegiatan</h4>
        <p class="empty-state-desc">
          Belum ada program kerja atau agenda kegiatan yang dijadwalkan pada bulan ini.
        </p>
      </div>

      <!-- Active Events Vertical List View (Tampil Jika Ada Kegiatan) -->
      <div class="calendar-events-list" id="calendar-events-list">
        <!-- Injected via JavaScript if events exist -->
      </div>
    </div>
  </div>
</div>

<style>
  .custom-calendar-section-wrapper {
    position: relative;
    width: 100%;
    margin-top: 1.5rem;
  }

  .custom-calendar-container {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: stretch;
    width: 100%;
  }

  /* SEBELAH KIRI: Fixed-Height Calendar Box (Warna Latar var(--color-dark) #1c1614 per DESIGN.md) */
  .calendar-grid-box {
    background: var(--color-dark); /* #1c1614 per DESIGN.md */
    border: 1.5px solid rgba(212, 179, 84, 0.3);
    border-radius: var(--radius-sm); /* Style tegas 4px */
    padding: 2rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 510px; /* Fixed Height agar tidak berubah-ubah */
    justify-content: space-between;
  }

  .calendar-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .calendar-month-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .month-name-text {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    color: #ffffff;
    letter-spacing: 0.04em;
  }

  /* Warna Tahun Kuning Emas per DESIGN.md */
  .year-gold-text {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    color: var(--color-gold); /* #d4b354 */
    letter-spacing: 0.04em;
  }

  .calendar-nav-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .cal-nav-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cal-nav-btn:hover {
    background: #820907;
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  /* Weekdays Header (MIN - SAB) */
  .calendar-weekdays-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.45rem; /* Samakan gap 0.45rem agar 1:1 Lined Up dengan grid tanggal */
    text-align: center;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    color: var(--color-gold);
    letter-spacing: 0.08em;
  }

  /* Fixed 42-Cells Days Grid (6 Rows x 7 Days) */
  .calendar-days-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    grid-template-rows: repeat(6, 1fr);
    gap: 0.45rem;
    flex-grow: 1;
  }

  .cal-day-cell {
    position: relative;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: default;
    transition: all 0.25s ease;
  }

  /* Tanggal Bulan Sebelum/Sesudah (Warna Abu-abu Redup Jelas) */
  .cal-day-cell.other-month {
    color: rgba(255, 255, 255, 0.25) !important;
    background: transparent !important;
    border-color: transparent !important;
    opacity: 0.3 !important;
  }

  .cal-day-cell.has-event {
    background: linear-gradient(135deg, rgba(130, 9, 7, 0.85) 0%, rgba(28, 22, 20, 0.95) 100%);
    border: 1.5px solid var(--color-gold);
    color: var(--color-gold);
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(130, 9, 7, 0.5);
  }

  .cal-day-cell.has-event:hover {
    background: #820907;
    border-color: #ffffff;
    color: #ffffff;
    transform: scale(1.06);
    z-index: 5;
  }

  .event-dot-indicator {
    position: absolute;
    bottom: 4px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 6px var(--color-gold);
  }

  /* SEBELAH KANAN: Events List Panel (Warna Latar var(--color-dark) #1c1614 per DESIGN.md) */
  .calendar-detail-panel {
    background: var(--color-dark); /* #1c1614 per DESIGN.md */
    border: 1.5px solid rgba(212, 179, 84, 0.3);
    border-radius: var(--radius-sm);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 510px; /* Fixed Height samakan dengan kiri */
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
  }

  /* Empty State View (Tampil Jika Tidak Ada Kegiatan) */
  .calendar-empty-state {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    flex-grow: 1;
  }

  .calendar-empty-state.active {
    display: flex;
  }

  .empty-icon-box {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(130, 9, 7, 0.35);
    border: 1.5px solid var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 25px rgba(212, 179, 84, 0.25);
  }

  .empty-state-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: #ffffff;
    letter-spacing: 0.04em;
  }

  .empty-state-desc {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
    max-width: 300px;
  }

  /* Active Events Vertical List View */
  .calendar-events-list {
    display: none;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    width: 100%;
    flex-grow: 1;
    padding-right: 0.25rem;
  }

  .calendar-events-list.active {
    display: flex;
  }

  .month-event-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 179, 84, 0.25);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .month-event-card:hover {
    transform: translateX(4px);
    border-color: var(--color-gold);
    background: rgba(130, 9, 7, 0.35);
  }

  .month-event-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .month-event-category {
    background: linear-gradient(135deg, #d4b354 0%, #820907 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .month-event-date {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    color: var(--color-gold);
  }

  .month-event-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    color: #ffffff;
  }

  .month-event-desc {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .custom-calendar-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .calendar-grid-box,
    .calendar-detail-panel {
      height: auto;
      min-height: 480px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const monthNameText = document.getElementById('month-name-text');
    const yearText = document.getElementById('year-text');
    const prevBtn = document.getElementById('prev-month-btn');
    const nextBtn = document.getElementById('next-month-btn');
    const daysGrid = document.getElementById('calendar-days-grid');

    const emptyState = document.getElementById('calendar-empty-state');
    const eventsListContainer = document.getElementById('calendar-events-list');

    const monthNames = [
      "Januari", "Februari", "Maret", "April", "Mei", "Juni",
      "Juli", "Agustus", "September", "Oktober", "November", "Desember"
    ];

    // Data kegiatan (Kosong untuk saat ini)
    const eventsData: { [key: string]: Array<{ id: number; title: string; category: string; division: string; dateStr: string; location: string; desc: string }> } = {};

    let currentYear = 2026;
    let currentMonthIdx = 7; // Agustus (0-indexed: 7 = Agustus)

    function renderCalendar() {
      if (!daysGrid || !monthNameText || !yearText) return;

      monthNameText.textContent = monthNames[currentMonthIdx];
      yearText.textContent = currentYear.toString();

      daysGrid.innerHTML = '';

      const firstDayIndex = new Date(currentYear, currentMonthIdx, 1).getDay(); // 0 = Minggu
      const daysInCurrentMonth = new Date(currentYear, currentMonthIdx + 1, 0).getDate();
      const daysInPrevMonth = new Date(currentYear, currentMonthIdx, 0).getDate();

      // 1. Tanggal Bulan Sebelumnya (Berwarna Abu-abu Redup)
      for (let i = firstDayIndex - 1; i >= 0; i--) {
        const prevDate = daysInPrevMonth - i;
        const cell = document.createElement('div');
        cell.className = 'cal-day-cell other-month';
        cell.textContent = prevDate.toString();
        daysGrid.appendChild(cell);
      }

      // 2. Tanggal Bulan Berjalan (1..daysInCurrentMonth)
      let currentMonthEvents: Array<any> = [];

      for (let day = 1; day <= daysInCurrentMonth; day++) {
        const cell = document.createElement('div');
        cell.className = 'cal-day-cell current-month';
        cell.textContent = day.toString();

        const monthStr = String(currentMonthIdx + 1).padStart(2, '0');
        const dayStr = String(day).padStart(2, '0');
        const dateKey = `${currentYear}-${monthStr}-${dayStr}`;

        if (eventsData[dateKey] && eventsData[dateKey].length > 0) {
          cell.classList.add('has-event');
          const dot = document.createElement('div');
          dot.className = 'event-dot-indicator';
          cell.appendChild(dot);

          currentMonthEvents.push(...eventsData[dateKey]);
        }

        daysGrid.appendChild(cell);
      }

      // 3. Tanggal Bulan Berikutnya (Berwarna Abu-abu Redup untuk melengkapi 42 sel = 6 baris x 7 hari)
      const totalCellsFilled = firstDayIndex + daysInCurrentMonth;
      const remainingCells = 42 - totalCellsFilled;
      for (let day = 1; day <= remainingCells; day++) {
        const cell = document.createElement('div');
        cell.className = 'cal-day-cell other-month';
        cell.textContent = day.toString();
        daysGrid.appendChild(cell);
      }

      // 4. Update Panel Kegiatan Sisi Kanan untuk Bulan yang Sedang Dibuka
      updateRightPanel(currentMonthEvents);
    }

    function updateRightPanel(eventsList: Array<any>) {
      if (!emptyState || !eventsListContainer) return;

      if (eventsList.length === 0) {
        emptyState.classList.add('active');
        eventsListContainer.classList.remove('active');
        eventsListContainer.innerHTML = '';
      } else {
        emptyState.classList.remove('active');
        eventsListContainer.classList.add('active');
        eventsListContainer.innerHTML = '';

        eventsList.forEach(item => {
          const card = document.createElement('div');
          card.className = 'month-event-card';
          card.innerHTML = `
            <div class="month-event-header">
              <span class="month-event-category">${item.category}</span>
              <span class="month-event-date">${item.dateStr}</span>
            </div>
            <h4 class="month-event-title">${item.title}</h4>
            <p class="month-event-desc">${item.desc}</p>
          `;
          eventsListContainer.appendChild(card);
        });
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentMonthIdx--;
        if (currentMonthIdx < 0) {
          currentMonthIdx = 11;
          currentYear--;
        }
        renderCalendar();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentMonthIdx++;
        if (currentMonthIdx > 11) {
          currentMonthIdx = 0;
          currentYear++;
        }
        renderCalendar();
      });
    }

    // Initial Render
    renderCalendar();
  });
</script>
