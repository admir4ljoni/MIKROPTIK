---
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import ProgramCard from "./ProgramCard.astro";

const programs = [
  {
    title: "INFORMATICS COMPASS 2025",
    description:
      "Rangkaian pembekalan dan pengenalan dunia perkuliahan prodi PTIK bagi mahasiswa baru.",
    image: "https://picsum.photos/seed/proker1/600/800",
    date: "Agustus 2025",
  },
  {
    title: "TECHNOFEST COMPETITION",
    description:
      "Kompetisi nasional pengembangan web, UI/UX, dan competitive programming bagi pelajar & mahasiswa.",
    image: "https://picsum.photos/seed/proker2/600/800",
    date: "Oktober 2025",
  },
  {
    title: "PTIK GOES TO COMMUNITY",
    description:
      "Pelatihan literasi digital dan pembuatan website sederhana bagi UMKM desa binaan.",
    image: "https://picsum.photos/seed/proker3/600/800",
    date: "November 2025",
  },
  {
    title: "SEMINAR NASIONAL TEKNOLOGI",
    description:
      "Forum diskusi ilmiah menghadirkan pakar IT & Edukasi Nasional membahas masa depan AI.",
    image: "https://picsum.photos/seed/proker4/600/800",
    date: "Desember 2025",
  },
  {
    title: "WORKSHOP & CODING BOOTCAMP",
    description:
      "Pelatihan intensif web development & cybersecurity untuk meningkatkan keahlian mahasiswa.",
    image: "https://picsum.photos/seed/proker5/600/800",
    date: "Maret 2026",
  },
  {
    title: "PTIK ART & SPORT FESTIVAL",
    description:
      "Ajang kompetisi seni dan olahraga antar angkatan untuk melatih kebersamaan dan mental juara.",
    image: "https://picsum.photos/seed/proker6/600/800",
    date: "Mei 2026",
  },
];
---

<div class="proker-carousel-wrapper">
  <!-- Nav Controls Above Carousel -->
  <div class="proker-carousel-header-controls">
    <button
      class="proker-nav-btn"
      id="proker-prev"
      aria-label="Program Kerja Sebelumnya"
    >
      <ChevronLeft size={26} />
    </button>
    <button
      class="proker-nav-btn"
      id="proker-next"
      aria-label="Program Kerja Selanjutnya"
    >
      <ChevronRight size={26} />
    </button>
  </div>

  <!-- Carousel Track -->
  <div class="proker-carousel-track" id="proker-track">
    {
      programs.map((proker) => (
        <ProgramCard
          title={proker.title}
          description={proker.description}
          image={proker.image}
          date={proker.date}
        />
      ))
    }
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const track = document.getElementById("proker-track");
    const prevBtn = document.getElementById("proker-prev");
    const nextBtn = document.getElementById("proker-next");

    if (!track) return;

    const scrollAmount = 400;

    prevBtn?.addEventListener("click", () => {
      track.scrollBy({ left: -scrollAmount, behavior: "smooth" });
    });

    nextBtn?.addEventListener("click", () => {
      track.scrollBy({ left: scrollAmount, behavior: "smooth" });
    });
  });
</script>
