---
import DivisiLayout from "../../layouts/DivisiLayout.astro";
import DivisiHero from "../../components/DivisiHero.astro";
import DivisiProker from "../../components/DivisiProker.astro";
import DivisiFotoGaleri from "../../components/DivisiFotoGaleri.astro";
import DivisiSplitSection from "../../components/DivisiSplitSection.astro";
import SectionHeading from "../../components/SectionHeading.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const divisiData = {
  name: "SEKRETARIS UMUM",
  badge: "BIDANG SEKRETARIS UMUM",
  tagline: "Selalu Siap, Selalu Ada",
  slug: "sekretaris-umum",
  bgImage: `${baseUrl}assets/Foto Kabinet/Foto Divisi/SEKRE/FOTO BERSAMA.webp`,
  fotoKadiv: `${baseUrl}assets/Foto Kabinet/Foto Divisi/SEKRE/FOTO KABID.webp`,
  fotoStaffAhli: `${baseUrl}assets/Foto Kabinet/Foto Divisi/SEKRE/FOTO STAFF AHLI.webp`,
  fotoStaffMuda: `${baseUrl}assets/Foto Kabinet/Foto Divisi/SEKRE/FOTO STAFF MUDA.webp`,
  description:
    'Sekretaris Umum (SEKUM) HMP MIKROPTIK FKIP UNS merupakan bidang yang bertugas dalam mengelola, menyelesaikan, dan mengarsipkan seluruh sistem administrasi serta operasional organisasi. Dengan tagline "Selalu Siap, Selalu Ada", bidang ini berperan sebagai penopang kelancaran dan stabilitas internal HMP MIKROPTIK melalui pengelolaan kearsipan, pemeliharaan ruang sekretariat, penyusunan timeline kerja, hingga penyediaan serta penyaluran pusat informasi bagi seluruh pengurus.',
  proker: [
    { title: "Rapat Kerja", description: "Rapat Kerja adalah forum perencanaan dan penetapan program kerja HMP MIKROPTIK selama satu periode kepengurusan." },
    { title: "Pelatihan Sekben", description: "Pengelolaan administrasi dan keuangan organisasi memerlukan pemahaman yang baik terhadap sistem kesekretariatan dan kebendaharaan." },
    { title: "Rapat Pleno", description: "Rapat Pleno diperlukan sebagai forum pertanggungjawaban dan evaluasi pelaksanaan program kerja setiap bidang dan divisi selama periode kepengurusan." },
    { title: "Rapat Harian Lengkap", description: "RHL (Rapat Harian Lengkap) bertindak sebagai forum untuk mengkoordinasi permasalahan organisasi yang bersifat mendesak memerlukan forum koordinasi internal yang efektif dan responsif." },
    { title: "Rapat Terbuka", description: "Rapat Terbuka diperlukan sebagai wadah penyampaian aspirasi serta forum pengambilan keputusan yang melibatkan pengurus dan perwakilan anggota HMP MIKROPTIK." },
    { title: "Rapat Besar", description: "Berakhirnya satu periode kepengurusan menuntut adanya forum evaluasi, pertanggungjawaban, serta regenerasi kepemimpinan organisasi." },
    { title: "Rekapitulasi Data", description: "Data pengurus yang akurat dan terdokumentasi diperlukan sebagai dasar administrasi dan legalitas organisasi." },
    { title: "Tertib Administrasi", description: "Administrasi yang tertib dan terstandar merupakan fondasi keberlangsungan organisasi yang profesional." },
    { title: "Dokumentasi Data", description: "Dokumentasi data diperlukan sebagai bukti pelaksanaan kegiatan serta arsip historis organisasi." },
    { title: "Pengelolaan Sekre", description: "Sekretariat sebagai pusat kegiatan organisasi memerlukan pengelolaan sarana dan prasarana yang berkelanjutan." },
    { title: "Sertifikat Pengurus", description: "Sertifikat Pengurus disediakan sebagai bentuk apresiasi dan validasi nyata bagi anggota-anggota himpunan yang aktif dan proaktif selama periode kepengurusan." },
  ],
  galeri: [
    {
      title: "Foto Bersama Bidang SEKUM",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/SEKRE/FOTO BERSAMA.webp`,
      isFeatured: true,
    },
    {
      title: "Kabid Sekretaris Umum",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/SEKRE/FOTO KABID.webp`,
    },
    {
      title: "Staff Ahli Sekretaris Umum",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/SEKRE/FOTO STAFF AHLI.webp`,
    },
    {
      title: "Staff Muda Sekretaris Umum",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/SEKRE/FOTO STAFF MUDA.webp`,
    },
  ],
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  prevDivisi={{ name: "KAHIM & WAKAHIM", slug: "kahim-wakahim" }}
  nextDivisi={{ name: "BENDAHARA UMUM", slug: "bendahara-umum" }}
>
  <!-- Hero Section (100vh) -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Penopang kelancaran dan stabilitas operasional serta administrasi organisasi HMP MIKROPTIK."
    bgImage={divisiData.bgImage}
  />

  <!-- Section 1: Deskripsi Profil paired with Foto Kadiv (50/50 Viewport Segment) -->
  <DivisiSplitSection
    imageSrc={divisiData.fotoKadiv}
    imageAlt="Kabid Sekretaris Umum"
    reverse={false}
  >
    <SectionHeading
      titleMain="PROFIL"
      titleAccent="Bidang"
      subtitle="Peran dan fokus utama Sekretaris Umum dalam mendukung tata kelola himpunan"
      align="left"
    />
    <div class="brutalist-profile-box">
      <p class="brutalist-desc-text">{divisiData.description}</p>
    </div>
  </DivisiSplitSection>

  <!-- Section 2: Program Kerja paired with Foto Staff Ahli (50/50 Viewport Segment) -->
  <DivisiProker
    prokerList={divisiData.proker}
    imageSrc={divisiData.fotoStaffAhli}
    reverse={true}
  />

  <!-- Section 3: Galeri Dokumentasi paired with Foto Staff Muda (50/50 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri}
    imageSrc={divisiData.fotoStaffMuda}
    reverse={false}
  />
</DivisiLayout>
