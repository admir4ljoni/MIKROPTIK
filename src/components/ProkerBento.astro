---
const heroCard = {
  id: 1,
  title: "INFORMATICS COMPASS 2025",
  image: "https://picsum.photos/seed/proker1/1200/600",
  description: "Rangkaian pembekalan utama, pengenalan kurikulum, dan penguatan budaya akademik prodi PTIK UNS bagi mahasiswa baru agar berprestasi sejak awal perkuliahan.",
  tag: "PROGRAM UNGGULAN UTAMA"
};

const masonryItems = [
  {
    id: 2,
    title: "TECHNOFEST COMPETITION 2025",
    image: "https://picsum.photos/seed/proker2/800/800",
    description: "Kompetisi teknologi tingkat nasional mencakup Web Development, UI/UX Design, dan Competitive Programming.",
    height: "tall"
  },
  {
    id: 3,
    title: "PTIK GOES TO COMMUNITY",
    image: "https://picsum.photos/seed/proker3/800/600",
    description: "Pelatihan literasi digital, branding sosial media, dan pembuatan website bagi UMKM desa binaan.",
    height: "medium"
  },
  {
    id: 4,
    title: "WORKSHOP & STUDY CLUB TECH",
    image: "https://picsum.photos/seed/proker4/800/500",
    description: "Sesi intensif pengasahan skill software engineering, cloud computing, dan AI bersama alumni.",
    height: "short"
  },
  {
    id: 5,
    title: "LKMM-TD NAYA VIKRAMA",
    image: "https://picsum.photos/seed/proker6/800/850",
    description: "Latihan Keterampilan Manajemen Mahasiswa Tingkat Dasar untuk membina jiwa kepemimpinan dan manajerial.",
    height: "tall"
  },
  {
    id: 6,
    title: "PTIK CAREER & ALUMNI EXPO",
    image: "https://picsum.photos/seed/proker5/800/650",
    description: "Ajang jejaring alumni dan industri IT untuk memberikan wawasan karir serta peluang magang.",
    height: "medium"
  },
  {
    id: 7,
    title: "HACKATHON PTIK INNOVATION",
    image: "https://picsum.photos/seed/proker7/800/750",
    description: "Maraton pembuatan prototipe solusi digital 24 jam untuk memecahkan masalah nyata.",
    height: "tall"
  },
  {
    id: 8,
    title: "SEMINAR NASIONAL TEKNOLOGI (SNTI)",
    image: "https://picsum.photos/seed/proker8/800/550",
    description: "Forum diskusi ilmiah dan wawasan tren teknologi terkini bersama pembicara ternama.",
    height: "short"
  },
  {
    id: 9,
    title: "MIKROPTIK SPORT & ART FEST",
    image: "https://picsum.photos/seed/proker9/800/700",
    description: "Pekan olahraga dan pentas seni untuk mempererat keakraban antar civitas akademika.",
    height: "medium"
  },
  {
    id: 10,
    title: "INFORMATICS PODCAST & MEDIA",
    image: "https://picsum.photos/seed/proker10/800/620",
    description: "Konten edukatif multimedia dan podcast inspiratif mengulas kisah sukses mahasiswa.",
    height: "medium"
  }
];
---

<div class="proker-layout-wrapper">
  <!-- 1. Full-Width Flagship Hero Card (Span Full Width 12 Columns) -->
  <article class="proker-card-fullwidth">
    <img src={heroCard.image} alt={heroCard.title} class="proker-card-bg-img" loading="lazy" />
    <div class="proker-card-overlay">
      <div class="proker-card-content">
        <span class="hero-flagship-tag">{heroCard.tag}</span>
        <h3 class="proker-card-title hero-title">{heroCard.title}</h3>
        <p class="proker-card-desc hero-desc">{heroCard.description}</p>
      </div>
    </div>
  </article>

  <!-- 2. Asymmetrical Masonry Grid for Remaining Cards (4 Columns) -->
  <div class="proker-masonry-grid">
    {masonryItems.map((item) => (
      <article class={`bento-card bento-card-${item.height}`}>
        <img src={item.image} alt={item.title} class="bento-card-bg-img" loading="lazy" />
        <div class="bento-card-overlay">
          <div class="bento-card-content">
            <h3 class="bento-card-title">{item.title}</h3>
            <p class="bento-card-desc">{item.description}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .proker-layout-wrapper {
    width: 100%;
    max-width: 100%;
    padding: 0 clamp(0.75rem, 2.5vw, 2.5rem);
    margin-top: 1.5rem;
  }

  /* Full Width Hero Card */
  .proker-card-fullwidth {
    position: relative;
    width: 100%;
    min-height: 440px;
    border-radius: var(--radius-sm); /* Style tegas: corner radius kecil 4px */
    overflow: hidden;
    border: none;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    margin-bottom: 0.75rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .proker-card-fullwidth:hover {
    transform: translateY(-4px);
    box-shadow: 
      0 0 30px rgba(212, 179, 84, 0.4),
      0 0 60px rgba(130, 9, 7, 0.35);
  }

  .hero-flagship-tag {
    display: inline-block;
    background: var(--color-gold);
    color: var(--color-dark);
    font-family: var(--font-heading);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-sm);
    width: max-content;
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 4vw, 3.6rem) !important;
  }

  .hero-desc {
    max-width: 800px;
    font-size: clamp(1rem, 1.2vw, 1.15rem) !important;
  }

  /* Masonry Multi-Column Grid Layout (4 Columns Desktop) */
  .proker-masonry-grid {
    column-count: 4;
    column-gap: 0.75rem;
    width: 100%;
  }

  /* Bento Card Base */
  .bento-card {
    position: relative;
    width: 100%;
    break-inside: avoid;
    margin-bottom: 0.75rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: none;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .bento-card:hover {
    transform: translateY(-5px);
    box-shadow: 
      0 0 30px rgba(212, 179, 84, 0.4),
      0 0 60px rgba(130, 9, 7, 0.35);
    z-index: 5;
  }

  /* Variasi Tinggi Asimetris Masonry (Heights) */
  .bento-card-tall {
    height: 420px;
  }

  .bento-card-medium {
    height: 330px;
  }

  .bento-card-short {
    height: 270px;
  }

  /* Background Image */
  .proker-card-bg-img,
  .bento-card-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proker-card-fullwidth:hover .proker-card-bg-img,
  .bento-card:hover .bento-card-bg-img {
    transform: scale(1.05);
  }

  /* Dark Bottom Shadow Overlay Gradient */
  .proker-card-overlay,
  .bento-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 2vw, 1.85rem);
    background: linear-gradient(
      to top,
      rgba(28, 22, 20, 0.98) 0%,
      rgba(28, 22, 20, 0.85) 45%,
      rgba(28, 22, 20, 0.25) 75%,
      transparent 100%
    );
    z-index: 2;
  }

  .bento-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bento-card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2vw, 2rem);
    color: var(--color-gold);
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .bento-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 1vw, 0.96rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.5;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
  }

  /* Responsive Adjustments */
  @media (max-width: 1200px) {
    .proker-masonry-grid {
      column-count: 3;
    }
  }

  @media (max-width: 820px) {
    .proker-masonry-grid {
      column-count: 2;
    }

    .proker-card-fullwidth {
      min-height: 360px;
    }
  }

  @media (max-width: 640px) {
    .proker-masonry-grid {
      column-count: 1;
    }

    .proker-layout-wrapper {
      padding: 0 0.75rem;
    }

    .proker-card-fullwidth {
      min-height: 320px;
    }

    .bento-card-tall,
    .bento-card-medium,
    .bento-card-short {
      height: 300px;
    }
  }
</style>
