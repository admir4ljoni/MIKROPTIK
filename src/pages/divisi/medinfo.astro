---
import DivisiLayout from "../../layouts/DivisiLayout.astro";
import DivisiHero from "../../components/DivisiHero.astro";
import DivisiProker from "../../components/DivisiProker.astro";
import DivisiFotoGaleri from "../../components/DivisiFotoGaleri.astro";
import DivisiSplitSection from "../../components/DivisiSplitSection.astro";
import SectionHeading from "../../components/SectionHeading.astro";

const divisiData = {
  name: "MEDINFO",
  badge: "DIVISI MEDINFO",
  tagline: "Media Informasi, Publikasi & Dokumentasi Digital",
  slug: "medinfo",
  bgImage: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO BERSAMA.webp",
  fotoKadiv: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO KABID.webp",
  fotoStaffAhli:
    "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF AHLI.webp",
  fotoStaffMuda1:
    "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF MUDA 1.webp",
  fotoStaffMuda2:
    "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF MUDA 2.webp",
  description:
    "Divisi Medinfo HMP MIKROPTIK adalah divisi yang bertanggung jawab dalam pengelolaan media informasi dan dokumentasi HMP MIKROPTIK. Program kerjanya meliputi Pengelolaan Media Sosial, dokumentasi kegiatan, PDD (Publikasi, Dokumentasi, dan Desain), Podcast sebagai media informasi dan edukasi. Divisi ini juga menjadi wadah bagi mahasiswa untuk mengembangkan kemampuan di bidang desain grafis, fotografi, dan videografi. Bergabung di Divisi Medinfo HMP MIKROPTIK memberikan kesempatan untuk meningkatkan kreativitas, mengasah keterampilan, dan memperoleh pengalaman baru.",
  proker: [
    "DOKUMENTASI KEGIATAN",
    "PDD (PUBLIKASI, DOKUMENTASI, & DESAIN)",
    "PENGELOLAAN SOSIAL MEDIA",
    "PODCAST MIKROPTIK",
  ],
  galeri: [
    {
      title: "Foto Bersama Divisi MEDINFO",
      src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO BERSAMA.webp",
      isFeatured: true,
    },
    {
      title: "Kadiv MEDINFO",
      src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO KABID.webp",
    },
    {
      title: "Staff Ahli MEDINFO",
      src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF AHLI.webp",
    },
    {
      title: "Staff Muda MEDINFO 1",
      src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF MUDA 1.webp",
    },
    {
      title: "Staff Muda MEDINFO 2",
      src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF MUDA 2.webp",
    },
  ],
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  divisiSlug={divisiData.slug}
  prevDivisi={{ name: "HUMAS", slug: "humas" }}
>
  <!-- Hero Section (100vh) -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Pusat media digital, publikasi visual, PDD, dokumentasi fotografi & videografi, serta podcast edukasi HMP MIKROPTIK."
    bgImage={divisiData.bgImage}
    bgPosition="center 68%"
    brightness={0.72}
  />

  <!-- Section 1: Deskripsi Profil paired with Foto Kadiv (60/40 Viewport Segment) -->
  <DivisiSplitSection
    imageSrc={divisiData.fotoKadiv}
    imageAlt="Kadiv MEDINFO"
    reverse={false}
  >
    <SectionHeading
      titleMain="PROFIL"
      titleAccent="Divisi"
      subtitle="Peran dan fokus utama Divisi Medinfo dalam menghadirkan konten kreatif & branding visual"
      align="left"
    />
    <div class="brutalist-profile-box">
      <p class="brutalist-desc-text">{divisiData.description}</p>
    </div>
  </DivisiSplitSection>

  <!-- Section 2: Program Kerja paired with Foto Staff Ahli (60/40 Viewport Segment) -->
  <DivisiProker
    prokerList={divisiData.proker}
    imageSrc={divisiData.fotoStaffAhli}
    reverse={true}
  />

  <!-- Section 3: Galeri Dokumentasi 1 paired with Foto Staff Muda 1 (60/40 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri.slice(0, 3)}
    imageSrc={divisiData.fotoStaffMuda1}
    reverse={false}
  />

  <!-- Section 4: Galeri Dokumentasi 2 paired with Foto Staff Muda 2 (60/40 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri.slice(2)}
    imageSrc={divisiData.fotoStaffMuda2}
    reverse={true}
  />
</DivisiLayout>
