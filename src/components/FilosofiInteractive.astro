---
const defaultPhilosophy = {
  id: 0,
  title: "Logo Kabinet Naya Vikrama 2026",
  description: "Logo Naya Vikrama menghadirkan makna tentang semangat baru, ketangguhan, dan keberanian dalam melangkah. Setiap elemen di dalamnya mencerminkan karakter HMP MIKROPTIK yang progresif, adaptif, dan selalu siap menghadapi tantangan."
};

const logoParts = [
  {
    id: 1,
    title: "Obor Api Kepemimpinan",
    image: "logo_kabinet_api.png",
    description: "Api yang menjulang ke atas mencerminkan semangat, keberanian, dan ketegasan dalam memimpin. Layaknya menyala yang tidak mudah padam, unsur ini menggambarkan kepemimpinan yang menjaga arah, memberikan inspirasi, serta berani mengambil keputusan dalam menghadapi setiap tantangan."
  },
  {
    id: 2,
    title: "Enam Sayap (Bidang & Divisi)",
    image: "logo_kabinet_sayap_1.png",
    description: "Enam sayap di kanan dan kiri melambangkan dua bidang empat divisi: Bidang Sekertaris Umum, Bidang Bendahara Umum, Divisi PSDM, Divisi Humas, Divisi Media, Divisi Mikat. Bahwa organisasi bergerak oleh kolaborasi bidang & divisi yang bekerja harmonis untuk mencapai tujuan bersama."
  },
  {
    id: 3,
    title: "Buku & Kebebasan Berpikir",
    image: "logo_kabinet_buku.png",
    description: "Buku-buku menjadi simbol bahwa setiap langkah dan kebebasan berfikir selalu berlandaskan pengetahuan, serta menegaskan peran organisasi sebagai rumah belajar bagi setiap anggotanya."
  },
  {
    id: 4,
    title: "Perisai Penopang Organisasi",
    image: "logo_kabinet_sayap_2.png",
    description: "Perisai penopang melambangkan fondasi yang kokoh yaitu nilai-nilai dasar, dukungan antar anggota, serta semangat kebersamaan yang menjadi akar dari setiap langkah. Bahwa organisasi mampu berdiri tegak dan melangkah maju karena memiliki penopang yang solid."
  }
];
---

<div class="filosofi-interactive-container" id="filosofi-interactive">
  <div class="filosofi-grid">
    <!-- SEBELAH KIRI: Murni Artwork Logo Interaktif -->
    <div class="filosofi-visual-left">
      <div class="logo-stack-box" id="logo-stack-box">
        <!-- Part 1: Api -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_api.png`}
          alt="Api Menjulang Ke Atas"
          class="logo-layer-img"
          data-part="1"
        />
        <!-- Part 2: Sayap 1 -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_sayap_1.png`}
          alt="Enam Sayap Kanan & Kiri"
          class="logo-layer-img"
          data-part="2"
        />
        <!-- Part 3: Buku -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_buku.png`}
          alt="Buku-buku Pengetahuan"
          class="logo-layer-img"
          data-part="3"
        />
        <!-- Part 4: Sayap 2 / Perisai -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_sayap_2.png`}
          alt="Perisai Penopang Organisasi"
          class="logo-layer-img"
          data-part="4"
        />
      </div>
    </div>

    <!-- SEBELAH KANAN: Single Clean Philosophy Card (Sesuai Lampiran) -->
    <div class="filosofi-content-right">
      <!-- Default Philosophy Card -->
      <div class="filosofi-clean-card active" id="card-part-0" data-card="0">
        <h3 class="filosofi-card-title">{defaultPhilosophy.title}</h3>
        <p class="filosofi-card-desc">{defaultPhilosophy.description}</p>
      </div>

      <!-- Individual Part Philosophy Cards -->
      {logoParts.map((part) => (
        <div class="filosofi-clean-card" id={`card-part-${part.id}`} data-card={part.id}>
          <h3 class="filosofi-card-title">{part.title}</h3>
          <p class="filosofi-card-desc">{part.description}</p>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .filosofi-interactive-container {
    position: relative;
    width: 100%;
    margin-top: 1rem;
  }

  .filosofi-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3.5rem;
    align-items: center;
    width: 100%;
  }

  /* SEBELAH KIRI: Murni Logo Artwork */
  .filosofi-visual-left {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .logo-stack-box {
    position: relative;
    width: clamp(320px, 38vw, 480px);
    height: clamp(320px, 38vw, 480px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: crosshair;
  }

  /* Layer Images Stacked Absolutely */
  .logo-layer-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    filter: grayscale(0%) opacity(1);
    transition: filter 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.4s ease;
    will-change: filter, transform, opacity;
  }

  /* State Saat Salah Satu Part Di-hover/Di-click */
  .logo-stack-box.is-hovered .logo-layer-img {
    filter: grayscale(100%) opacity(0.22);
    transform: scale(0.98);
  }

  .logo-stack-box.is-hovered .logo-layer-img.active-part {
    filter: grayscale(0%) opacity(1) drop-shadow(0 0 45px rgba(212, 179, 84, 0.95));
    transform: scale(1.05);
    z-index: 20;
  }

  /* SEBELAH KANAN: Single Clean Card Panel (Sesuai Lampiran) */
  .filosofi-content-right {
    display: flex;
    flex-direction: column;
    position: relative;
    min-height: 320px;
    justify-content: center;
  }

  /* Card Display - White Card Style (Sesuai Referensi Gambar) */
  .filosofi-clean-card {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: 3rem 2.5rem;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    background: #ffffff;
    border: 2px solid #820907;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filosofi-clean-card.active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .filosofi-card-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.2vw, 3rem);
    color: #820907;
    line-height: 1.1;
    letter-spacing: 0.03em;
  }

  .filosofi-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.15vw, 1.08rem);
    color: #2b2523;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .filosofi-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .filosofi-clean-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const stackBox = document.getElementById('logo-stack-box');
    const layerImgs = document.querySelectorAll('.logo-layer-img');
    const cards = document.querySelectorAll('.filosofi-clean-card');

    if (!stackBox || layerImgs.length === 0) return;

    let activePartId = '0';
    const partContexts: { [key: string]: CanvasRenderingContext2D } = {};
    const CANVAS_SIZE = 250;

    // Load each part PNG into offscreen canvas 2D contexts for 100% pixel-perfect alpha detection
    const imgElements = Array.from(layerImgs) as HTMLImageElement[];
    imgElements.forEach(img => {
      const partId = img.getAttribute('data-part') || '0';
      const c = document.createElement('canvas');
      c.width = CANVAS_SIZE;
      c.height = CANVAS_SIZE;
      const ctx = c.getContext('2d', { willReadFrequently: true });

      const tempImg = new Image();
      tempImg.crossOrigin = 'anonymous';
      tempImg.onload = () => {
        if (ctx) {
          ctx.drawImage(tempImg, 0, 0, CANVAS_SIZE, CANVAS_SIZE);
          partContexts[partId] = ctx;
        }
      };
      tempImg.src = img.src;
    });

    function activatePart(partId: string) {
      if (activePartId === partId) return;
      activePartId = partId;

      if (partId === '0') {
        stackBox.classList.remove('is-hovered');
        layerImgs.forEach(img => img.classList.remove('active-part'));
      } else {
        stackBox.classList.add('is-hovered');
        layerImgs.forEach(img => {
          if (img.getAttribute('data-part') === partId) {
            img.classList.add('active-part');
          } else {
            img.classList.remove('active-part');
          }
        });
      }

      cards.forEach(card => {
        if (card.getAttribute('data-card') === partId) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }

    // Inspect non-transparent pixels (alpha > 35) on the exact cursor position over the logo shapes
    function detectPartAtPosition(xRatio: number, yRatio: number): string {
      const px = Math.floor(xRatio * CANVAS_SIZE);
      const py = Math.floor(yRatio * CANVAS_SIZE);

      if (px < 0 || px >= CANVAS_SIZE || py < 0 || py >= CANVAS_SIZE) return '0';

      // Order of inspection: Api (1), Buku (3), Sayap Kanan (2), Sayap Kiri (4)
      const partOrder = ['1', '3', '2', '4'];
      for (const partId of partOrder) {
        const ctx = partContexts[partId];
        if (ctx) {
          try {
            const alpha = ctx.getImageData(px, py, 1, 1).data[3];
            if (alpha > 35) {
              return partId;
            }
          } catch (e) {
            // Ignore cross-origin canvas security errors
          }
        }
      }
      return '0';
    }

    // Mousemove directly over the visual logo box
    stackBox.addEventListener('mousemove', (e) => {
      const rect = stackBox.getBoundingClientRect();
      const xRatio = (e.clientX - rect.left) / rect.width;
      const yRatio = (e.clientY - rect.top) / rect.height;

      const detectedPart = detectPartAtPosition(xRatio, yRatio);
      activatePart(detectedPart);
    });

    stackBox.addEventListener('mouseleave', () => {
      activatePart('0');
    });

    // Touch support for mobile devices directly on logo box
    stackBox.addEventListener('touchstart', (e) => {
      if (e.touches.length > 0) {
        const touch = e.touches[0];
        const rect = stackBox.getBoundingClientRect();
        const xRatio = (touch.clientX - rect.left) / rect.width;
        const yRatio = (touch.clientY - rect.top) / rect.height;

        const detectedPart = detectPartAtPosition(xRatio, yRatio);
        activatePart(detectedPart);
      }
    }, { passive: true });
  });
</script>
