---
import { Trophy, Award, Medal, Crown, Star, Sparkles } from '@lucide/astro';

const hallOfFameItems = [
  {
    id: 1,
    badge: "JUARA 1 NASIONAL",
    badgeIcon: Trophy,
    category: "UI/UX DESIGN & PRODUCT INOVATION",
    title: "GEMASTIK XVIII KEMENRISTEKDIKTI",
    winner: "Tim PTIK UX Innovators",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi1/800/1000",
    description: "Meraih Medali Emas cabang Desain Pengalaman Pengguna (UI/UX) tingkat Nasional dengan platform inklusif."
  },
  {
    id: 2,
    badge: "MEDALI EMAS HACKATHON",
    badgeIcon: Medal,
    category: "AI & WEB DEVELOPMENT",
    title: "NATIONAL AI & WEB HACKATHON 2025",
    winner: "Siti Rahma & Tim Web Dev",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi2/800/1000",
    description: "Juara Utama kategori Inovasi Aplikasi Web Berbasis AI untuk transformasi pendidikan digital."
  },
  {
    id: 3,
    badge: "BEST PAPER PUBLICATION",
    badgeIcon: Award,
    category: "MACHINE LEARNING & DATA",
    title: "NATIONAL CONFERENCE ON IT 2025",
    winner: "Ahmad Fauzi & Tim Riset Data",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi3/800/1000",
    description: "Penghargaan Makalah Terbaik publikasi riset Machine Learning dan Big Data Analytics."
  },
  {
    id: 4,
    badge: "JUARA 1 PROGRAMMING",
    badgeIcon: Crown,
    category: "COMPETITIVE PROGRAMMING",
    title: "OLIMPIADE KOMPUTER PT 2025",
    winner: "Budi Santoso",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi4/800/1000",
    description: "Meraih Juara Pertama kategori Algoritma, Efisiensi Struktur Data, dan Pemrograman Kompetitif."
  },
  {
    id: 5,
    badge: "TOP CYBER DEFENSE",
    badgeIcon: Star,
    category: "CYBER SECURITY CTF",
    title: "NATIONAL CTF SECURITY 2025",
    winner: "Tim PTIK Cyber Defense",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi5/800/1000",
    description: "Peringkat 2 Kejuaraan Nasional Keamanan Siber, Penetrasi Jaringan, dan Cryptography."
  },
  {
    id: 6,
    badge: "DELEGASI MAPRES UTAMA",
    badgeIcon: Sparkles,
    category: "PILMAPRES KEMENDIKBUD",
    title: "PEMILIHAN MAHASISWA BERPRESTASI 2025",
    winner: "Dian Permata",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi6/800/1000",
    description: "Perwakilan Mahasiswa Berprestasi Utama FKIP UNS pada ajang Pilmapres Tingkat Nasional."
  }
];

// Duplikasi items 3x untuk seamless infinite loop
const displayItems = [...hallOfFameItems, ...hallOfFameItems, ...hallOfFameItems];
---

<div class="halloffame-carousel-wrapper" id="prestasi-carousel">
  <div class="halloffame-carousel-container" id="prestasi-container">
    <div class="halloffame-track" id="prestasi-track">
      {displayItems.map((item, index) => (
        <article class={`halloffame-card ${index === 6 ? 'active' : ''}`} data-index={index}>
          <!-- Background Image Full Card -->
          <img src={item.image} alt={item.title} class="halloffame-card-bg-img" loading="lazy" />

          <!-- Top Honor Gold Badge -->
          <div class="halloffame-badge-wrapper">
            <span class="halloffame-gold-badge">
              <item.badgeIcon size={14} style="display: inline-block; vertical-align: middle; margin-right: 4px;" />
              {item.badge}
            </span>
            <span class="halloffame-year-badge">{item.year}</span>
          </div>

          <!-- Bottom Shadow Overlay Gradient -->
          <div class="halloffame-card-overlay">
            <div class="halloffame-card-content">
              <span class="halloffame-card-category">{item.category}</span>
              <h3 class="halloffame-card-title">{item.title}</h3>
              <p class="halloffame-card-winner">{item.winner}</p>
              <p class="halloffame-card-desc">{item.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Indikator Navigasi Bawah Carousel -->
  <div class="halloffame-dots-wrapper">
    <div class="halloffame-dots" id="prestasi-dots">
      {hallOfFameItems.map((_, index) => (
        <button
          class={`halloffame-dot ${index === 0 ? 'active' : ''}`}
          data-index={index}
          aria-label={`Ke slide Hall of Fame ${index + 1}`}
        ></button>
      ))}
    </div>
  </div>
</div>

<style>
  .halloffame-carousel-wrapper {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  .halloffame-carousel-container {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 3rem 0 2rem;
    height: 610px;
    display: flex;
    align-items: center;
  }

  .halloffame-carousel-container::-webkit-scrollbar {
    display: none;
  }

  .halloffame-track {
    display: flex;
    align-items: center;
    gap: 2.25rem;
    padding-left: calc(50% - clamp(160px, 17vw, 230px));
    padding-right: calc(50% - clamp(160px, 17vw, 230px));
    width: max-content;
    height: 560px;
  }

  /* Base Hall of Fame Card - Pedestal Elevation Style */
  .halloffame-card {
    position: relative;
    width: clamp(310px, 33vw, 450px);
    height: 500px;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    overflow: hidden;
    border: 1px solid rgba(212, 179, 84, 0.25);
    background: var(--color-dark);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    opacity: 0.55;
    filter: grayscale(40%);
    transform: translateY(22px) scale(0.85);
    transform-origin: center center;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease,
                opacity 0.4s ease,
                filter 0.4s ease;
    flex-shrink: 0;
    cursor: pointer;
    will-change: transform, opacity, box-shadow;
  }

  /* Kartu Tengah Active - Hall of Fame Podium Elevation (Gold Spotlight Glow) */
  .halloffame-card.active {
    opacity: 1;
    filter: grayscale(0%);
    transform: translateY(-24px) scale(1.02);
    border: 1.5px solid var(--color-gold);
    box-shadow: 
      0 0 35px rgba(212, 179, 84, 0.5),
      0 0 75px rgba(130, 9, 7, 0.45),
      0 15px 45px rgba(0, 0, 0, 0.8);
    z-index: 10;
  }

  .halloffame-card.no-anim {
    transition: none !important;
  }

  .halloffame-card-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .halloffame-card.active:hover .halloffame-card-bg-img {
    transform: scale(1.05);
  }

  /* Top Honor Badges */
  .halloffame-badge-wrapper {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 5;
  }

  .halloffame-gold-badge {
    background: linear-gradient(135deg, #d4b354 0%, #820907 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
  }

  .halloffame-year-badge {
    background: rgba(28, 22, 20, 0.85);
    backdrop-filter: blur(8px);
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 179, 84, 0.4);
  }

  /* Bottom Shadow Overlay Gradient */
  .halloffame-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.25rem 1.75rem 1.75rem;
    background: linear-gradient(
      to top,
      rgba(28, 22, 20, 0.98) 0%,
      rgba(28, 22, 20, 0.85) 50%,
      rgba(28, 22, 20, 0.2) 80%,
      transparent 100%
    );
    z-index: 2;
  }

  .halloffame-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .halloffame-card-category {
    font-family: var(--font-heading);
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    color: var(--color-gold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .halloffame-card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    color: var(--color-white);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .halloffame-card-winner {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 1.35vw, 1.28rem);
    color: var(--color-gold);
    letter-spacing: 0.05em;
  }

  .halloffame-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 0.95vw, 0.96rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.5;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
  }

  /* Indikator Dots Bawah */
  .halloffame-dots-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 1rem;
  }

  .halloffame-dots {
    display: flex;
    gap: 0.6rem;
  }

  .halloffame-dot {
    width: 12px;
    height: 12px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.25);
    border: 1px solid rgba(212, 179, 84, 0.4);
    transition: all var(--transition-fast);
    cursor: pointer;
  }

  .halloffame-dot.active {
    background: var(--color-gold);
    width: 32px;
  }

  @media (max-width: 768px) {
    .halloffame-card {
      width: 82vw;
      height: 460px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('prestasi-container');
    const cards = Array.from(document.querySelectorAll('.halloffame-card')) as HTMLElement[];
    const dots = document.querySelectorAll('.halloffame-dot');

    if (!container || cards.length === 0) return;

    const itemCount = 6;
    let singleSetWidth = 0;

    function calculateWidths() {
      if (cards.length >= itemCount * 2) {
        singleSetWidth = cards[itemCount].offsetLeft - cards[0].offsetLeft;
      }
    }

    calculateWidths();

    if (singleSetWidth > 0) {
      container.scrollLeft = singleSetWidth;
    }

    function updateCenterCard() {
      if (!container) return;
      const containerRect = container.getBoundingClientRect();
      const containerCenter = containerRect.left + containerRect.width / 2;

      let closestCard: HTMLElement | null = null;
      let minDistance = Infinity;

      cards.forEach((card) => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const distance = Math.abs(containerCenter - cardCenter);

        if (distance < minDistance) {
          minDistance = distance;
          closestCard = card;
        }
      });

      cards.forEach((card) => {
        if (card === closestCard) {
          card.classList.add('active');
          const originalIndex = parseInt(card.getAttribute('data-index') || '0', 10) % itemCount;
          
          dots.forEach((dot, dotIdx) => {
            if (dotIdx === originalIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        } else {
          card.classList.remove('active');
        }
      });
    }

    function checkInfiniteLoop() {
      if (!container || singleSetWidth === 0) return;

      let resetDelta = 0;

      if (container.scrollLeft >= singleSetWidth * 2) {
        resetDelta = -singleSetWidth;
      } else if (container.scrollLeft <= singleSetWidth * 0.2) {
        resetDelta = singleSetWidth;
      }

      if (resetDelta !== 0) {
        cards.forEach((c) => c.classList.add('no-anim'));
        container.scrollLeft += resetDelta;
        updateCenterCard();

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            cards.forEach((c) => c.classList.remove('no-anim'));
          });
        });
      }
    }

    container.addEventListener('scroll', () => {
      checkInfiniteLoop();
      updateCenterCard();
    }, { passive: true });

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const targetScrollLeft = cardCenter - container.clientWidth / 2;
        container.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });
      });
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        const targetCard = cards[itemCount + idx];
        if (targetCard) {
          const cardCenter = targetCard.offsetLeft + targetCard.offsetWidth / 2;
          const targetScrollLeft = cardCenter - container.clientWidth / 2;
          container.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });
        }
      });
    });

    window.addEventListener('resize', () => {
      calculateWidths();
      updateCenterCard();
    }, { passive: true });

    setTimeout(() => {
      calculateWidths();
      if (singleSetWidth > 0 && container.scrollLeft === 0) {
        container.scrollLeft = singleSetWidth;
      }
      updateCenterCard();
    }, 50);
  });
</script>
