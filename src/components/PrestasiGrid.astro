      },
      5: {
        badge: "TOP CYBER DEFENSE",
        year: "2025",
        category: "Cyber Security CTF",
        title: "NATIONAL CTF SECURITY 2025",
        winner: "Tim PTIK Cyber Defense",
        members: ["Muhammad Farhan (2022)", "Eko Prasetyo (2023)"],
        image: "https://picsum.photos/seed/prestasi5/800/1000",
        description: "Berhasil memecahkan tantangan Capture The Flag (CTF) kategori Reverse Engineering, Web Exploitation, dan Cryptography dalam kejuaraan siber nasional yang diselenggarakan oleh konsorsium keamanan informasi perguruan tinggi."
      },
      6: {
        badge: "DELEGASI MAPRES UTAMA",
        year: "2025",
        category: "Mapres & Individu",
        title: "PEMILIHAN MAHASISWA BERPRESTASI 2025",
        winner: "Dian Permata",
        members: ["Dian Permata (2023)"],
        image: "https://picsum.photos/seed/prestasi6/800/1000",
        description: "Terpilih sebagai Mahasiswa Berprestasi I (Juara 1 Mapres) FKIP UNS setelah melalui seleksi ketat portofolio capaian unggulan, kemampuan bahasa Inggris, karya tulis ilmiah inovatif, dan wawasan kebangsaan."
      }
    };

    // Category Filter Listener
    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter') || 'all';

        filterTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });
      });
    });

    // Open Modal Spotlight
    function openModal(id: number) {
      const data = dataMap[id];
      if (!data || !modalOverlay) return;

      const modalImg = document.getElementById('modal-img') as HTMLImageElement;
      const modalBadge = document.getElementById('modal-badge');
      const modalYear = document.getElementById('modal-year');
      const modalCategory = document.getElementById('modal-category');
      const modalTitle = document.getElementById('modal-title');
      const modalWinner = document.getElementById('modal-winner');
      const modalMembers = document.getElementById('modal-members');
      const modalDesc = document.getElementById('modal-desc');

      if (modalImg) modalImg.src = data.image;
      if (modalBadge) modalBadge.textContent = data.badge;
      if (modalYear) modalYear.textContent = data.year;
      if (modalCategory) modalCategory.textContent = data.category;
      if (modalTitle) modalTitle.textContent = data.title;
      if (modalWinner) modalWinner.textContent = data.winner;
      if (modalDesc) modalDesc.textContent = data.description;

      if (modalMembers) {
        modalMembers.innerHTML = '';
        data.members.forEach((m: string) => {
          const li = document.createElement('li');
          li.textContent = m;
          modalMembers.appendChild(li);
        });
      }

      modalOverlay.classList.add('active');
      modalOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    // Close Modal Spotlight
    function closeModal() {
      if (!modalOverlay) return;
      modalOverlay.classList.remove('active');
      modalOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    detailBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = parseInt(btn.getAttribute('data-spotlight') || '1', 10);
        openModal(id);
      });
    });

    if (modalClose) {
      modalClose.addEventListener('click', closeModal);
    }

    if (modalOverlay) {
      modalOverlay.addEventListener('click', (e) => {
        if (e.target === modalOverlay) {
          closeModal();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalOverlay && modalOverlay.classList.contains('active')) {
        closeModal();
      }
    });
  });
</script>
