---
import DivisiLayout from '../../layouts/DivisiLayout.astro';
import DivisiHero from '../../components/DivisiHero.astro';
import DivisiProker from '../../components/DivisiProker.astro';
import DivisiFotoGaleri from '../../components/DivisiFotoGaleri.astro';
import DivisiSplitSection from '../../components/DivisiSplitSection.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const divisiData = {
  name: "HUMAS",
  badge: "DIVISI HUMAS",
  tagline: "Jalin Koneksi, Cipta Harmoni, High Quality",
  slug: "humas",
  bgImage: "/assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO BERSAMA.JPG",
  fotoKadiv: "/assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO KADIV.JPG",
  fotoStaffAhli: "/assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO STAFF AHLI.JPG",
  fotoStaffMuda: "/assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO STAFF MUDA.JPG",
  description: "Sebagai garda terdepan HMP MIKROPTIK, Divisi Humas berfokus membangun citra positif, memperkuat relasi, dan menjembatani komunikasi internal–eksternal pada Kabinet Naya Vikrama 2026. Misi branding dan diseminasi informasi ini direalisasikan secara komprehensif melalui program advokasi (Sambung Rasa, Real Action), ekspansi jaringan (Delegasi, Studi Banding), aksi kepedulian sosial (JPTK Berbagi, Mikroptik Social Action), hingga pemeliharaan ikatan alumni (Sambut Wisuda). Seluruh pergerakan ini dijiwai oleh satu semangat utama: \"Jalin Koneksi, Cipta Harmoni, High Quality\".",
  proker: [
    "MIKROPTIK SOCIAL ACTION + SARASEHAN",
    "JPTK BERBAGI",
    "SAMBUNG RASA",
    "STUDI BANDING",
    "SAMBUT WISUDA",
    "REAL ACTION",
    "ADVOKASI MAHASISWA",
    "DELEGASI KAMPUS",
    "MEDIA PARTNER"
  ],
  galeri: [
    { title: "Foto Bersama Divisi HUMAS", src: "/assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO BERSAMA.JPG", isFeatured: true },
    { title: "Kadiv HUMAS", src: "/assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO KADIV.JPG" },
    { title: "Staff Ahli HUMAS", src: "/assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO STAFF AHLI.JPG" },
    { title: "Staff Muda HUMAS", src: "/assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO STAFF MUDA.JPG" }
  ]
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  divisiSlug={divisiData.slug}
  prevDivisi={{ name: "MIKAT", slug: "mikat" }}
  nextDivisi={{ name: "MEDINFO", slug: "medinfo" }}
>
  <!-- Hero Section (100vh) -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Garda terdepan pembangun relasi publik, aksi kepedulian sosial, advokasi mahasiswa, dan jejaring kerja sama eksternal."
    bgImage={divisiData.bgImage}
    bgPosition="center 75%"
  />

  <!-- Section 1: Deskripsi Profil paired with Foto Kadiv (50/50 Viewport Segment) -->
  <DivisiSplitSection
    imageSrc={divisiData.fotoKadiv}
    imageAlt="Kadiv HUMAS"
    reverse={false}
  >
    <SectionHeading
      titleMain="PROFIL"
      titleAccent="Divisi"
      subtitle="Peran dan fokus utama Divisi Humas dalam membangun reputasi & keharmonisan komunikasi"
      align="left"
    />
    <div class="divisi-desc-box">
      <p class="divisi-desc-text">{divisiData.description}</p>
    </div>
  </DivisiSplitSection>

  <!-- Section 2: Program Kerja paired with Foto Staff Ahli (50/50 Viewport Segment) -->
  <DivisiProker 
    prokerList={divisiData.proker} 
    imageSrc={divisiData.fotoStaffAhli}
    reverse={true}
  />

  <!-- Section 3: Galeri Dokumentasi paired with Foto Staff Muda (50/50 Viewport Segment) -->
  <DivisiFotoGaleri 
    fotoList={divisiData.galeri} 
    imageSrc={divisiData.fotoStaffMuda}
    reverse={false}
  />
</DivisiLayout>
