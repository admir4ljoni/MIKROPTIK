---
import { Calendar } from '@lucide/astro';

const prokerItems = [
  {
    id: 1,
    title: "INFORMATICS COMPASS 2025",
    date: "Agustus 2025",
    image: "https://picsum.photos/seed/proker1/800/1000",
    description: "Rangkaian pembekalan, pengenalan kurikulum, dan budaya akademik prodi PTIK UNS bagi mahasiswa baru agar siap berprestasi.",
    tag: "Welcoming & Adaptation"
  },
  {
    id: 2,
    title: "TECHNOFEST COMPETITION",
    date: "Oktober 2025",
    image: "https://picsum.photos/seed/proker2/800/1000",
    description: "Kompetisi teknologi tingkat nasional mencakup Web Development, UI/UX Design, dan Competitive Programming untuk pelajar & mahasiswa.",
    tag: "Kompetisi Nasional"
  },
  {
    id: 3,
    title: "PTIK GOES TO COMMUNITY",
    date: "November 2025",
    image: "https://picsum.photos/seed/proker3/800/1000",
    description: "Program pengabdian masyarakat berupa pelatihan literasi digital, branding sosial media, dan pembuatan website bagi UMKM binaan.",
    tag: "Pengabdian Masyarakat"
  },
  {
    id: 4,
    title: "WORKSHOP & STUDY CLUB TECH",
    date: "Setiap Bulan",
    image: "https://picsum.photos/seed/proker4/800/1000",
    description: "Sesi intensif pengasahan skill software engineering, cloud computing, dan AI bersama praktisi alumni industri teknologi.",
    tag: "Akademik & Skill"
  },
  {
    id: 5,
    title: "PTIK CAREER & ALUMNI EXPO",
    date: "Desember 2025",
    image: "https://picsum.photos/seed/proker5/800/1000",
    description: "Ajang jejaring alumni dan industri IT untuk memberikan wawasan karir serta peluang magang bagi mahasiswa aktif.",
    tag: "Karir & Jejaring"
  },
  {
    id: 6,
    title: "LKMM-TD NAYA VIKRAMA",
    date: "Mei 2025",
    image: "https://picsum.photos/seed/proker6/800/1000",
    description: "Latihan Keterampilan Manajemen Mahasiswa Tingkat Dasar untuk membina jiwa kepemimpinan, integritas, dan manajerial organisasi.",
    tag: "Kaderisasi & LDK"
  }
];
---

<div class="proker-carousel-wrapper" id="proker-carousel">
  <div class="proker-carousel-container" id="proker-container">
    <div class="proker-track" id="proker-track">
      {prokerItems.map((item, index) => (
        <article class={`proker-card-full ${index === 0 ? 'active' : ''}`} data-index={index}>
          <!-- Background Image Full Card -->
          <img src={item.image} alt={item.title} class="proker-card-bg-img" loading="lazy" />
          
          <!-- Gradient Shadow Overlay at Bottom -->
          <div class="proker-card-overlay">
            <div class="proker-card-header-badge">
              <span class="proker-badge-tag">{item.tag}</span>
              <span class="proker-badge-date">
                <Calendar size={14} style="display: inline-block; vertical-align: middle; margin-right: 4px;" />
                {item.date}
              </span>
            </div>

            <div class="proker-card-content">
              <h3 class="proker-card-title">{item.title}</h3>
              <p class="proker-card-desc">{item.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  .proker-carousel-wrapper {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  .proker-carousel-container {
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 1.5rem 0;
    height: 580px;
    display: flex;
    align-items: center;
  }

  .proker-carousel-container::-webkit-scrollbar {
    display: none;
  }

  .proker-track {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-left: calc(50% - clamp(150px, 18vw, 230px));
    padding-right: calc(50% - clamp(150px, 18vw, 230px));
    width: max-content;
    height: 540px;
  }

  /* Card Base - Constant Height (GPU Scale Transition) */
  .proker-card-full {
    position: relative;
    width: clamp(300px, 36vw, 460px);
    height: 510px;
    border-radius: var(--radius-sm); /* Style tegas: corner radius kecil 4px */
    overflow: hidden;
    scroll-snap-align: center;
    border: 1.5px solid rgba(212, 179, 84, 0.2);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.4);
    opacity: 0.55;
    filter: grayscale(25%);
    transform: scale(0.85);
    transform-origin: center center;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.4s ease,
                filter 0.4s ease,
                border-color 0.4s ease;
    flex-shrink: 0;
    cursor: pointer;
    will-change: transform, opacity, box-shadow;
  }

  /* Kartu Tengah Active (Omnidirectional Smooth Glow 360° Memencar Ke Segala Arah) */
  .proker-card-full.active {
    opacity: 1;
    filter: grayscale(0%);
    transform: scale(1);
    border-color: var(--color-gold);
    box-shadow: 
      0 0 25px rgba(212, 179, 84, 0.45),
      0 0 50px rgba(204, 87, 14, 0.35),
      0 0 90px rgba(130, 9, 7, 0.3);
    z-index: 10;
  }

  .proker-card-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proker-card-full.active:hover .proker-card-bg-img {
    transform: scale(1.05);
  }

  /* Bottom Shadow Overlay Gradient */
  .proker-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.75rem;
    background: linear-gradient(
      to top,
      rgba(28, 22, 20, 0.98) 0%,
      rgba(28, 22, 20, 0.85) 45%,
      rgba(28, 22, 20, 0.25) 75%,
      transparent 100%
    );
    z-index: 2;
  }

  .proker-card-header-badge {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .proker-badge-tag {
    background: rgba(130, 9, 7, 0.85);
    backdrop-filter: blur(8px);
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 179, 84, 0.4);
    text-transform: uppercase;
  }

  .proker-badge-date {
    background: rgba(28, 22, 20, 0.75);
    backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-body);
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .proker-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .proker-card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    color: var(--color-gold);
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .proker-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.1vw, 1.02rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.55;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
  }

  @media (max-width: 768px) {
    .proker-card-full {
      width: 82vw;
      height: 400px;
    }

    .proker-card-full.active {
      height: 480px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('proker-container');
    const cards = document.querySelectorAll('.proker-card-full');

    if (!container || cards.length === 0) return;

    function updateCenterCard() {
      if (!container) return;
      const containerRect = container.getBoundingClientRect();
      const containerCenter = containerRect.left + containerRect.width / 2;

      let closestCard: HTMLElement | null = null;
      let minDistance = Infinity;

      cards.forEach((cardNode) => {
        const card = cardNode as HTMLElement;
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const distance = Math.abs(containerCenter - cardCenter);

        if (distance < minDistance) {
          minDistance = distance;
          closestCard = card;
        }
      });

      cards.forEach((cardNode) => {
        if (cardNode === closestCard) {
          cardNode.classList.add('active');
        } else {
          cardNode.classList.remove('active');
        }
      });
    }

    // Allow user to click any side card to scroll into center focus
    cards.forEach((cardNode) => {
      cardNode.addEventListener('click', () => {
        const card = cardNode as HTMLElement;
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      });
    });

    container.addEventListener('scroll', updateCenterCard, { passive: true });
    window.addEventListener('resize', updateCenterCard, { passive: true });

    // Initial trigger
    updateCenterCard();
  });
</script>
