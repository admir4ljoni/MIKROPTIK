---
// SlitheringThread.astro - Multi-Strand Magical Energy Flowing Stream (#about to #cta)
---

<div class="slithering-thread-wrapper" id="slithering-thread-container" aria-hidden="true">
  <svg class="slithering-svg" id="slithering-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <defs>
      <!-- Gradient 1: Deep Red to Warm Gold -->
      <linearGradient id="magicGradientMain" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="var(--color-red-deep)" stop-opacity="0.95" />
        <stop offset="25%" stop-color="var(--color-gold)" stop-opacity="1" />
        <stop offset="50%" stop-color="var(--color-red-deep)" stop-opacity="0.9" />
        <stop offset="75%" stop-color="#e0b790" stop-opacity="1" />
        <stop offset="100%" stop-color="var(--color-gold)" stop-opacity="1" />
      </linearGradient>

      <!-- Gradient 2: Ambient Companion Aura -->
      <linearGradient id="magicGradientAura" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#820907" stop-opacity="0.7" />
        <stop offset="50%" stop-color="#d4b354" stop-opacity="0.8" />
        <stop offset="100%" stop-color="#cc570e" stop-opacity="0.7" />
      </linearGradient>

      <!-- Gaussian Blur Filter 1: Sharp Core Glow -->
      <filter id="coreGlow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- Gaussian Blur Filter 2: Companion Blurred Aura ("Saudara Garis Blur") -->
      <filter id="companionBlur" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="12" result="blur1" />
        <feGaussianBlur stdDeviation="24" result="blur2" />
        <feMerge>
          <feMergeNode in="blur2" />
          <feMergeNode in="blur1" />
        </feMerge>
      </filter>

      <!-- Gaussian Blur Filter 3: Wide Ambient Energy Field -->
      <filter id="ambientWideBlur" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="32" result="wideBlur" />
      </filter>
    </defs>

    <!-- LAYER 1: Deepest Ambient Blurred Energy Cloud ("Saudara Ambient") -->
    <path
      id="strand-ambient"
      class="strand-path strand-ambient"
      d=""
      fill="none"
      stroke="url(#magicGradientAura)"
      stroke-width="32"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#ambientWideBlur)"
      opacity="0.35"
    />

    <!-- LAYER 2: Medium Blurred Companion Stream ("Saudara Medium Blur") -->
    <path
      id="strand-companion-b"
      class="strand-path strand-companion"
      d=""
      fill="none"
      stroke="url(#magicGradientAura)"
      stroke-width="16"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#companionBlur)"
      opacity="0.5"
    />

    <!-- LAYER 3: Soft Blurred Companion Stream ("Saudara Light Blur") -->
    <path
      id="strand-companion-a"
      class="strand-path strand-companion"
      d=""
      fill="none"
      stroke="url(#magicGradientMain)"
      stroke-width="8"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#companionBlur)"
      opacity="0.65"
    />

    <!-- LAYER 4: Main Sharp Glowing Magical Thread ("Garis Utama") -->
    <path
      id="strand-main"
      class="strand-path strand-main"
      d=""
      fill="none"
      stroke="url(#magicGradientMain)"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      filter="url(#coreGlow)"
    />

    <!-- Glowing Magical Orb Head -->
    <circle
      id="magic-head-orb"
      class="magic-head-orb"
      r="7"
      fill="var(--color-gold)"
      filter="url(#coreGlow)"
    />
    <circle
      id="magic-head-aura"
      class="magic-head-aura"
      r="16"
      fill="var(--color-red-deep)"
      opacity="0.5"
      filter="url(#companionBlur)"
    />
  </svg>
</div>

<style>
  .slithering-thread-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1; /* Sits behind section content */
    overflow: hidden;
  }

  .slithering-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .strand-path {
    transition: stroke-dashoffset 0.08s ease-out;
  }

  .magic-head-orb {
    box-shadow: 0 0 20px var(--color-gold);
  }

  .magic-head-aura {
    mix-blend-mode: screen;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('slithering-thread-container');
    const mainPath = document.getElementById('strand-main') as SVGPathElement | null;
    const compAPath = document.getElementById('strand-companion-a') as SVGPathElement | null;
    const compBPath = document.getElementById('strand-companion-b') as SVGPathElement | null;
    const ambientPath = document.getElementById('strand-ambient') as SVGPathElement | null;

    const headOrb = document.getElementById('magic-head-orb') as SVGCircleElement | null;
    const headAura = document.getElementById('magic-head-aura') as SVGCircleElement | null;

    const aboutSec = document.getElementById('about');
    const ctaSec = document.getElementById('cta');

    if (!wrapper || !mainPath || !aboutSec || !ctaSec) return;

    // Silky Smooth Cubic Bezier Path Generator
    function generateSmoothCubicPath(points: Array<{ x: number; y: number }>) {
      if (points.length < 2) return '';
      let d = `M ${points[0].x},${points[0].y}`;

      for (let i = 1; i < points.length; i++) {
        const p0 = points[i - 1];
        const p1 = points[i];

        // Smooth cubic control points for silky organic curves
        const cp1x = p0.x;
        const cp1y = p0.y + (p1.y - p0.y) * 0.5;
        const cp2x = p1.x;
        const cp2y = p0.y + (p1.y - p0.y) * 0.5;

        d += ` C ${cp1x},${cp1y} ${cp2x},${cp2y} ${p1.x},${p1.y}`;
      }
      return d;
    }

    function buildMagicalStreams() {
      if (!aboutSec || !ctaSec || !mainPath) return;

      const bodyRect = document.body.getBoundingClientRect();
      const aboutRect = aboutSec.getBoundingClientRect();
      const ctaRect = ctaSec.getBoundingClientRect();

      const startY = aboutRect.top - bodyRect.top + 80;
      const endY = ctaRect.bottom - bodyRect.top - 60;
      const totalH = endY - startY;

      if (totalH <= 0) return;

      const docWidth = window.innerWidth;
      const steps = 14;
      const stepY = totalH / steps;

      // Base Main Waypoints
      const mainPoints: Array<{ x: number; y: number }> = [];
      const compAPoints: Array<{ x: number; y: number }> = [];
      const compBPoints: Array<{ x: number; y: number }> = [];
      const ambientPoints: Array<{ x: number; y: number }> = [];

      for (let i = 0; i <= steps; i++) {
        const y = startY + i * stepY;

        // Smooth organic S-curve oscillations across 12% to 88% screen width
        let targetXRatio = 0.5;
        if (i % 4 === 1) targetXRatio = 0.85;
        else if (i % 4 === 2) targetXRatio = 0.5;
        else if (i % 4 === 3) targetXRatio = 0.15;
        else if (i % 4 === 0) targetXRatio = 0.5;

        const mainX = docWidth * targetXRatio;

        // Multi-strand offset variations ("Saudara Garis Magis")
        const offsetXA = Math.sin(i * 0.8) * 35;
        const offsetXB = Math.cos(i * 0.6) * 65;
        const offsetAmbient = Math.sin(i * 0.4) * 90;

        mainPoints.push({ x: mainX, y: y });
        compAPoints.push({ x: mainX + offsetXA, y: y + 10 });
        compBPoints.push({ x: mainX + offsetXB, y: y - 15 });
        ambientPoints.push({ x: mainX + offsetAmbient, y: y });
      }

      // Generate SVG path string with silky cubic bezier curves
      const mainD = generateSmoothCubicPath(mainPoints);
      const compAD = generateSmoothCubicPath(compAPoints);
      const compBD = generateSmoothCubicPath(compBPoints);
      const ambientD = generateSmoothCubicPath(ambientPoints);

      // Set Path Attributes
      mainPath.setAttribute('d', mainD);
      if (compAPath) compAPath.setAttribute('d', compAD);
      if (compBPath) compBPath.setAttribute('d', compBD);
      if (ambientPath) ambientPath.setAttribute('d', ambientD);

      // Prepare Scroll Trigger Animation
      const paths = [mainPath, compAPath, compBPath, ambientPath].filter(Boolean) as SVGPathElement[];

      paths.forEach(p => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });

      const mainLen = mainPath.getTotalLength();

      gsap.to(paths, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: aboutSec,
          endTrigger: ctaSec,
          start: 'top 60%',
          end: 'bottom 80%',
          scrub: 1.4,
          onUpdate: (self) => {
            if (!headOrb || !headAura || !mainPath) return;
            const progress = self.progress;
            const pt = mainPath.getPointAtLength(progress * mainLen);
            headOrb.setAttribute('cx', pt.x.toString());
            headOrb.setAttribute('cy', pt.y.toString());
            headAura.setAttribute('cx', pt.x.toString());
            headAura.setAttribute('cy', pt.y.toString());
          }
        }
      });
    }

    buildMagicalStreams();

    window.addEventListener('resize', () => {
      buildMagicalStreams();
      ScrollTrigger.refresh();
    });
  });
</script>
