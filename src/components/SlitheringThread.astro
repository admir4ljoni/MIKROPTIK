---
// SlitheringThread.astro - High-Performance 60FPS Magical Energy Stream Behind Content
---

<div class="slithering-thread-wrapper" id="slithering-thread-container" aria-hidden="true">
  <svg class="slithering-svg" id="slithering-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <defs>
      <!-- Deep Red to Gold Glowing Gradient -->
      <linearGradient id="magicGradientMain" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="var(--color-red-deep)" stop-opacity="0.95" />
        <stop offset="30%" stop-color="var(--color-gold)" stop-opacity="1" />
        <stop offset="60%" stop-color="var(--color-red-deep)" stop-opacity="0.9" />
        <stop offset="100%" stop-color="var(--color-gold)" stop-opacity="1" />
      </linearGradient>

      <!-- Soft Companion Gradient -->
      <linearGradient id="magicGradientCompanion" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#820907" stop-opacity="0.6" />
        <stop offset="50%" stop-color="#d4b354" stop-opacity="0.7" />
        <stop offset="100%" stop-color="#cc570e" stop-opacity="0.6" />
      </linearGradient>
    </defs>

    <!-- LAYER 1: Soft Blurred Companion Stream ("Saudara Garis Blur Magis") -->
    <path
      id="strand-companion"
      class="strand-path strand-companion"
      d=""
      fill="none"
      stroke="url(#magicGradientCompanion)"
      stroke-width="14"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.4"
    />

    <!-- LAYER 2: Main Crisp Glowing Magical Thread ("Garis Utama") -->
    <path
      id="strand-main"
      class="strand-path strand-main"
      d=""
      fill="none"
      stroke="url(#magicGradientMain)"
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />

    <!-- Glowing Magical Orb Head -->
    <circle
      id="magic-head-orb"
      class="magic-head-orb"
      r="6"
      fill="var(--color-gold)"
    />
  </svg>
</div>

<style>
  /* Wrapper berada di z-index 0 di belakang seluruh konten section */
  .slithering-thread-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0; /* Terletak mutlak di belakang elemen konten manapun */
    overflow: hidden;
    will-change: transform;
    transform: translateZ(0); /* Hardware GPU Acceleration */
  }

  .slithering-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .strand-main {
    filter: drop-shadow(0 0 10px rgba(212, 179, 84, 0.85)) drop-shadow(0 0 18px rgba(130, 9, 7, 0.9));
    will-change: stroke-dashoffset;
  }

  .strand-companion {
    filter: blur(8px) drop-shadow(0 0 20px rgba(130, 9, 7, 0.7));
    will-change: stroke-dashoffset;
  }

  .magic-head-orb {
    filter: drop-shadow(0 0 12px var(--color-gold)) drop-shadow(0 0 25px rgba(212, 179, 84, 0.9));
    will-change: cx, cy;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('slithering-thread-container');
    const mainPath = document.getElementById('strand-main') as SVGPathElement | null;
    const compPath = document.getElementById('strand-companion') as SVGPathElement | null;
    const headOrb = document.getElementById('magic-head-orb') as SVGCircleElement | null;

    const aboutSec = document.getElementById('about');
    const ctaSec = document.getElementById('cta');

    if (!wrapper || !mainPath || !aboutSec || !ctaSec) return;

    // Smooth Cubic Bezier Interpolation
    function generateSmoothCubicPath(points: Array<{ x: number; y: number }>) {
      if (points.length < 2) return '';
      let d = `M ${points[0].x},${points[0].y}`;

      for (let i = 1; i < points.length; i++) {
        const p0 = points[i - 1];
        const p1 = points[i];

        const cp1x = p0.x;
        const cp1y = p0.y + (p1.y - p0.y) * 0.5;
        const cp2x = p1.x;
        const cp2y = p0.y + (p1.y - p0.y) * 0.5;

        d += ` C ${cp1x},${cp1y} ${cp2x},${cp2y} ${p1.x},${p1.y}`;
      }
      return d;
    }

    function buildMagicalStreams() {
      if (!aboutSec || !ctaSec || !mainPath) return;

      const bodyRect = document.body.getBoundingClientRect();
      const aboutRect = aboutSec.getBoundingClientRect();
      const ctaRect = ctaSec.getBoundingClientRect();

      const startY = aboutRect.top - bodyRect.top + 80;
      const endY = ctaRect.bottom - bodyRect.top - 60;
      const totalH = endY - startY;

      if (totalH <= 0) return;

      const docWidth = window.innerWidth;
      const steps = 12;
      const stepY = totalH / steps;

      const mainPoints: Array<{ x: number; y: number }> = [];
      const compPoints: Array<{ x: number; y: number }> = [];

      for (let i = 0; i <= steps; i++) {
        const y = startY + i * stepY;

        let targetXRatio = 0.5;
        if (i % 4 === 1) targetXRatio = 0.82;
        else if (i % 4 === 2) targetXRatio = 0.5;
        else if (i % 4 === 3) targetXRatio = 0.18;
        else if (i % 4 === 0) targetXRatio = 0.5;

        const mainX = docWidth * targetXRatio;
        const offsetCompX = Math.sin(i * 0.7) * 45;

        mainPoints.push({ x: mainX, y: y });
        compPoints.push({ x: mainX + offsetCompX, y: y + 12 });
      }

      const mainD = generateSmoothCubicPath(mainPoints);
      const compD = generateSmoothCubicPath(compPoints);

      mainPath.setAttribute('d', mainD);
      if (compPath) compPath.setAttribute('d', compD);

      const paths = [mainPath, compPath].filter(Boolean) as SVGPathElement[];

      paths.forEach(p => {
        const len = p.getTotalLength();
        p.style.strokeDasharray = `${len}`;
        p.style.strokeDashoffset = `${len}`;
      });

      const mainLen = mainPath.getTotalLength();

      gsap.to(paths, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: {
          trigger: aboutSec,
          endTrigger: ctaSec,
          start: 'top 60%',
          end: 'bottom 80%',
          scrub: 1.0,
          onUpdate: (self) => {
            if (!headOrb || !mainPath) return;
            const progress = self.progress;
            const pt = mainPath.getPointAtLength(progress * mainLen);
            headOrb.setAttribute('cx', pt.x.toString());
            headOrb.setAttribute('cy', pt.y.toString());
          }
        }
      });
    }

    buildMagicalStreams();

    let resizeTimer: any;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        buildMagicalStreams();
        ScrollTrigger.refresh();
      }, 150);
    });
  });
</script>
