---
import { Trophy, Award, Medal, Crown, Shield, Sparkles } from '@lucide/astro';

const hallOfFameItems = [
  {
    id: 1,
    badge: "JUARA 1 NASIONAL",
    badgeIcon: Trophy,
    category: "UI/UX DESIGN & PRODUCT INOVATION",
    title: "GEMASTIK XVIII KEMENRISTEKDIKTI",
    winner: "Tim PTIK UX Innovators",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi1/1000/800",
    description: "Meraih Medali Emas cabang Desain Pengalaman Pengguna (UI/UX) tingkat Nasional dengan platform inklusif.",
    gridClass: "bento-col-2 bento-row-2"
  },
  {
    id: 2,
    badge: "MEDALI EMAS HACKATHON",
    badgeIcon: Medal,
    category: "AI & WEB DEVELOPMENT",
    title: "NATIONAL AI & WEB HACKATHON 2025",
    winner: "Siti Rahma & Tim Web Dev",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi2/1000/800",
    description: "Juara Utama kategori Inovasi Aplikasi Web Berbasis AI untuk transformasi pendidikan digital.",
    gridClass: "bento-col-2 bento-row-2"
  },
  {
    id: 3,
    badge: "BEST PAPER PUBLICATION",
    badgeIcon: Award,
    category: "MACHINE LEARNING & DATA",
    title: "NATIONAL CONFERENCE ON IT 2025",
    winner: "Ahmad Fauzi & Tim Riset Data",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi3/800/600",
    description: "Penghargaan Makalah Terbaik publikasi riset Machine Learning dan Big Data Analytics.",
    gridClass: "bento-col-1 bento-row-1"
  },
  {
    id: 4,
    badge: "JUARA 1 PROGRAMMING",
    badgeIcon: Crown,
    category: "COMPETITIVE PROGRAMMING",
    title: "OLIMPIADE KOMPUTER PT 2025",
    winner: "Budi Santoso",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi4/800/600",
    description: "Meraih Juara Pertama kategori Algoritma, Efisiensi Struktur Data, dan Pemrograman Kompetitif.",
    gridClass: "bento-col-1 bento-row-1"
  },
  {
    id: 5,
    badge: "TOP CYBER DEFENSE",
    badgeIcon: Shield,
    category: "CYBER SECURITY CTF",
    title: "NATIONAL CTF SECURITY 2025",
    winner: "Tim PTIK Cyber Defense",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi5/800/600",
    description: "Peringkat 2 Kejuaraan Nasional Keamanan Siber, Penetrasi Jaringan, dan Cryptography.",
    gridClass: "bento-col-1 bento-row-1"
  },
  {
    id: 6,
    badge: "DELEGASI MAPRES UTAMA",
    badgeIcon: Sparkles,
    category: "PILMAPRES KEMENDIKBUD",
    title: "PEMILIHAN MAHASISWA BERPRESTASI 2025",
    winner: "Dian Permata",
    year: "2025",
    image: "https://picsum.photos/seed/prestasi6/800/600",
    description: "Perwakilan Mahasiswa Berprestasi Utama FKIP UNS pada ajang Pilmapres Tingkat Nasional.",
    gridClass: "bento-col-1 bento-row-1"
  }
];
---

<div class="halloffame-bento-fullwidth-wrapper">
  <div class="halloffame-bento-grid">
    {hallOfFameItems.map((item) => (
      <article class={`halloffame-bento-card ${item.gridClass}`}>
        <!-- Background Full Image -->
        <img src={item.image} alt={item.title} class="halloffame-bg-img" loading="lazy" />

        <!-- Top Gold Honor Badge -->
        <div class="halloffame-badge-wrapper">
          <span class="halloffame-gold-badge">
            <item.badgeIcon size={14} style="display: inline-block; vertical-align: middle; margin-right: 4px;" />
            {item.badge}
          </span>
          <span class="halloffame-year-badge">{item.year}</span>
        </div>

        <!-- Bottom Shadow Overlay Gradient -->
        <div class="halloffame-card-overlay">
          <div class="halloffame-card-content">
            <span class="halloffame-card-category">{item.category}</span>
            <h3 class="halloffame-card-title">{item.title}</h3>
            <p class="halloffame-card-winner">{item.winner}</p>
            <p class="halloffame-card-desc">{item.description}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .halloffame-bento-fullwidth-wrapper {
    position: relative;
    width: 100%;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    margin-top: 1.5rem;
  }

  .halloffame-bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 270px;
    gap: 1.25rem;
    width: 100%;
  }

  /* Base Hall of Fame Bento Card (Style Tegas 4px, Gold Border Accent) */
  .halloffame-bento-card {
    position: relative;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    overflow: hidden;
    border: 1px solid rgba(212, 179, 84, 0.3);
    background: var(--color-dark);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s ease,
                border-color 0.4s ease;
    cursor: pointer;
  }

  .halloffame-bento-card:hover {
    transform: translateY(-6px);
    border-color: var(--color-gold);
    box-shadow: 
      0 0 35px rgba(212, 179, 84, 0.5),
      0 15px 40px rgba(130, 9, 7, 0.45);
  }

  /* Compact Mosaic Grid Spans */
  .bento-col-1 {
    grid-column: span 1;
  }

  .bento-col-2 {
    grid-column: span 2;
  }

  .bento-row-1 {
    grid-row: span 1;
  }

  .bento-row-2 {
    grid-row: span 2;
  }

  /* Image Background Zoom */
  .halloffame-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .halloffame-bento-card:hover .halloffame-bg-img {
    transform: scale(1.06);
  }

  /* Top Honor Badges */
  .halloffame-badge-wrapper {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 5;
  }

  .halloffame-gold-badge {
    background: linear-gradient(135deg, #d4b354 0%, #820907 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
    text-transform: uppercase;
  }

  .halloffame-year-badge {
    background: rgba(28, 22, 20, 0.85);
    backdrop-filter: blur(8px);
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 179, 84, 0.4);
  }

  /* Bottom Shadow Overlay Gradient */
  .halloffame-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem;
    background: linear-gradient(
      to top,
      rgba(28, 22, 20, 0.98) 0%,
      rgba(28, 22, 20, 0.85) 45%,
      rgba(28, 22, 20, 0.2) 75%,
      transparent 100%
    );
    z-index: 2;
  }

  .halloffame-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .halloffame-card-category {
    font-family: var(--font-heading);
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    color: var(--color-gold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .halloffame-card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.1vw, 2.2rem);
    color: var(--color-white);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .halloffame-card-winner {
    font-family: var(--font-heading);
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    color: var(--color-gold);
    letter-spacing: 0.05em;
  }

  .halloffame-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 0.95vw, 0.95rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.5;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Responsive Mobile Adjustments */
  @media (max-width: 1100px) {
    .halloffame-bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 290px;
    }

    .bento-col-2 {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .halloffame-bento-fullwidth-wrapper {
      padding: 0 0.75rem;
    }

    .halloffame-bento-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 340px;
      gap: 1rem;
    }

    .bento-col-1,
    .bento-col-2,
    .bento-row-1,
    .bento-row-2 {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
