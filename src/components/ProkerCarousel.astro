---
const prokerItems = [
  {
    id: 1,
    title: "INFORMATICS COMPASS 2025",
    image: "https://picsum.photos/seed/proker1/800/1000",
    description: "Rangkaian pembekalan, pengenalan kurikulum, dan budaya akademik prodi PTIK UNS bagi mahasiswa baru agar siap berprestasi."
  },
  {
    id: 2,
    title: "TECHNOFEST COMPETITION",
    image: "https://picsum.photos/seed/proker2/800/1000",
    description: "Kompetisi teknologi tingkat nasional mencakup Web Development, UI/UX Design, dan Competitive Programming untuk pelajar & mahasiswa."
  },
  {
    id: 3,
    title: "PTIK GOES TO COMMUNITY",
    image: "https://picsum.photos/seed/proker3/800/1000",
    description: "Program pengabdian masyarakat berupa pelatihan literasi digital, branding sosial media, dan pembuatan website bagi UMKM binaan."
  },
  {
    id: 4,
    title: "WORKSHOP & STUDY CLUB TECH",
    image: "https://picsum.photos/seed/proker4/800/1000",
    description: "Sesi intensif pengasahan skill software engineering, cloud computing, dan AI bersama praktisi alumni industri teknologi."
  },
  {
    id: 5,
    title: "PTIK CAREER & ALUMNI EXPO",
    image: "https://picsum.photos/seed/proker5/800/1000",
    description: "Ajang jejaring alumni dan industri IT untuk memberikan wawasan karir serta peluang magang bagi mahasiswa aktif."
  },
  {
    id: 6,
    title: "LKMM-TD NAYA VIKRAMA",
    image: "https://picsum.photos/seed/proker6/800/1000",
    description: "Latihan Keterampilan Manajemen Mahasiswa Tingkat Dasar untuk membina jiwa kepemimpinan, integritas, dan manajerial organisasi."
  }
];

// Duplikasi items 5x untuk seamless 100vw ultra-wide infinite loop
const displayItems = [
  ...prokerItems,
  ...prokerItems,
  ...prokerItems,
  ...prokerItems,
  ...prokerItems
];
---

<div class="proker-carousel-wrapper" id="proker-carousel">
  <div class="proker-carousel-container" id="proker-container">
    <div class="proker-track" id="proker-track">
      {displayItems.map((item, index) => (
        <article class={`proker-card-full ${index === 12 ? 'active' : ''}`} data-index={index}>
          <!-- Background Image Full Card -->
          <img src={item.image} alt={item.title} class="proker-card-bg-img" loading="lazy" />
          
          <!-- Gradient Shadow Overlay at Bottom -->
          <div class="proker-card-overlay">
            <div class="proker-card-content">
              <h3 class="proker-card-title">{item.title}</h3>
              <p class="proker-card-desc">{item.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<style>
  .proker-carousel-wrapper {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow: hidden;
  }

  .proker-carousel-container {
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 2rem 0;
    height: 680px;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .proker-carousel-container::-webkit-scrollbar {
    display: none;
  }

  .proker-track {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-left: calc(50vw - clamp(160px, 16vw, 220px));
    padding-right: calc(50vw - clamp(160px, 16vw, 220px));
    width: max-content;
    height: 640px;
  }

  /* Card Base - Side Cards (Ramping, HANYA Menampilkan Judul) */
  .proker-card-full {
    position: relative;
    width: clamp(260px, 24vw, 340px);
    height: 600px;
    border-radius: var(--radius-sm); /* Style tegas: corner radius kecil 4px */
    overflow: hidden;
    border: none;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.4);
    opacity: 0.55;
    filter: grayscale(25%);
    transform: scale(0.85);
    transform-origin: center center;
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.4s ease,
                filter 0.4s ease;
    flex-shrink: 0;
    cursor: pointer;
    will-change: width, transform, opacity, box-shadow;
  }

  /* Kartu Tengah Active (Extend Melebar Horisontal, Menampilkan Deskripsi & 360° Glow) */
  .proker-card-full.active {
    width: clamp(400px, 42vw, 560px);
    opacity: 1;
    filter: grayscale(0%);
    transform: scale(1);
    border: none;
    box-shadow: 
      0 0 30px rgba(212, 179, 84, 0.45),
      0 0 60px rgba(204, 87, 14, 0.35),
      0 0 100px rgba(130, 9, 7, 0.3);
    z-index: 10;
  }

  .proker-card-full.no-anim,
  .proker-card-full.no-anim .proker-card-desc {
    transition: none !important;
  }

  .proker-card-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proker-card-full.active:hover .proker-card-bg-img {
    transform: scale(1.05);
  }

  /* Bottom Shadow Overlay Gradient */
  .proker-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.25rem 1.85rem;
    background: linear-gradient(
      to top,
      rgba(28, 22, 20, 0.98) 0%,
      rgba(28, 22, 20, 0.85) 45%,
      rgba(28, 22, 20, 0.25) 75%,
      transparent 100%
    );
    z-index: 2;
  }

  .proker-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .proker-card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    color: var(--color-gold);
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  /* Deskripsi Teks - HANYA Tampil di Kartu Tengah Active */
  .proker-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.9rem, 1.1vw, 1.02rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.55;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transform: translateY(12px);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .proker-card-full.active .proker-card-desc {
    opacity: 1;
    max-height: 160px;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .proker-card-full {
      width: 82vw;
      height: 480px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('proker-container');
    const cards = Array.from(document.querySelectorAll('.proker-card-full')) as HTMLElement[];

    if (!container || cards.length === 0) return;

    const itemCount = 6; // jumlah item original
    let singleSetWidth = 0;

    function calculateWidths() {
      if (cards.length >= itemCount * 2) {
        singleSetWidth = cards[itemCount].offsetLeft - cards[0].offsetLeft;
      }
    }

    calculateWidths();

    // Inisialisasi posisi scroll di tengah (set ke-3)
    if (singleSetWidth > 0) {
      container.scrollLeft = singleSetWidth * 2;
    }

    function updateCenterCard() {
      if (!container) return;
      const containerRect = container.getBoundingClientRect();
      const containerCenter = containerRect.left + containerRect.width / 2;

      let closestCard: HTMLElement | null = null;
      let minDistance = Infinity;

      cards.forEach((card) => {
        const cardRect = card.getBoundingClientRect();
        const cardCenter = cardRect.left + cardRect.width / 2;
        const distance = Math.abs(containerCenter - cardCenter);

        if (distance < minDistance) {
          minDistance = distance;
          closestCard = card;
        }
      });

      cards.forEach((card) => {
        if (card === closestCard) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }

    function checkInfiniteLoop() {
      if (!container || singleSetWidth === 0) return;

      let resetDelta = 0;

      // Jika scroll melewatai batas kanan (set ke-4)
      if (container.scrollLeft >= singleSetWidth * 3.5) {
        resetDelta = -singleSetWidth;
      }
      // Jika scroll melewatai batas kiri (set ke-2)
      else if (container.scrollLeft <= singleSetWidth * 0.5) {
        resetDelta = singleSetWidth;
      }

      if (resetDelta !== 0) {
        // Matikan animasi transisi sementara agar tidak memicu pop-up scaling meletup
        cards.forEach((c) => c.classList.add('no-anim'));

        container.scrollLeft += resetDelta;
        updateCenterCard();

        // Reactivate animasi transisi pada frame berikutnya
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            cards.forEach((c) => c.classList.remove('no-anim'));
          });
        });
      }
    }

    // Direct scroll handler tanpa debounce setTimeout agar seamless tanpa visual snapback
    container.addEventListener('scroll', () => {
      checkInfiniteLoop();
      updateCenterCard();
    }, { passive: true });

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const targetScrollLeft = cardCenter - container.clientWidth / 2;
        container.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });
      });
    });

    window.addEventListener('resize', () => {
      calculateWidths();
      updateCenterCard();
    }, { passive: true });

    // Initial positioning check
    setTimeout(() => {
      calculateWidths();
      if (singleSetWidth > 0 && (container.scrollLeft === 0 || container.scrollLeft < singleSetWidth)) {
        container.scrollLeft = singleSetWidth * 2;
      }
      updateCenterCard();
    }, 50);
  });
</script>
