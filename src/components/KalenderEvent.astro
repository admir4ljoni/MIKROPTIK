---

<div class="custom-calendar-section-wrapper" id="custom-calendar-root">
  <div class="custom-calendar-container">
    <!-- SEBELAH KIRI: Monthly Calendar Grid (Matching Screenshot) -->
    <div class="calendar-grid-box">
      <!-- Calendar Header: Month Title & Navigation -->
      <div class="calendar-box-header">
        <div class="calendar-month-title">
          <span class="month-name-text" id="month-name-text">August</span>
          <span class="year-italic-text" id="year-text">2026</span>
        </div>

        <div class="calendar-nav-buttons">
          <button class="cal-nav-btn" id="prev-month-btn" aria-label="Bulan Sebelumnya">
            <ChevronLeft size={18} />
          </button>
          <button class="cal-nav-btn" id="next-month-btn" aria-label="Bulan Berikutnya">
            <ChevronRight size={18} />
          </button>
        </div>
      </div>

      <!-- Days of Week Header -->
      <div class="calendar-weekdays-row">
        <span>SUN</span>
        <span>MON</span>
        <span>TUE</span>
        <span>WED</span>
        <span>THU</span>
        <span>FRI</span>
        <span>SAT</span>
      </div>

      <!-- Dates Grid Cells -->
      <div class="calendar-days-grid" id="calendar-days-grid">
        <!-- Injected via JavaScript -->
      </div>
    </div>

    <!-- SEBELAH KANAN: Event Detail Inspection Panel (Matching Screenshot) -->
    <div class="calendar-detail-panel" id="calendar-detail-panel">
      <!-- Default Empty State -->
      <div class="calendar-empty-state active" id="calendar-empty-state">
        <div class="empty-mascot-box">
          <Sparkles size={36} style="color: var(--color-gold);" />
        </div>
        <h4 class="empty-state-title">Pilih Tanggal</h4>
        <p class="empty-state-desc">
          Klik pada tanggal di kalender yang memiliki highlight warna untuk melihat detail kegiatan.
        </p>
      </div>

      <!-- Active Selected Date Content -->
      <div class="calendar-active-event-box" id="calendar-active-event-box">
        <div class="event-detail-header">
          <span class="detail-event-category" id="detail-category">Category</span>
          <span class="detail-event-date" id="detail-date-str">Date</span>
        </div>

        <div class="event-detail-body">
          <span class="detail-event-div" id="detail-div">Division</span>
          <h3 class="detail-event-title" id="detail-title">Event Title</h3>
          <p class="detail-event-desc" id="detail-desc">Description</p>
        </div>

        <div class="event-detail-footer">
          <div class="detail-location">
            <MapPin size={16} style="color: var(--color-gold); margin-right: 6px;" />
            <span id="detail-location-text">Location</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .custom-calendar-section-wrapper {
    position: relative;
    width: 100%;
    margin-top: 1.5rem;
  }

  .custom-calendar-container {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 2rem;
    align-items: stretch;
    width: 100%;
  }

  /* SEBELAH KIRI: Calendar Box (Sesuai Tangkapan Layar) */
  .calendar-grid-box {
    background: #18090f; /* Dark Crimson / Wine Background persis di screenshot */
    border: 1px solid rgba(212, 179, 84, 0.25);
    border-radius: var(--radius-sm); /* Style tegas 4px */
    padding: 2.25rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .calendar-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .calendar-month-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .month-name-text {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw, 2.5rem);
    color: #ffffff;
    letter-spacing: 0.03em;
  }

  .year-italic-text {
    font-family: serif;
    font-style: italic;
    font-size: clamp(1.8rem, 2.8vw, 2.3rem);
    color: #e63956; /* Pink/Red accent persis seperti di screenshot */
  }

  .calendar-nav-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .cal-nav-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cal-nav-btn:hover {
    background: #820907;
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  /* Weekdays Header */
  .calendar-weekdays-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.1em;
  }

  /* Days Grid Cells */
  .calendar-days-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.6rem;
  }

  .cal-day-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    cursor: default;
    transition: all 0.3s ease;
  }

  .cal-day-cell.empty {
    background: transparent;
    border: none;
  }

  .cal-day-cell.has-event {
    background: linear-gradient(135deg, rgba(130, 9, 7, 0.75) 0%, rgba(28, 22, 20, 0.9) 100%);
    border: 1.5px solid var(--color-gold);
    color: var(--color-gold);
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(130, 9, 7, 0.5);
  }

  .cal-day-cell.has-event:hover,
  .cal-day-cell.has-event.selected {
    background: #820907;
    border-color: #ffffff;
    color: #ffffff;
    box-shadow: 0 0 20px rgba(212, 179, 84, 0.8);
    transform: scale(1.08);
    z-index: 10;
  }

  .event-dot-indicator {
    position: absolute;
    bottom: 6px;
    right: 6px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 8px var(--color-gold);
  }

  /* SEBELAH KANAN: Detail Inspection Panel (Sesuai Tangkapan Layar) */
  .calendar-detail-panel {
    background: #18090f;
    border: 1.5px dashed rgba(212, 179, 84, 0.3);
    border-radius: var(--radius-sm);
    padding: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
  }

  /* Empty State View */
  .calendar-empty-state {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    max-width: 320px;
  }

  .calendar-empty-state.active {
    display: flex;
  }

  .empty-mascot-box {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: rgba(130, 9, 7, 0.4);
    border: 1.5px solid var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
    box-shadow: 0 0 25px rgba(212, 179, 84, 0.3);
  }

  .empty-state-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: #ffffff;
    letter-spacing: 0.04em;
  }

  .empty-state-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
  }

  /* Active Selected Event Card View */
  .calendar-active-event-box {
    display: none;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  .calendar-active-event-box.active {
    display: flex;
  }

  .event-detail-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(212, 179, 84, 0.3);
  }

  .detail-event-category {
    background: linear-gradient(135deg, #d4b354 0%, #820907 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .detail-event-date {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    color: var(--color-gold);
  }

  .event-detail-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detail-event-div {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .detail-event-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    color: #ffffff;
    line-height: 1.15;
  }

  .detail-event-desc {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.65;
  }

  .event-detail-footer {
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .detail-location {
    display: flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (max-width: 900px) {
    .custom-calendar-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .calendar-grid-box {
      padding: 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const monthNameText = document.getElementById('month-name-text');
    const yearText = document.getElementById('year-text');
    const prevBtn = document.getElementById('prev-month-btn');
    const nextBtn = document.getElementById('next-month-btn');
    const daysGrid = document.getElementById('calendar-days-grid');

    const emptyState = document.getElementById('calendar-empty-state');
    const activeEventBox = document.getElementById('calendar-active-event-box');

    const detailCategory = document.getElementById('detail-category');
    const detailDateStr = document.getElementById('detail-date-str');
    const detailDiv = document.getElementById('detail-div');
    const detailTitle = document.getElementById('detail-title');
    const detailDesc = document.getElementById('detail-desc');
    const detailLocationText = document.getElementById('detail-location-text');

    const monthNames = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];

    // Events Lookup Dictionary
    const eventsData: { [key: string]: Array<{ id: number; title: string; category: string; division: string; dateStr: string; location: string; desc: string }> } = {
      "2026-02-10": [{ id: 1, title: "Rapat Kerja (Raker) 2026", category: "Wajib", division: "Sekretaris & Bendahara", dateStr: "10 Februari 2026", location: "Aula FKIP UNS", desc: "Penetapan dan sosialisasi seluruh arah gerak serta program kerja HMP MIKROPTIK 2026." }],
      "2026-02-15": [{ id: 2, title: "Open Recruitment Pengurus", category: "Kaderisasi", division: "Divisi PSDM", dateStr: "15 Februari 2026", location: "Kampus PTIK UNS", desc: "Perekrutan pengurus muda HMP MIKROPTIK Kabinet Naya Vikrama." }],
      "2026-03-05": [{ id: 3, title: "Pelatihan Sekben", category: "Internal", division: "Sekretaris & Bendahara", dateStr: "5 Maret 2026", location: "Lab Komputer PTIK", desc: "Pelatihan administrasi dan tata kelola keuangan organisasi." }],
      "2026-03-12": [{ id: 4, title: "Upgrading Pengurus", category: "Internal", division: "Kahim & Wakahim", dateStr: "12 Maret 2026", location: "Ruang Ormawa PTIK", desc: "Peningkatan kapabilitas dan soliditas pengurus HMP MIKROPTIK 2026." }],
      "2026-03-24": [{ id: 5, title: "Mikroptik Social Action (MSA)", category: "Aksi Sosial", division: "Divisi Humas", dateStr: "24 Maret 2026", location: "Surakarta", desc: "Aksi berbagi takjil dan pengabdian masyarakat di bulan suci Ramadhan." }],
      "2026-04-18": [{ id: 6, title: "Mikroptik Store Launch", category: "Dana Usaha", division: "Bendahara Umum", dateStr: "18 April 2026", location: "Online & Sekre", desc: "Peluncuran merchandise dan produk resmi HMP MIKROPTIK." }],
      "2026-04-20": [{ id: 7, title: "Podcast Mikroptik Ep.1", category: "Media", division: "Divisi Medinfo", dateStr: "20 April 2026", location: "Studio Podcast & YouTube", desc: "Bincang santai seputar dunia perkuliahan IT dan pengalaman alumni." }],
      "2026-05-16": [{ id: 8, title: "Studi Banding Himpunan", category: "Eksternal", division: "Divisi Humas", dateStr: "16 Mei 2026", location: "Universitas Mitra", desc: "Pertukaran wawasan dan studi budaya organisasi dengan HMP kampus lain." }],
      "2026-06-05": [{ id: 9, title: "JPTK CUP 2026", category: "Olahraga & Seni", division: "Divisi Mikat", dateStr: "5 Juni 2026", location: "Sport Center UNS", desc: "Pekan olahraga, E-Sports, dan seni antar angkatan civitas akademika PTIK." }],
      "2026-06-10": [{ id: 10, title: "JPTK Berbagi & Sambung Rasa", category: "Advokasi", division: "Divisi Humas", dateStr: "10 Juni 2026", location: "Ruang Diskusi PTIK", desc: "Ruang aspirasi mahasiswa dan sarasehan bersama pengelola prodi PTIK." }],
      "2026-08-18": [{ id: 11, title: "SAMARU & OSMARU 2026", category: "Kaderisasi", division: "Divisi PSDM", dateStr: "18 Agustus 2026", location: "Kampus UNS", desc: "Penyambutan dan pengenalan kampus bagi mahasiswa baru prodi PTIK." }],
      "2026-08-29": [{ id: 12, title: "Sambut Wisuda PTIK", category: "Apresiasi", division: "Divisi Humas", dateStr: "29 Agustus 2026", location: "Gedung FKIP UNS", desc: "Apresiasi dan pelepasan wisudawan/wisudawati prodi PTIK UNS." }],
      "2026-09-15": [{ id: 13, title: "BYTESFEST 2026", category: "Big Event", division: "Kahim & Wakahim", dateStr: "15 September 2026", location: "Gedung UNS & Online", desc: "Festival IT dan kompetisi berskala nasional bagi pelajar & mahasiswa se-Indonesia." }],
      "2026-10-10": [{ id: 14, title: "LDKM Naya Vikrama", category: "Kaderisasi", division: "Divisi PSDM", dateStr: "10 Oktober 2026", location: "Outbound Camp", desc: "Latihan Dasar Kepemimpinan Mahasiswa untuk membentuk kepemimpinan progresif." }],
      "2026-11-07": [{ id: 15, title: "PSDM Adventure", category: "Internal", division: "Divisi PSDM", dateStr: "7 November 2026", location: "Tawangmangu", desc: "Kegiatan keakraban dan penguatan karakter antar pengurus." }],
      "2026-11-20": [{ id: 16, title: "Festival MIKAT & Seminar PKM", category: "Akademik & Seni", division: "Divisi Mikat", dateStr: "20 November 2026", location: "Aula UNS", desc: "Pameran bakat, seminar Program Kreativitas Mahasiswa, dan apresiasi prestasi." }]
    };

    let currentYear = 2026;
    let currentMonthIdx = 7; // August (0-indexed: 7 = August)

    function renderCalendar() {
      if (!daysGrid || !monthNameText || !yearText) return;

      monthNameText.textContent = monthNames[currentMonthIdx];
      yearText.textContent = currentYear.toString();

      daysGrid.innerHTML = '';

      // Reset inspection panel
      if (emptyState) emptyState.classList.add('active');
      if (activeEventBox) activeEventBox.classList.remove('active');

      const firstDay = new Date(currentYear, currentMonthIdx, 1).getDay(); // 0 = Sunday
      const daysInMonth = new Date(currentYear, currentMonthIdx + 1, 0).getDate();

      // Render Empty lead cells
      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'cal-day-cell empty';
        daysGrid.appendChild(emptyCell);
      }

      // Render Actual Date Cells (1..daysInMonth)
      for (let day = 1; day <= daysInMonth; day++) {
        const cell = document.createElement('div');
        cell.className = 'cal-day-cell';
        cell.textContent = day.toString();

        const monthStr = String(currentMonthIdx + 1).padStart(2, '0');
        const dayStr = String(day).padStart(2, '0');
        const dateKey = `${currentYear}-${monthStr}-${dayStr}`;

        if (eventsData[dateKey]) {
          cell.classList.add('has-event');
          const dot = document.createElement('div');
          dot.className = 'event-dot-indicator';
          cell.appendChild(dot);

          cell.addEventListener('click', () => {
            document.querySelectorAll('.cal-day-cell').forEach(c => c.classList.remove('selected'));
            cell.classList.add('selected');

            showEventDetail(eventsData[dateKey][0]);
          });
        }

        daysGrid.appendChild(cell);
      }
    }

    function showEventDetail(eventItem: any) {
      if (!emptyState || !activeEventBox) return;

      emptyState.classList.remove('active');
      activeEventBox.classList.add('active');

      if (detailCategory) detailCategory.textContent = eventItem.category;
      if (detailDateStr) detailDateStr.textContent = eventItem.dateStr;
      if (detailDiv) detailDiv.textContent = eventItem.division;
      if (detailTitle) detailTitle.textContent = eventItem.title;
      if (detailDesc) detailDesc.textContent = eventItem.desc;
      if (detailLocationText) detailLocationText.textContent = eventItem.location;
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentMonthIdx--;
        if (currentMonthIdx < 0) {
          currentMonthIdx = 11;
          currentYear--;
        }
        renderCalendar();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentMonthIdx++;
        if (currentMonthIdx > 11) {
          currentMonthIdx = 0;
          currentYear++;
        }
        renderCalendar();
      });
    }

    // Initial Render
    renderCalendar();
  });
</script>
