---
import DivisiLayout from "../../layouts/DivisiLayout.astro";
import DivisiHero from "../../components/DivisiHero.astro";
import DivisiProker from "../../components/DivisiProker.astro";
import DivisiFotoGaleri from "../../components/DivisiFotoGaleri.astro";
import DivisiSplitSection from "../../components/DivisiSplitSection.astro";
import SectionHeading from "../../components/SectionHeading.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const divisiData = {
  name: "PSDM",
  badge: "DIVISI PSDM",
  tagline: "Pengembangan Potensi, Kompetensi & Karakter",
  slug: "psdm",
  bgImage: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO BERSAMA.webp`,
  fotoKadiv: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO KADIV.webp`,
  fotoStaffAhli: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF AHLI.webp`,
  fotoStaffMuda1: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF MUDA 1.webp`,
  fotoStaffMuda2: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF MUDA 2.webp`,
  description:
    "Divisi Pengembangan Sumber Daya Mahasiswa (PSDM) HMP MIKROPTIK Kabinet Naya Vikrama merupakan divisi yang berfokus pada pengembangan potensi, kompetensi, dan karakter mahasiswa PTIK. PSDM berperan sebagai wadah sekaligus fasilitator bagi mahasiswa baru dalam beradaptasi dengan lingkungan perkuliahan, mengembangkan diri, serta membangun relasi di lingkungan kampus. Melalui berbagai program kerja, seperti Open Recruitment, PSDM juga membuka kesempatan bagi mahasiswa untuk bergabung, berkontribusi, dan bertumbuh bersama dalam organisasi.",
  proker: [
    { title: "PSDM ADVENTURE", description: "PSDM Adventure adalah upaya divisi PSDM untuk menjalin relasi yang baik antar divisi dalam Kabinet Naya Vikrama." },
    { title: "SAMARU (Sambut Mahasiswa Baru)", description: "SAMARU (Sambut Mahasiswa Baru) adalah program sambutan istimewa bagi mahasiswa baru untuk mengenal sirkumstansi perkuliahan." },
    { title: "OSMARU (Orientasi Mahasiswa Baru)", description: "OSMARU (Orientasi Mahasiswa Baru) adalah program orientasi mahasiswa untuk lebih mengenal dan memahami ekosistem kampus hingga program studi." },
    { title: "LDKM (Latihan Keterampilan Manajemen Mahasiswa)", description: "LDKM adalah program pelatihan kepemimpinan bagi mahasiswa baru sebagai puncak masa orientasi mahasiswa baru." },
    { title: "OPEN RECRUITMENT PENGURUS", description: "Open Recruitment adalah serangkaian program regenerasi anggota-anggota himpunan dalam mempertahankan keberlangsungan HMP MIKROPTIK." },
    { title: "REORGANISASI HIMPUNAN", description: "Reorganisasi adalah puncak regenerasi anggota-anggota himpunan untuk menyambut wajah baru demi kinerja yang lebih optimal." },
  ],
  galeri: [
    {
      title: "Foto Bersama Divisi PSDM",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO BERSAMA.webp`,
      isFeatured: true,
    },
    {
      title: "Kadiv PSDM",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO KADIV.webp`,
    },
    {
      title: "Staff Ahli PSDM",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF AHLI.webp`,
    },
    {
      title: "Staff Muda PSDM 1",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF MUDA 1.webp`,
    },
    {
      title: "Staff Muda PSDM 2",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/PSDM/FOTO STAFF MUDA 2.webp`,
    },
  ],
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  divisiSlug={divisiData.slug}
  prevDivisi={{ name: "BENDAHARA UMUM", slug: "bendahara-umum" }}
  nextDivisi={{ name: "MIKAT", slug: "mikat" }}
>
  <!-- Hero Section (100vh) -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Fasilitator pengembangan karakter, kaderisasi, adaptasi mahasiswa baru, serta regenerasi kepengurusan himpunan."
    bgImage={divisiData.bgImage}
    bgPosition="center 58%"
    brightness={0.72}
  />

  <!-- Section 1: Deskripsi Profil paired with Foto Kadiv (60/40 Viewport Segment) -->
  <DivisiSplitSection
    imageSrc={divisiData.fotoKadiv}
    imageAlt="Kadiv PSDM"
    reverse={false}
  >
    <SectionHeading
      titleMain="PROFIL"
      titleAccent="Divisi"
      subtitle="Peran dan fokus utama Divisi PSDM dalam membentuk insan akademis yang berkarakter"
      align="left"
    />
    <div class="brutalist-profile-box">
      <p class="brutalist-desc-text">{divisiData.description}</p>
    </div>
  </DivisiSplitSection>

  <!-- Section 2: Program Kerja paired with Foto Staff Ahli (60/40 Viewport Segment) -->
  <DivisiProker
    prokerList={divisiData.proker}
    imageSrc={divisiData.fotoStaffAhli}
    reverse={true}
  />

  <!-- Section 3: Galeri Dokumentasi 1 paired with Foto Staff Muda 1 (60/40 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri.slice(0, 3)}
    imageSrc={divisiData.fotoStaffMuda1}
    reverse={false}
  />

  <!-- Section 4: Galeri Dokumentasi 2 paired with Foto Staff Muda 2 (60/40 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri.slice(2)}
    imageSrc={divisiData.fotoStaffMuda2}
    reverse={true}
  />
</DivisiLayout>
