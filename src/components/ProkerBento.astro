---

<div class="proker-bento-grid">
  {prokerItems.map((item) => (
    <article class={`bento-card bento-card-${item.size}`}>
      <!-- Background Image Full Card -->
      <img src={item.image} alt={item.title} class="bento-card-bg-img" loading="lazy" />
      
      <!-- Dark Bottom Shadow Overlay Gradient -->
      <div class="bento-card-overlay">
        <div class="bento-card-content">
          <h3 class="bento-card-title">{item.title}</h3>
          <p class="bento-card-desc">{item.description}</p>
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .proker-bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem; /* Gap rapat & presisi */
    width: 100%;
    max-width: 100%;
    padding: 0 clamp(0.75rem, 2.5vw, 2.5rem);
    margin-top: 2rem;
  }

  /* Bento Card Styles */
  .bento-card {
    position: relative;
    border-radius: var(--radius-sm); /* Style tegas: corner radius kecil 4px */
    overflow: hidden;
    border: none;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .bento-card:hover {
    transform: translateY(-5px);
    box-shadow: 
      0 0 30px rgba(212, 179, 84, 0.4),
      0 0 60px rgba(130, 9, 7, 0.35);
    z-index: 5;
  }

  /* Bento Grid Spans (Ukuran Lebih Besar & Tinggi) */
  .bento-card-large {
    grid-column: span 2;
    grid-row: span 2;
    min-height: 620px;
  }

  .bento-card-wide {
    grid-column: span 2;
    min-height: 300px;
  }

  .bento-card-medium {
    grid-column: span 1;
    min-height: 300px;
  }

  /* Background Image */
  .bento-card-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover .bento-card-bg-img {
    transform: scale(1.05);
  }

  /* Dark Bottom Shadow Overlay Gradient */
  .bento-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 2.5vw, 2.25rem);
    background: linear-gradient(
      to top,
      rgba(28, 22, 20, 0.98) 0%,
      rgba(28, 22, 20, 0.85) 45%,
      rgba(28, 22, 20, 0.25) 75%,
      transparent 100%
    );
    z-index: 2;
  }

  .bento-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bento-card-large .bento-card-title {
    font-size: clamp(2.2rem, 3.5vw, 3.2rem);
  }

  .bento-card-title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    color: var(--color-gold);
    line-height: 1.1;
    letter-spacing: 0.05em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .bento-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.88rem, 1.1vw, 1.02rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.55;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
  }

  /* Responsive Adjustments */
  @media (max-width: 1100px) {
    .proker-bento-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .bento-card-large {
      grid-column: span 2;
      grid-row: span 1;
      min-height: 420px;
    }

    .bento-card-wide {
      grid-column: span 2;
      min-height: 270px;
    }

    .bento-card-medium {
      grid-column: span 1;
      min-height: 270px;
    }
  }

  @media (max-width: 640px) {
    .proker-bento-grid {
      grid-template-columns: 1fr;
      padding: 0 0.75rem;
      gap: 0.75rem;
    }

    .bento-card-large,
    .bento-card-wide,
    .bento-card-medium {
      grid-column: span 1;
      min-height: 320px;
    }
  }
</style>
