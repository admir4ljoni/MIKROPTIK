---
import DivisiLayout from "../../layouts/DivisiLayout.astro";
import DivisiHero from "../../components/DivisiHero.astro";
import DivisiProker from "../../components/DivisiProker.astro";
import DivisiFotoGaleri from "../../components/DivisiFotoGaleri.astro";
import DivisiSplitSection from "../../components/DivisiSplitSection.astro";
import SectionHeading from "../../components/SectionHeading.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const divisiData = {
  name: "HUMAS",
  badge: "DIVISI HUMAS",
  tagline: "Jalin Koneksi, Cipta Harmoni, High Quality",
  slug: "humas",
  bgImage: `${baseUrl}assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO BERSAMA.webp`,
  fotoKadiv: `${baseUrl}assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO KADIV.webp`,
  fotoStaffAhli: `${baseUrl}assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO STAFF AHLI.webp`,
  fotoStaffMuda: `${baseUrl}assets/Foto Kabinet/Foto Divisi/HUMAS/HUMAS STAFF MUDA.webp`,
  description:
    'Sebagai garda terdepan HMP MIKROPTIK, Divisi Humas berfokus membangun citra positif, memperkuat relasi, dan menjembatani komunikasi internal–eksternal pada Kabinet Naya Vikrama 2026. Misi branding dan diseminasi informasi ini direalisasikan secara komprehensif melalui program advokasi (Sambung Rasa, Real Action), ekspansi jaringan (Delegasi, Studi Banding), aksi kepedulian sosial (JPTK Berbagi, Mikroptik Social Action), hingga pemeliharaan ikatan alumni (Sambut Wisuda). Seluruh pergerakan ini dijiwai oleh satu semangat utama: "Jalin Koneksi, Cipta Harmoni, High Quality".',
  proker: [
    { title: "Mikroptik Social Action + Sarasehan", description: "Mikroptik Social Action (MSA) adalah program kerja internal untuk meningkatkan soliditas pengurus melalui kegiatan sosial yang berbasis kebersamaan." },
    { title: "JPTK Berbagi", description: "JPTK Berbagi adalah program kolaborasi Kampus V JPTK UNS untuk menekankan pentingnya memupuk kepedulian sosial dan keharmonisan mahasiswa JPTK." },
    { title: "Sambung Rasa", description: "Sambung Rasa adalah program kerja berbentuk forum yang diadakan untuk mempertemukan aspirasi dari tenaga pendidik (dosen) dan pelajar (mahasiswa)." },
    { title: "Studi Banding", description: "Pentingnya referensi komparatif dan evaluasi eksternal untuk peningkatan kualitas tata kelola organisasi HMP MIKROPTIK." },
    { title: "Sambut Wisuda", description: "Sambut Wisuda adalah bentuk perayaan momentum kelulusan mahasiswa PTIK sebagai penanda selesainya masa studi akademik." },
    { title: "Real Action", description: "Perlunya optimalisasi inklusivitas untuk meminimalisir kesenjangan interaksi antara pengurus dan mahasiswa umum." },
    { title: "Advokasi", description: "Advokasi mahasiswa merupakan upaya strategis untuk memperjuangkan hak dan kepentingan mahasiswa PTIK dalam lingkungan akademik maupun organisasional." },
    { title: "Delegasi", description: "Urgensi representasi organisasi dalam memenuhi undangan eksternal guna menjaga eksistensi HMP MIKROPTIK." },
    { title: "Media Partner", description: "Media Partner adalah upaya meningkatkan relasi eksternal dan citra HMP MIKROPTIK bagi khalayak umum." },
  ],
  galeri: [
    {
      title: "Foto Bersama Divisi HUMAS",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO BERSAMA.webp`,
      isFeatured: true,
    },
    {
      title: "Kadiv HUMAS",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO KADIV.webp`,
    },
    {
      title: "Staff Ahli HUMAS",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/HUMAS/FOTO STAFF AHLI.webp`,
    },
    {
      title: "Staff Muda HUMAS",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/HUMAS/HUMAS STAFF MUDA.webp`,
    },
  ],
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  divisiSlug={divisiData.slug}
  prevDivisi={{ name: "MIKAT", slug: "mikat" }}
  nextDivisi={{ name: "MEDINFO", slug: "medinfo" }}
>
  <!-- Hero Section (100vh) -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Garda terdepan pembangun relasi publik, aksi kepedulian sosial, advokasi mahasiswa, dan jejaring kerja sama eksternal."
    bgImage={divisiData.bgImage}
    bgPosition="center 58%"
  />

  <!-- Section 1: Deskripsi Profil paired with Foto Kadiv (50/50 Viewport Segment) -->
  <DivisiSplitSection
    imageSrc={divisiData.fotoKadiv}
    imageAlt="Kadiv HUMAS"
    reverse={false}
  >
    <SectionHeading
      titleMain="PROFIL"
      titleAccent="Divisi"
      subtitle="Peran dan fokus utama Divisi Humas dalam membangun reputasi & keharmonisan komunikasi"
      align="left"
    />
    <div class="brutalist-profile-box">
      <p class="brutalist-desc-text">{divisiData.description}</p>
    </div>
  </DivisiSplitSection>

  <!-- Section 2: Program Kerja paired with Foto Staff Ahli (50/50 Viewport Segment) -->
  <DivisiProker
    prokerList={divisiData.proker}
    imageSrc={divisiData.fotoStaffAhli}
    reverse={true}
  />

  <!-- Section 3: Galeri Dokumentasi paired with Foto Staff Muda (50/50 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri}
    imageSrc={divisiData.fotoStaffMuda}
    reverse={false}
  />
</DivisiLayout>
