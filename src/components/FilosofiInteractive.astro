---
const defaultPhilosophy = {
  id: 0,
  title: "Logo Kabinet Naya Vikrama 2026",
  description: "Logo Naya Vikrama menghadirkan makna tentang semangat baru, ketangguhan, dan keberanian dalam melangkah. Setiap elemen di dalamnya mencerminkan karakter HMP MIKROPTIK yang progresif, adaptif, dan selalu siap menghadapi tantangan."
};

const logoParts = [
  {
    id: 1,
    title: "Obor Api Kepemimpinan",
    image: "logo_kabinet_api.png",
    description: "Api yang menjulang ke atas mencerminkan semangat, keberanian, dan ketegasan dalam memimpin. Layaknya menyala yang tidak mudah padam, unsur ini menggambarkan kepemimpinan yang menjaga arah, memberikan inspirasi, serta berani mengambil keputusan dalam menghadapi setiap tantangan."
  },
  {
    id: 2,
    title: "Enam Sayap (Bidang & Divisi)",
    image: "logo_kabinet_sayap_1.png",
    description: "Enam sayap di kanan dan kiri melambangkan dua bidang empat divisi: Bidang Sekertaris Umum, Bidang Bendahara Umum, Divisi PSDM, Divisi Humas, Divisi Media, Divisi Mikat. Bahwa organisasi bergerak oleh kolaborasi bidang & divisi yang bekerja harmonis untuk mencapai tujuan bersama."
  },
  {
    id: 3,
    title: "Buku & Kebebasan Berpikir",
    image: "logo_kabinet_buku.png",
    description: "Buku-buku menjadi simbol bahwa setiap langkah dan kebebasan berfikir selalu berlandaskan pengetahuan, serta menegaskan peran organisasi sebagai rumah belajar bagi setiap anggotanya."
  },
  {
    id: 4,
    title: "Perisai Penopang Organisasi",
    image: "logo_kabinet_sayap_2.png",
    description: "Perisai penopang melambangkan fondasi yang kokoh yaitu nilai-nilai dasar, dukungan antar anggota, serta semangat kebersamaan yang menjadi akar dari setiap langkah. Bahwa organisasi mampu berdiri tegak dan melangkah maju karena memiliki penopang yang solid."
  }
];
---

<div class="filosofi-interactive-container" id="filosofi-interactive">
  <div class="filosofi-grid">
    <!-- SEBELAH KIRI: Interactive Logo Artwork with Precise SVG/CSS Hitspots -->
    <div class="filosofi-visual-left">
      <div class="logo-stack-box" id="logo-stack-box">
        <!-- Part 1: Api -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_api.png`}
          alt="Api Menjulang Ke Atas"
          class="logo-layer-img"
          data-part="1"
        />
        <!-- Part 2: Sayap 1 -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_sayap_1.png`}
          alt="Enam Sayap Kanan & Kiri"
          class="logo-layer-img"
          data-part="2"
        />
        <!-- Part 3: Buku -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_buku.png`}
          alt="Buku-buku Pengetahuan"
          class="logo-layer-img"
          data-part="3"
        />
        <!-- Part 4: Sayap 2 / Perisai -->
        <img
          src={`${import.meta.env.BASE_URL}assets/logo_kabinet_sayap_2.png`}
          alt="Perisai Penopang Organisasi"
          class="logo-layer-img"
          data-part="4"
        />

        <!-- Instant Hardware-Accelerated Hitspots -->
        <div class="logo-hotspot hotspot-api" data-hotspot="1" title="Obor Api Kepemimpinan"></div>
        <div class="logo-hotspot hotspot-sayap1" data-hotspot="2" title="Sayap Kanan & Divisi"></div>
        <div class="logo-hotspot hotspot-buku" data-hotspot="3" title="Buku Pengetahuan"></div>
        <div class="logo-hotspot hotspot-sayap2" data-hotspot="4" title="Sayap Kiri & Perisai"></div>
      </div>
    </div>

    <!-- SEBELAH KANAN: Dark Background Philosophy Card (Per DESIGN.md) -->
    <div class="filosofi-content-right">
      <!-- Default Philosophy Card -->
      <div class="filosofi-dark-card active" id="card-part-0" data-card="0">
        <h3 class="filosofi-card-title">{defaultPhilosophy.title}</h3>
        <p class="filosofi-card-desc">{defaultPhilosophy.description}</p>
      </div>

      <!-- Individual Part Philosophy Cards -->
      {logoParts.map((part) => (
        <div class="filosofi-dark-card" id={`card-part-${part.id}`} data-card={part.id}>
          <h3 class="filosofi-card-title">{part.title}</h3>
          <p class="filosofi-card-desc">{part.description}</p>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .filosofi-interactive-container {
    position: relative;
    width: 100%;
    margin-top: 1rem;
  }

  .filosofi-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3.5rem;
    align-items: center;
    width: 100%;
  }

  /* SEBELAH KIRI: Murni Logo Artwork */
  .filosofi-visual-left {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .logo-stack-box {
    position: relative;
    width: clamp(320px, 38vw, 480px);
    height: clamp(320px, 38vw, 480px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Layer Images Stacked Absolutely */
  .logo-layer-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    filter: grayscale(0%) opacity(1);
    transition: filter 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s ease;
    will-change: filter, transform, opacity;
  }

  /* Hotspot Hit Areas (100% Instant & Accurate Hover Detection) */
  .logo-hotspot {
    position: absolute;
    z-index: 50;
    cursor: pointer;
  }

  /* Hotspot 1: Obor Api (Top Center) */
  .hotspot-api {
    top: 2%;
    left: 30%;
    width: 40%;
    height: 44%;
    clip-path: polygon(50% 0%, 85% 30%, 75% 100%, 25% 100%, 15% 30%);
  }

  /* Hotspot 2: Sayap Kanan (Right Side) */
  .hotspot-sayap1 {
    top: 25%;
    left: 55%;
    width: 45%;
    height: 55%;
    clip-path: polygon(0% 15%, 85% 0%, 100% 70%, 25% 100%);
  }

  /* Hotspot 3: Buku (Center Lower) */
  .hotspot-buku {
    top: 48%;
    left: 30%;
    width: 40%;
    height: 32%;
    clip-path: polygon(20% 0%, 80% 0%, 100% 100%, 0% 100%);
  }

  /* Hotspot 4: Sayap Kiri / Perisai (Left Side) */
  .hotspot-sayap2 {
    top: 25%;
    left: 0%;
    width: 45%;
    height: 55%;
    clip-path: polygon(15% 0%, 100% 15%, 75% 100%, 0% 70%);
  }

  /* State Saat Salah Satu Part Di-hover/Di-click */
  .logo-stack-box.is-hovered .logo-layer-img {
    filter: grayscale(100%) opacity(0.25);
    transform: scale(0.98);
  }

  .logo-stack-box.is-hovered .logo-layer-img.active-part {
    filter: grayscale(0%) opacity(1) drop-shadow(0 0 50px rgba(212, 179, 84, 0.95));
    transform: scale(1.05);
    z-index: 30;
  }

  /* SEBELAH KANAN: Dark Background Card Panel (Sesuai DESIGN.md) */
  .filosofi-content-right {
    display: flex;
    flex-direction: column;
    position: relative;
    min-height: 320px;
    justify-content: center;
  }

  /* Card Display - Dark Theme Style (Per DESIGN.md: var(--color-dark)) */
  .filosofi-dark-card {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: 2.75rem 2.25rem;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    background: var(--color-dark); /* #1c1614 */
    border: 1.5px solid var(--color-gold); /* #d4b354 */
    box-shadow: 0 20px 50px rgba(130, 9, 7, 0.45);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filosofi-dark-card.active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .filosofi-card-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.2vw, 3rem);
    color: var(--color-gold); /* #d4b354 */
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .filosofi-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.15vw, 1.08rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .filosofi-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .filosofi-dark-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const stackBox = document.getElementById('logo-stack-box');
    const layerImgs = document.querySelectorAll('.logo-layer-img');
    const hotspots = document.querySelectorAll('.logo-hotspot');
    const cards = document.querySelectorAll('.filosofi-dark-card');

    if (!stackBox || layerImgs.length === 0) return;

    let activePartId = '0';

    function activatePart(partId: string) {
      if (activePartId === partId) return;
      activePartId = partId;

      if (partId === '0') {
        stackBox.classList.remove('is-hovered');
        layerImgs.forEach(img => img.classList.remove('active-part'));
      } else {
        stackBox.classList.add('is-hovered');
        layerImgs.forEach(img => {
          if (img.getAttribute('data-part') === partId) {
            img.classList.add('active-part');
          } else {
            img.classList.remove('active-part');
          }
        });
      }

      cards.forEach(card => {
        if (card.getAttribute('data-card') === partId) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }

    // Direct 100% Instant Hotspot Hover & Click Listeners
    hotspots.forEach(hotspot => {
      const partId = hotspot.getAttribute('data-hotspot') || '0';

      hotspot.addEventListener('mouseenter', () => {
        activatePart(partId);
      });

      hotspot.addEventListener('click', () => {
        activatePart(partId);
      });

      hotspot.addEventListener('touchstart', (e) => {
        activatePart(partId);
      }, { passive: true });
    });

    stackBox.addEventListener('mouseleave', () => {
      activatePart('0');
    });
  });
</script>
