---
import DivisiLayout from "../../layouts/DivisiLayout.astro";
import DivisiHero from "../../components/DivisiHero.astro";
import DivisiProker from "../../components/DivisiProker.astro";
import DivisiFotoGaleri from "../../components/DivisiFotoGaleri.astro";
import DivisiSplitSection from "../../components/DivisiSplitSection.astro";
import SectionHeading from "../../components/SectionHeading.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const divisiData = {
  name: "BENDAHARA UMUM",
  badge: "BIDANG BENDAHARA UMUM",
  tagline: "Transparansi, Akuntabilitas & Disiplin Keuangan",
  slug: "bendahara-umum",
  bgImage: `${baseUrl}assets/Foto Kabinet/Foto Divisi/BEGUM/FOTO BERSAMA.webp`,
  fotoKadiv: `${baseUrl}assets/Foto Kabinet/Foto Divisi/BEGUM/FOTO KABID.webp`,
  fotoStaff1: `${baseUrl}assets/Foto Kabinet/Foto Divisi/BEGUM/FOTO STAFF MUDA 1.webp`,
  fotoStaffMuda: `${baseUrl}assets/Foto Kabinet/Foto Divisi/BEGUM/FOTO STAFF MUDA 2.webp`,
  description:
    "Bendahara Umum adalah bidang yang bertanggung jawab dalam mengelola seluruh keuangan organisasi, seperti pemasukan, pengeluaran, dan pencatatan dana kegiatan. Tugas utamanya meliputi menyusun laporan keuangan, membuat anggaran kegiatan, menjaga transparansi serta akuntabilitas keuangan, dan memastikan setiap penggunaan dana sesuai dengan aturan serta kebutuhan organisasi.",
  proker: [
    "IWP (Iuran Wajib Pengurus)",
    "PENGADAAN INVENTARIS SEKRE",
    "DISIPLIN ADMINISTRASI KEUANGAN",
    "DANA USAHA",
    "MIKROPTIK STORE",
  ],
  galeri: [
    {
      title: "Foto Bersama Bidang BENDUM",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/BEGUM/FOTO BERSAMA.webp`,
      isFeatured: true,
    },
    {
      title: "Kabid Bendahara Umum",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/BEGUM/FOTO KABID.webp`,
    },
    {
      title: "Staff Muda Bendahara Umum 1",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/BEGUM/FOTO STAFF MUDA 1.webp`,
    },
    {
      title: "Staff Muda Bendahara Umum 2",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/BEGUM/FOTO STAFF MUDA 2.webp`,
    },
  ],
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  divisiSlug={divisiData.slug}
  prevDivisi={{ name: "SEKRETARIS UMUM", slug: "sekretaris-umum" }}
  nextDivisi={{ name: "PSDM", slug: "psdm" }}
>
  <!-- Hero Section (100vh) -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Penanggung jawab tata kelola, anggaran, pencatatan dana, serta akuntabilitas keuangan organisasi HMP MIKROPTIK."
    bgImage={divisiData.bgImage}
  />

  <!-- Section 1: Deskripsi Profil paired with Foto Kadiv (50/50 Viewport Segment) -->
  <DivisiSplitSection
    imageSrc={divisiData.fotoKadiv}
    imageAlt="Kabid Bendahara Umum"
    reverse={false}
  >
    <SectionHeading
      titleMain="PROFIL"
      titleAccent="Bidang"
      subtitle="Peran dan fokus utama Bendahara Umum dalam pengelolaan sirkulasi keuangan"
      align="left"
    />
    <div class="brutalist-profile-box">
      <p class="brutalist-desc-text">{divisiData.description}</p>
    </div>
  </DivisiSplitSection>

  <!-- Section 2: Program Kerja paired with Foto Staff 1 (50/50 Viewport Segment) -->
  <DivisiProker
    prokerList={divisiData.proker}
    imageSrc={divisiData.fotoStaff1}
    reverse={true}
  />

  <!-- Section 3: Galeri Dokumentasi paired with Foto Staff Muda (50/50 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri}
    imageSrc={divisiData.fotoStaffMuda}
    reverse={false}
  />
</DivisiLayout>
