---
interface Props {
  title: string;
  badge?: string;
  tagline?: string;
  description: string;
  bgImage: string;
  bgPosition?: string;
  brightness?: number;
}

const { 
  title, 
  tagline, 
  description, 
  bgImage, 
  bgPosition = "center 60%",
  brightness = 0.95 
} = Astro.props;
---

<section class="divisi-hero-section">
  <!-- Background Image with Parallax & Custom Brightness -->
  <div 
    class="divisi-hero-bg" 
    style={`background-image: url('${bgImage}'); background-position: ${bgPosition}; filter: brightness(${brightness}) contrast(1.08);`}
  ></div>

  <!-- Dark Gradient Overlay -->
  <div class="divisi-hero-overlay"></div>

  <!-- Hero Content Box -->
  <div class="divisi-hero-content">
    <h1 class="divisi-hero-title">{title}</h1>
    {tagline && <p class="divisi-hero-tagline">{tagline}</p>}
    <p class="divisi-hero-desc">{description}</p>
  </div>
</section>
