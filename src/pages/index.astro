---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatCounter from "../components/StatCounter.astro";
import ProgramCard from "../components/ProgramCard.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import FilosofiInteractive from "../components/FilosofiInteractive.astro";
import ProkerBento from "../components/ProkerBento.astro";
import PrestasiGrid from "../components/PrestasiGrid.astro";
import KalenderEvent from "../components/KalenderEvent.astro";
---

<BaseLayout title="MIKROPTIK | Kabinet Naya Vikrama - HMP PTIK FKIP UNS">
  <!-- =========================================================================
       SECTION 2: HERO SECTION (100vh) - CENTERED & ARTISTIC
       ========================================================================= -->
  <section id="hero" class="hero-section">
    <div class="hero-bg-overlay"></div>

    <!-- Logo Background (Di belakang Teks Utama) -->
    <div class="hero-bg-logo-wrapper">
      <img
        src={`${import.meta.env.BASE_URL}assets/logo_kabinet_full.svg`}
        alt="Logo Kabinet Naya Vikrama"
        class="hero-bg-logo"
      />
    </div>

    <!-- 2 Decorative Blur Floating Logos -->
    <div class="hero-floating-logo hero-floating-left">
      <img
        src={`${import.meta.env.BASE_URL}assets/logo_kabinet_blur.svg`}
        alt="Logo Kabinet Blur Left"
      />
    </div>
    <div class="hero-floating-logo hero-floating-right">
      <img
        src={`${import.meta.env.BASE_URL}assets/logo_kabinet_blur.svg`}
        alt="Logo Kabinet Blur Right"
      />
    </div>

    <!-- Teks Utama (Di depan Logo) -->
    <div class="hero-centered-container">
      <div class="hero-text-content">
        <h1 class="hero-title-main">
          HIMPUNAN <br />
          <span
            class="text-accent-highlight"
            style="font-size: 0.7em; color: var(--color-gold); display: block;"
            >Mahasiswa</span
          >
          PTIK UNS
        </h1>
        <p class="hero-subtitle">
          Pendidikan Teknik Informatika dan Komputer <br />
          Fakultas Keguruan dan Ilmu Pendidikan, Universitas Sebelas Maret
        </p>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: ABOUT / TENTANG KAMI (SLICED BENTO MOSAIC GRID)
       ========================================================================= -->
  <!-- =========================================================================
       SECTION 3: ABOUT / TENTANG KAMI (EXPANDING VERTICAL SLICED ACCORDION)
       ========================================================================= -->
  <section id="about" class="section about-accordion-section">
    <div class="container">
      <SectionHeading
        titleMain="TENTANG"
        titleAccent="Kami"
        subtitle="Geser kursor atau sentuh bilah di bawah untuk mengeksplorasi profil, pengurus, proker, dan prestasi MIKROPTIK"
      />

      <div class="sliced-accordion-container" id="about-accordion">
        <!-- Stripe 1: SEKUM (Sekretaris Umum) -->
        <div class="sliced-stripe stripe-1">
          <div class="stripe-img-wrapper">
            <img
              src={`${import.meta.env.BASE_URL}assets/Foto Kabinet/Foto Divisi/Foto Kabinet Naya Vikrama.JPG`}
              alt="Foto Kabinet Naya Vikrama"
              class="stripe-shared-img"
            />
          </div>
          <div class="stripe-collapsed-label">SEKUM</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <h3 class="stripe-title">BIDANG SEKRETARIS UMUM</h3>
              <p class="stripe-description">
                Sekretaris Umum (SEKUM) HMP MIKROPTIK FKIP UNS merupakan bidang
                yang bertugas dalam mengelola, menyelesaikan, dan mengarsipkan
                seluruh sistem administrasi serta operasional organisasi. Dengan
                tagline "Selalu Siap, Selalu Ada", bidang ini berperan sebagai
                penopang kelancaran dan stabilitas internal HMP MIKROPTIK
                melalui pengelolaan kearsipan, pemeliharaan ruang sekretariat,
                penyusunan timeline kerja, hingga penyediaan serta penyaluran
                pusat informasi bagi seluruh pengurus.
              </p>
              <a
                href={`${import.meta.env.BASE_URL}divisi/sekretaris-umum`}
                class="stripe-link-btn"
              >
                Lihat Detail Divisi →
              </a>
            </div>
          </div>
        </div>

        <!-- Stripe 2: BENDUM (Bendahara Umum) -->
        <div class="sliced-stripe stripe-2">
          <div class="stripe-img-wrapper">
            <img
              src={`${import.meta.env.BASE_URL}assets/Foto Kabinet/Foto Divisi/Foto Kabinet Naya Vikrama.JPG`}
              alt="Foto Kabinet Naya Vikrama"
              class="stripe-shared-img"
            />
          </div>
          <div class="stripe-collapsed-label">BENDUM</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <h3 class="stripe-title">BIDANG BENDAHARA UMUM</h3>
              <p class="stripe-description">
                Bendahara Umum adalah bidang yang bertanggung jawab dalam
                mengelola seluruh keuangan organisasi, seperti pemasukan,
                pengeluaran, dan pencatatan dana kegiatan. Tugas utamanya
                meliputi menyusun laporan keuangan, membuat anggaran kegiatan,
                menjaga transparansi serta akuntabilitas keuangan, dan
                memastikan setiap penggunaan dana sesuai dengan aturan serta
                kebutuhan organisasi.
              </p>
              <a
                href={`${import.meta.env.BASE_URL}divisi/bendahara-umum`}
                class="stripe-link-btn"
              >
                Lihat Detail Divisi →
              </a>
            </div>
          </div>
        </div>

        <!-- Stripe 3: PSDM -->
        <div class="sliced-stripe stripe-3">
          <div class="stripe-img-wrapper">
            <img
              src={`${import.meta.env.BASE_URL}assets/Foto Kabinet/Foto Divisi/Foto Kabinet Naya Vikrama.JPG`}
              alt="Foto Kabinet Naya Vikrama"
              class="stripe-shared-img"
            />
          </div>
          <div class="stripe-collapsed-label">PSDM</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <h3 class="stripe-title">
                DIVISI PENGEMBANGAN SUMBER DAYA MAHASISWA
              </h3>
              <p class="stripe-description">
                Divisi Pengembangan Sumber Daya Mahasiswa (PSDM) HMP MIKROPTIK
                Kabinet Naya Vikrama merupakan divisi yang berfokus pada
                pengembangan potensi, kompetensi, dan karakter mahasiswa PTIK.
                PSDM berperan sebagai wadah sekaligus fasilitator bagi mahasiswa
                baru dalam beradaptasi dengan lingkungan perkuliahan,
                mengembangkan diri, serta membangun relasi di lingkungan kampus.
                Melalui berbagai program kerja, seperti Open Recruitment, PSDM
                juga membuka kesempatan bagi mahasiswa untuk bergabung,
                berkontribusi, dan bertumbuh bersama dalam organisasi.
              </p>
              <a
                href={`${import.meta.env.BASE_URL}divisi/psdm`}
                class="stripe-link-btn"
              >
                Lihat Detail Divisi →
              </a>
            </div>
          </div>
        </div>

        <!-- Stripe 4: MIKAT -->
        <div class="sliced-stripe stripe-4">
          <div class="stripe-img-wrapper">
            <img
              src={`${import.meta.env.BASE_URL}assets/Foto Kabinet/Foto Divisi/Foto Kabinet Naya Vikrama.JPG`}
              alt="Foto Kabinet Naya Vikrama"
              class="stripe-shared-img"
            />
          </div>
          <div class="stripe-collapsed-label">MIKAT</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <h3 class="stripe-title">DIVISI MINTA DAN BAKAT</h3>
              <p class="stripe-description">
                Divisi Minat dan Bakat (MIKAT) HMP MIKROPTIK FKIP UNS merupakan
                divisi yang bertugas dalam pengembangan potensi, bakat, dan
                minat mahasiswa baik di bidang akademik maupun non-akademik.
                Divisi ini menjadi wadah bagi mahasiswa untuk menyalurkan
                minatnya dalam kegiatan olahraga, seni, keilmuan, hingga
                pengembangan diri, serta turut membangun lingkungan PTIK yang
                sehat dan produktif.
              </p>
              <a
                href={`${import.meta.env.BASE_URL}divisi/mikat`}
                class="stripe-link-btn"
              >
                Lihat Detail Divisi →
              </a>
            </div>
          </div>
        </div>

        <!-- Stripe 5: HUMAS -->
        <div class="sliced-stripe stripe-5">
          <div class="stripe-img-wrapper">
            <img
              src={`${import.meta.env.BASE_URL}assets/Foto Kabinet/Foto Divisi/Foto Kabinet Naya Vikrama.JPG`}
              alt="Foto Kabinet Naya Vikrama"
              class="stripe-shared-img"
            />
          </div>
          <div class="stripe-collapsed-label">HUMAS</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <h3 class="stripe-title">DIVISI HUBUNGAN MASYARAKAT</h3>
              <p class="stripe-description">
                Sebagai garda terdepan HMP MIKROPTIK, Divisi Humas berfokus
                membangun citra positif, memperkuat relasi, dan menjembatani
                komunikasi internal–eksternal pada Kabinet Naya Vikrama 2026.
                Misi branding dan diseminasi informasi ini direalisasikan secara
                komprehensif melalui program advokasi (Sambung Rasa, Real
                Action), ekspansi jaringan (Delegasi, Studi Banding), aksi
                kepedulian sosial (JPTK Berbagi, Mikroptik Social Action),
                hingga pemeliharaan ikatan alumni (Sambut Wisuda). Seluruh
                pergerakan ini dijiwai oleh satu semangat utama: "Jalin Koneksi,
                Cipta Harmoni, High Quality".
              </p>
              <a
                href={`${import.meta.env.BASE_URL}divisi/humas`}
                class="stripe-link-btn"
              >
                Lihat Detail Divisi →
              </a>
            </div>
          </div>
        </div>

        <!-- Stripe 6: MEDINFO -->
        <div class="sliced-stripe stripe-6">
          <div class="stripe-img-wrapper">
            <img
              src={`${import.meta.env.BASE_URL}assets/Foto Kabinet/Foto Divisi/Foto Kabinet Naya Vikrama.JPG`}
              alt="Foto Kabinet Naya Vikrama"
              class="stripe-shared-img"
            />
          </div>
          <div class="stripe-collapsed-label">MEDINFO</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <h3 class="stripe-title">DIVISI MEDIA INFORMASI</h3>
              <p class="stripe-description">
                Divisi Medinfo HMP MIKROPTIK adalah divisi yang bertanggung
                jawab dalam pengelolaan media informasi dan dokumentasi HMP
                MIKROPTIK. Program kerjanya meliputi Pengelolaan Media Sosial,
                dokumentasi kegiatan, PDD (Publikasi, Dokumentasi, dan Desain),
                Podcast sebagai media informasi dan edukasi. Divisi ini juga
                menjadi wadah bagi mahasiswa untuk mengembangkan kemampuan di
                bidang desain grafis, fotografi, dan videografi. Bergabung di
                Divisi Medinfo HMP MIKROPTIK memberikan kesempatan untuk
                meningkatkan kreativitas, mengasah keterampilan, dan memperoleh
                pengalaman baru.
              </p>
              <a
                href={`${import.meta.env.BASE_URL}divisi/medinfo`}
                class="stripe-link-btn"
              >
                Lihat Detail Divisi →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const container = document.getElementById("about-accordion");
      if (!container) return;

      const stripes = container.querySelectorAll(".sliced-stripe");
      let animFrameId = null;

      function updateImgOffsets() {
        const containerRect = container.getBoundingClientRect();
        const containerWidth = containerRect.width;

        stripes.forEach((stripe) => {
          const img = stripe.querySelector(".stripe-shared-img");
          if (img) {
            const stripeLeft =
              stripe.getBoundingClientRect().left - containerRect.left;
            img.style.width = `${containerWidth}px`;
            img.style.left = `${-stripeLeft}px`;
          }
        });
      }

      function startSyncLoop(durationMs = 750) {
        const startTime = performance.now();
        if (animFrameId) cancelAnimationFrame(animFrameId);

        function loop(now) {
          updateImgOffsets();
          if (now - startTime < durationMs) {
            animFrameId = requestAnimationFrame(loop);
          } else {
            updateImgOffsets();
          }
        }
        animFrameId = requestAnimationFrame(loop);
      }

      // Inisialisasi awal & listener window resize
      updateImgOffsets();
      window.addEventListener("resize", updateImgOffsets);

      // Sinkronisasi 60fps saat terjadi ekspansi hover / active click
      stripes.forEach((stripe) => {
        stripe.addEventListener("mouseenter", () => startSyncLoop(750));
        stripe.addEventListener("mouseleave", () => startSyncLoop(750));
        stripe.addEventListener("click", () => {
          stripes.forEach((s) => s.classList.remove("active"));
          stripe.classList.add("active");
          startSyncLoop(750);
        });
      });
    });
  </script>

  <!-- =========================================================================
       SECTION 4: FILOSOFI LOGO KABINET (CAROUSEL)
       ========================================================================= -->
  <section id="filosofi" class="section bg-dark">
    <div class="container">
      <SectionHeading
        titleMain="FILOSOFI LOGO"
        titleAccent="Naya Vikrama"
        subtitle="Arahkan kursor atau sentuh bagian logo di bawah untuk mengeksplorasi makna setiap elemen lambang Kabinet Naya Vikrama"
      />

      <FilosofiInteractive />
    </div>
  </section>

  <!-- =========================================================================
       SECTION 5: VISI & MISI
       ========================================================================= -->
  <!-- =========================================================================
       SECTION 5: VISI & MISI
       ========================================================================= -->
  <section id="visi-misi" class="section bg-dark">
    <div class="container">
      <SectionHeading
        titleMain="VISI & MISI"
        titleAccent="Organisasi"
        subtitle="Arah gerak dan fondasi kepengurusan MIKROPTIK Kabinet Naya Vikrama"
      />

      <div class="visi-box">
        <span
          class="text-gold font-heading"
          style="font-size: 1.4rem; letter-spacing: 0.12em;"
          >VISI UTAMA 2026</span
        >
        <h3
          class="text-white"
          style="font-size: clamp(1.35rem, 2.1vw, 1.95rem); margin: 0.75rem 0; line-height: 1.55; font-weight: 500;"
        >
          “Mewujudkan HMP MIKROPTIK yang solid, berkarakter, dan berdaya saing
          sebagai ruang pengembangan mahasiswa PTIK serta sebagai himpunan yang
          aktif berkolaborasi dan memberi kontribusi di lingkungan eksternal.”
        </h3>
      </div>

      <div class="misi-grid">
        <div class="misi-card">
          <h4
            class="text-gold font-heading"
            style="font-size: 1.35rem; margin-bottom: 0.6rem; letter-spacing: 0.05em;"
          >
            01. KULTUR ORGANISASI
          </h4>
          <p
            style="font-size: 0.95rem; color: rgba(255,255,255,0.88); line-height: 1.6;"
          >
            Menguatkan kultur organisasi yang solid, terbuka, dan akuntabel
            sebagai ruang aspirasi mahasiswa PTIK.
          </p>
        </div>

        <div class="misi-card">
          <h4
