---
import DivisiLayout from "../../layouts/DivisiLayout.astro";
import DivisiHero from "../../components/DivisiHero.astro";
import DivisiProker from "../../components/DivisiProker.astro";
import DivisiFotoGaleri from "../../components/DivisiFotoGaleri.astro";
import DivisiSplitSection from "../../components/DivisiSplitSection.astro";
import SectionHeading from "../../components/SectionHeading.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const divisiData = {
  name: "MIKAT",
  badge: "DIVISI MIKAT",
  tagline: "Pengembangan Minat, Bakat & Prestasi Mahasiswa",
  slug: "mikat",
  bgImage: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO BERSAMA.webp`,
  fotoKadiv: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO KADIV.webp`,
  fotoStaffAhli: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO STAFF AHLI.webp`,
  fotoStaffMuda1: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO STAFF MUDA 1.webp`,
  fotoStaffMuda2: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO STAFF MUDA 2.webp`,
  description:
    "Divisi Minat dan Bakat (MIKAT) HMP MIKROPTIK FKIP UNS merupakan divisi yang bertugas dalam pengembangan potensi, bakat, dan minat mahasiswa baik di bidang akademik maupun non-akademik. Divisi ini menjadi wadah bagi mahasiswa untuk menyalurkan minatnya dalam kegiatan olahraga, seni, keilmuan, hingga pengembangan diri, serta turut membangun lingkungan PTIK yang sehat dan produktif.",
  proker: [
    { title: "SEBAT (Sehat Bersama PTIK)", description: "Sehat Bersama Mikat (SEBAT) adalah upaya meningkatkan soliditas dan menjaga keharmonisan Mahasiswa PTIK dalam bentuk kegiatan olahraga." },
    { title: "JPTK CUP", description: "JPTK Cup adalah program kompetisi olahraga untuk meningkatkan keharmonisan dan membentuk relasi yang berarti untuk Mahasiswa Kampus V JPTK UNS." },
    { title: "FESTIVAL MIKAT", description: "Festival MIKAT adalah serangkaian lomba di lingkup Mahasiswa PTIK untuk mewadahi dan menggali minat dan bakat." },
    { title: "SEMINAR PKM", description: "Seminar PKM adalah bentuk fasilitas yang disediakan Divisi MIKAT untuk memaparkan informasi Program Kreativitas Mahasiswa (PKM)." },
    { title: "STUDY CLUB", description: "Studi Club berfungsi sebagai sarana kolaborasi, belajar bersama, dan berbagi ilmu untuk mendukung keterampilan dan pengetahuan mahasiswa." },
    { title: "PENDATAAN PRESTASI MAHASISWA", description: "Pendataan Prestasi Mahasiswa bertujuan untuk mendokumentasikan prestasi-prestasi yang diraih Mahasiswa PTIK." },
    { title: "PENDATAAN MIKAT MAHASISWA", description: "Pendataan Mikat Mahasiswa adalah pusat wadah aspirasi untuk mendukung minat dan bakat mahasiswa." },
  ],
  galeri: [
    {
      title: "Foto Bersama Divisi MIKAT",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO BERSAMA.webp`,
      isFeatured: true,
    },
    {
      title: "Kadiv MIKAT",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO KADIV.webp`,
    },
    {
      title: "Staff Ahli MIKAT",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO STAFF AHLI.webp`,
    },
    {
      title: "Staff Muda MIKAT 1",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO STAFF MUDA 1.webp`,
    },
    {
      title: "Staff Muda MIKAT 2",
      src: `${baseUrl}assets/Foto Kabinet/Foto Divisi/MIKAT/FOTO STAFF MUDA 2.webp`,
    },
  ],
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  divisiSlug={divisiData.slug}
  prevDivisi={{ name: "PSDM", slug: "psdm" }}
  nextDivisi={{ name: "HUMAS", slug: "humas" }}
>
  <!-- Hero Section (100vh) -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Wadah penyaluran bakat olahraga, seni, kompetisi akademik, PKM, dan pengembangan minat mahasiswa PTIK."
    bgImage={divisiData.bgImage}
    bgPosition="center 58%"
    brightness={0.72}
  />

  <!-- Section 1: Deskripsi Profil paired with Foto Kadiv (60/40 Viewport Segment) -->
  <DivisiSplitSection
    imageSrc={divisiData.fotoKadiv}
    imageAlt="Kadiv MIKAT"
    reverse={false}
  >
    <SectionHeading
      titleMain="PROFIL"
      titleAccent="Divisi"
      subtitle="Peran dan fokus utama Divisi MIKAT dalam memfasilitasi potensi & karya mahasiswa"
      align="left"
    />
    <div class="brutalist-profile-box">
      <p class="brutalist-desc-text">{divisiData.description}</p>
    </div>
  </DivisiSplitSection>

  <!-- Section 2: Program Kerja paired with Foto Staff Ahli (60/40 Viewport Segment) -->
  <DivisiProker
    prokerList={divisiData.proker}
    imageSrc={divisiData.fotoStaffAhli}
    reverse={true}
  />

  <!-- Section 3: Galeri Dokumentasi 1 paired with Foto Staff Muda 1 (60/40 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri.slice(0, 3)}
    imageSrc={divisiData.fotoStaffMuda1}
    reverse={false}
  />

  <!-- Section 4: Galeri Dokumentasi 2 paired with Foto Staff Muda 2 (60/40 Viewport Segment) -->
  <DivisiFotoGaleri
    fotoList={divisiData.galeri.slice(2)}
    imageSrc={divisiData.fotoStaffMuda2}
    reverse={true}
  />
</DivisiLayout>
