---

<div class="custom-calendar-section-wrapper" id="custom-calendar-root">
  <div class="custom-calendar-container">
    <!-- SEBELAH KIRI: Monthly Calendar Grid (Fixed Height 520px) -->
    <div class="calendar-grid-box">
      <!-- Calendar Header: Month Title & Navigation -->
      <div class="calendar-box-header">
        <div class="calendar-month-title">
          <span class="month-name-text" id="month-name-text">August</span>
          <span class="year-gold-text" id="year-text">2026</span>
        </div>

        <div class="calendar-nav-buttons">
          <button class="cal-nav-btn" id="prev-month-btn" aria-label="Bulan Sebelumnya">
            <ChevronLeft size={18} />
          </button>
          <button class="cal-nav-btn" id="next-month-btn" aria-label="Bulan Berikutnya">
            <ChevronRight size={18} />
          </button>
        </div>
      </div>

      <!-- Days of Week Header -->
      <div class="calendar-weekdays-row">
        <span>SUN</span>
        <span>MON</span>
        <span>TUE</span>
        <span>WED</span>
        <span>THU</span>
        <span>FRI</span>
        <span>SAT</span>
      </div>

      <!-- Fixed 6-Row Grid Cells (42 Cells Total) -->
      <div class="calendar-days-grid" id="calendar-days-grid">
        <!-- Injected via JavaScript -->
      </div>
    </div>

    <!-- SEBELAH KANAN: Agenda Stream Panel (Dynamic Monthly Event List) -->
    <div class="calendar-right-panel" id="calendar-right-panel">
      <div class="agenda-stream-header">
        <h3 class="agenda-stream-title" id="agenda-stream-title">Agenda Bulan Agustus 2026</h3>
        <span class="agenda-count-badge" id="agenda-count-badge">2 Kegiatan Terjadwal</span>
      </div>

      <div class="agenda-cards-list" id="agenda-cards-list">
        <!-- Dynamic Event Cards Injected via JS -->
      </div>
    </div>
  </div>
</div>

<style>
  .custom-calendar-section-wrapper {
    position: relative;
    width: 100%;
    margin-top: 1.5rem;
  }

  .custom-calendar-container {
    display: grid;
    grid-template-columns: 1.2fr 1.35fr;
    gap: 2rem;
    align-items: stretch;
    width: 100%;
  }

  /* SEBELAH KIRI: Fixed Height Calendar Box (520px) */
  .calendar-grid-box {
    background: #18090f;
    border: 1.5px solid rgba(212, 179, 84, 0.3);
    border-radius: var(--radius-sm); /* Style tegas 4px */
    padding: 2rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 520px; /* TINGGI FIX (TIDAK BERUBAH-UBAH) */
    box-sizing: border-box;
  }

  .calendar-box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .calendar-month-title {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .month-name-text {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw, 2.5rem);
    color: #ffffff;
    letter-spacing: 0.04em;
  }

  .year-gold-text {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.8rem, 2.8vw, 2.3rem);
    color: var(--color-gold); /* WARNA KUNING EMAS SUESUAI DESIGN.md */
    letter-spacing: 0.04em;
  }

  .calendar-nav-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .cal-nav-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cal-nav-btn:hover {
    background: #820907;
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  /* Weekdays Header */
  .calendar-weekdays-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.1em;
  }

  /* Fixed 6-Row Days Grid (42 Cells Total) */
  .calendar-days-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    grid-template-rows: repeat(6, 1fr); /* 6 FIX ROWS */
    gap: 0.45rem;
    flex-grow: 1;
  }

  .cal-day-cell {
    position: relative;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.45rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    cursor: default;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }

  .cal-day-cell.empty {
    background: transparent;
    border: none;
    pointer-events: none;
  }

  .cal-day-cell.has-event {
    background: linear-gradient(135deg, rgba(130, 9, 7, 0.75) 0%, rgba(28, 22, 20, 0.9) 100%);
    border: 1.5px solid var(--color-gold);
    color: var(--color-gold);
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(130, 9, 7, 0.5);
  }

  .cal-day-cell.has-event:hover,
  .cal-day-cell.has-event.selected {
    background: #820907;
    border-color: #ffffff;
    color: #ffffff;
    box-shadow: 0 0 20px rgba(212, 179, 84, 0.8);
    transform: scale(1.08);
    z-index: 10;
  }

  .event-dot-indicator {
    position: absolute;
    bottom: 5px;
    right: 5px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 8px var(--color-gold);
  }

  /* SEBELAH KANAN: Agenda Stream Panel */
  .calendar-right-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: 520px; /* MATCHES FIXED CALENDAR HEIGHT */
    background: #18090f;
    border: 1.5px solid rgba(212, 179, 84, 0.3);
    border-radius: var(--radius-sm);
    padding: 2rem;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.55);
    box-sizing: border-box;
  }

  .agenda-stream-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1.5px solid rgba(212, 179, 84, 0.3);
  }

  .agenda-stream-title {
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    color: var(--color-gold);
    letter-spacing: 0.04em;
  }

  .agenda-count-badge {
    background: rgba(130, 9, 7, 0.85);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 179, 84, 0.4);
    white-space: nowrap;
  }

  .agenda-cards-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
    flex-grow: 1;
    padding-right: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-gold) rgba(255, 255, 255, 0.05);
  }

  /* No Events Card State */
  .no-events-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    padding: 3rem 1.5rem;
    margin: auto 0;
  }

  .no-events-icon {
    font-size: 2.8rem;
    opacity: 0.7;
  }

  .no-events-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    color: #ffffff;
    letter-spacing: 0.03em;
  }

  .no-events-desc {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
    max-width: 320px;
  }

  /* Event Agenda Card */
  .event-agenda-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(212, 179, 84, 0.25);
    transition: all 0.3s ease;
  }

  .event-agenda-card:hover,
  .event-agenda-card.highlighted {
    background: rgba(130, 9, 7, 0.65);
    border-color: var(--color-gold);
    box-shadow: 0 8px 25px rgba(130, 9, 7, 0.4);
    transform: translateX(4px);
  }

  .event-card-left {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .event-category-badge {
    background: linear-gradient(135deg, #d4b354 0%, #820907 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }

  .event-date-text {
    font-family: var(--font-heading);
    font-size: 0.86rem;
    color: var(--color-gold);
  }

  .event-card-main {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .event-div-tag {
    font-family: var(--font-heading);
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-white);
    line-height: 1.2;
  }

  .event-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.5;
  }

  .event-location-text {
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .custom-calendar-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .calendar-grid-box,
    .calendar-right-panel {
      height: auto;
      min-height: 500px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const monthNameText = document.getElementById('month-name-text');
    const yearText = document.getElementById('year-text');
    const prevBtn = document.getElementById('prev-month-btn');
    const nextBtn = document.getElementById('next-month-btn');
    const daysGrid = document.getElementById('calendar-days-grid');

    const streamTitle = document.getElementById('agenda-stream-title');
    const countBadge = document.getElementById('agenda-count-badge');
    const agendaCardsList = document.getElementById('agenda-cards-list');

    const monthNames = [
      "January", "February", "March", "April", "May", "June",
      "July", "August", "September", "October", "November", "December"
    ];

    const monthNamesIndo = [
      "Januari", "Februari", "Maret", "April", "Mei", "Juni",
      "Juli", "Agustus", "September", "Oktober", "November", "Desember"
    ];

    // Events Lookup Dictionary
    const eventsData: { [key: string]: Array<{ id: number; title: string; category: string; division: string; dateStr: string; location: string; desc: string; dateKey: string }> } = {
      "2026-02-10": [{ id: 1, dateKey: "2026-02-10", title: "Rapat Kerja (Raker) 2026", category: "Wajib", division: "Sekretaris & Bendahara", dateStr: "10 Februari 2026", location: "Aula FKIP UNS", desc: "Penetapan dan sosialisasi seluruh arah gerak serta program kerja HMP MIKROPTIK 2026." }],
      "2026-02-15": [{ id: 2, dateKey: "2026-02-15", title: "Open Recruitment Pengurus", category: "Kaderisasi", division: "Divisi PSDM", dateStr: "15 Februari 2026", location: "Kampus PTIK UNS", desc: "Perekrutan pengurus muda HMP MIKROPTIK Kabinet Naya Vikrama." }],
      "2026-03-05": [{ id: 3, dateKey: "2026-03-05", title: "Pelatihan Sekben", category: "Internal", division: "Sekretaris & Bendahara", dateStr: "5 Maret 2026", location: "Lab Komputer PTIK", desc: "Pelatihan administrasi dan tata kelola keuangan organisasi." }],
      "2026-03-12": [{ id: 4, dateKey: "2026-03-12", title: "Upgrading Pengurus", category: "Internal", division: "Kahim & Wakahim", dateStr: "12 Maret 2026", location: "Ruang Ormawa PTIK", desc: "Peningkatan kapabilitas dan soliditas pengurus HMP MIKROPTIK 2026." }],
      "2026-03-24": [{ id: 5, dateKey: "2026-03-24", title: "Mikroptik Social Action (MSA)", category: "Aksi Sosial", division: "Divisi Humas", dateStr: "24 Maret 2026", location: "Surakarta", desc: "Aksi berbagi takjil dan pengabdian masyarakat di bulan suci Ramadhan." }],
      "2026-04-18": [{ id: 6, dateKey: "2026-04-18", title: "Mikroptik Store Launch", category: "Dana Usaha", division: "Bendahara Umum", dateStr: "18 April 2026", location: "Online & Sekre", desc: "Peluncuran merchandise dan produk resmi HMP MIKROPTIK." }],
      "2026-04-20": [{ id: 7, dateKey: "2026-04-20", title: "Podcast Mikroptik Ep.1", category: "Media", division: "Divisi Medinfo", dateStr: "20 April 2026", location: "Studio Podcast & YouTube", desc: "Bincang santai seputar dunia perkuliahan IT dan pengalaman alumni." }],
      "2026-05-16": [{ id: 8, dateKey: "2026-05-16", title: "Studi Banding Himpunan", category: "Eksternal", division: "Divisi Humas", dateStr: "16 Mei 2026", location: "Universitas Mitra", desc: "Pertukaran wawasan dan studi budaya organisasi dengan HMP kampus lain." }],
      "2026-06-05": [{ id: 9, dateKey: "2026-06-05", title: "JPTK CUP 2026", category: "Olahraga & Seni", division: "Divisi Mikat", dateStr: "5 Juni 2026", location: "Sport Center UNS", desc: "Pekan olahraga, E-Sports, dan seni antar angkatan civitas akademika PTIK." }],
      "2026-06-10": [{ id: 10, dateKey: "2026-06-10", title: "JPTK Berbagi & Sambung Rasa", category: "Advokasi", division: "Divisi Humas", dateStr: "10 Juni 2026", location: "Ruang Diskusi PTIK", desc: "Ruang aspirasi mahasiswa dan sarasehan bersama pengelola prodi PTIK." }],
      "2026-08-18": [{ id: 11, dateKey: "2026-08-18", title: "SAMARU & OSMARU 2026", category: "Kaderisasi", division: "Divisi PSDM", dateStr: "18 Agustus 2026", location: "Kampus UNS", desc: "Penyambutan dan pengenalan kampus bagi mahasiswa baru prodi PTIK." }],
      "2026-08-29": [{ id: 12, dateKey: "2026-08-29", title: "Sambut Wisuda PTIK", category: "Apresiasi", division: "Divisi Humas", dateStr: "29 Agustus 2026", location: "Gedung FKIP UNS", desc: "Apresiasi dan pelepasan wisudawan/wisudawati prodi PTIK UNS." }],
      "2026-09-15": [{ id: 13, dateKey: "2026-09-15", title: "BYTESFEST 2026", category: "Big Event", division: "Kahim & Wakahim", dateStr: "15 September 2026", location: "Gedung UNS & Online", desc: "Festival IT dan kompetisi berskala nasional bagi pelajar & mahasiswa se-Indonesia." }],
      "2026-10-10": [{ id: 14, dateKey: "2026-10-10", title: "LDKM Naya Vikrama", category: "Kaderisasi", division: "Divisi PSDM", dateStr: "10 Oktober 2026", location: "Outbound Camp", desc: "Latihan Dasar Kepemimpinan Mahasiswa untuk membentuk kepemimpinan progresif." }],
      "2026-11-07": [{ id: 15, dateKey: "2026-11-07", title: "PSDM Adventure", category: "Internal", division: "Divisi PSDM", dateStr: "7 November 2026", location: "Tawangmangu", desc: "Kegiatan keakraban dan penguatan karakter antar pengurus." }],
      "2026-11-20": [{ id: 16, dateKey: "2026-11-20", title: "Festival MIKAT & Seminar PKM", category: "Akademik & Seni", division: "Divisi Mikat", dateStr: "20 November 2026", location: "Aula UNS", desc: "Pameran bakat, seminar Program Kreativitas Mahasiswa, dan apresiasi prestasi." }]
    };

    let currentYear = 2026;
    let currentMonthIdx = 7; // August (0-indexed: 7 = August)

    function renderCalendar() {
      if (!daysGrid || !monthNameText || !yearText) return;

      monthNameText.textContent = monthNames[currentMonthIdx];
      yearText.textContent = currentYear.toString();

      daysGrid.innerHTML = '';

      const firstDay = new Date(currentYear, currentMonthIdx, 1).getDay(); // 0 = Sunday
      const daysInMonth = new Date(currentYear, currentMonthIdx + 1, 0).getDate();

      const monthEventsList: any[] = [];

      // Always render EXACTLY 42 Cells (6 rows x 7 cols) for FIXED HEIGHT
      const totalGridCells = 42;

      for (let i = 0; i < totalGridCells; i++) {
        const cell = document.createElement('div');
        
        if (i < firstDay || i >= firstDay + daysInMonth) {
          cell.className = 'cal-day-cell empty';
        } else {
          const day = i - firstDay + 1;
          cell.className = 'cal-day-cell';
          cell.textContent = day.toString();

          const monthStr = String(currentMonthIdx + 1).padStart(2, '0');
          const dayStr = String(day).padStart(2, '0');
          const dateKey = `${currentYear}-${monthStr}-${dayStr}`;

          if (eventsData[dateKey]) {
            cell.classList.add('has-event');
            const dot = document.createElement('div');
            dot.className = 'event-dot-indicator';
            cell.appendChild(dot);

            eventsData[dateKey].forEach(ev => monthEventsList.push(ev));

            cell.addEventListener('click', () => {
              document.querySelectorAll('.cal-day-cell').forEach(c => c.classList.remove('selected'));
              cell.classList.add('selected');

              const targetCard = document.getElementById(`event-card-${dateKey}`);
              if (targetCard) {
                document.querySelectorAll('.event-agenda-card').forEach(c => c.classList.remove('highlighted'));
                targetCard.classList.add('highlighted');
                targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              }
            });
          }
        }
        daysGrid.appendChild(cell);
      }

      renderRightPanel(monthEventsList, monthNamesIndo[currentMonthIdx]);
    }

    function renderRightPanel(monthEvents: any[], monthName: string) {
      if (!agendaCardsList) return;

      agendaCardsList.innerHTML = '';

      if (monthEvents.length === 0) {
        if (streamTitle) streamTitle.textContent = `Agenda Bulan ${monthName} ${currentYear}`;
        if (countBadge) countBadge.textContent = `0 Kegiatan`;

        agendaCardsList.innerHTML = `
          <div class="no-events-card">
            <div class="no-events-icon">📅</div>
            <h4 class="no-events-title">Tidak Ada Kegiatan Terjadwal</h4>
            <p class="no-events-desc">Belum ada agenda program kerja HMP MIKROPTIK di bulan ${monthName} ${currentYear}.</p>
          </div>
        `;
      } else {
        if (streamTitle) streamTitle.textContent = `Agenda Bulan ${monthName} ${currentYear}`;
        if (countBadge) countBadge.textContent = `${monthEvents.length} Kegiatan Terjadwal`;

        monthEvents.forEach(item => {
          const card = document.createElement('article');
          card.className = 'event-agenda-card';
          card.id = `event-card-${item.dateKey}`;
          card.innerHTML = `
            <div class="event-card-left">
              <span class="event-category-badge">${item.category}</span>
              <span class="event-date-text">${item.dateStr}</span>
            </div>

            <div class="event-card-main">
              <div class="event-div-tag">${item.division}</div>
              <h4 class="event-title">${item.title}</h4>
              <p class="event-desc">${item.desc}</p>
              
              <div class="event-location-text">📍 ${item.location}</div>
            </div>
          `;
          agendaCardsList.appendChild(card);
        });
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentMonthIdx--;
        if (currentMonthIdx < 0) {
          currentMonthIdx = 11;
          currentYear--;
        }
        renderCalendar();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentMonthIdx++;
        if (currentMonthIdx > 11) {
          currentMonthIdx = 0;
          currentYear++;
        }
        renderCalendar();
      });
    }

    // Initial Render
    renderCalendar();
  });
</script>
