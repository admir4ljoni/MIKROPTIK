---
interface Props {
  imageSrc: string;
  imageAlt?: string;
  imageCaption?: string;
  reverse?: boolean;
}

const { imageSrc, imageAlt = "Foto Divisi", imageCaption, reverse = false } = Astro.props;
---

<section class="divisi-split-section">
  <div class="container">
    <div class={`divisi-split-grid ${reverse ? 'reverse' : ''}`}>
      <!-- Content Column -->
      <div class="split-content-col">
        <slot />
      </div>

      <!-- Image Column -->
      <div class="split-image-col">
        <div class="split-image-card">
          <img src={imageSrc} alt={imageAlt} class="split-img" loading="lazy" />
          <div class="split-img-overlay"></div>
          {imageCaption && (
            <div class="split-img-caption">
              <span>{imageCaption}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
