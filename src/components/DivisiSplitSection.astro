---
interface Props {
  imageSrc: string;
  imageAlt?: string;
  reverse?: boolean;
}

const { imageSrc, imageAlt = "Foto Divisi", reverse = false } = Astro.props;
---

<section class="divisi-split-section">
  <div class={`divisi-split-grid ${reverse ? 'reverse' : ''}`}>
    <!-- Content Column (50% Viewport Width) -->
    <div class="split-content-col">
      <div class="split-content-inner">
        <slot />
      </div>
    </div>

    <!-- Full Viewport Segment Image Column (No Card, No Outline, No Caption) -->
    <div class="split-image-col">
      <img src={imageSrc} alt={imageAlt} class="split-img-full" loading="lazy" />
      <div class="split-img-gradient"></div>
    </div>
  </div>
</section>
