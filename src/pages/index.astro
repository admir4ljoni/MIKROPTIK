---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatCounter from '../components/StatCounter.astro';
import ProgramCard from '../components/ProgramCard.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
import FilosofiCarousel from '../components/FilosofiCarousel.astro';
import { Code2, Users2, Clock3 } from '@lucide/astro';
---

<BaseLayout title="MIKROPTIK | Kabinet Naya Vikrama - HMP PTIK FKIP UNS">
  
  <!-- =========================================================================
       SECTION 2: HERO SECTION (100vh) - CENTERED & ARTISTIC
       ========================================================================= -->
  <section id="hero" class="hero-section">
    <div class="hero-bg-overlay"></div>
    
    <!-- Logo Background (Di belakang Teks Utama) -->
    <div class="hero-bg-logo-wrapper">
      <img 
        src="/assets/logo-kabinet.png" 
        alt="Logo Kabinet Naya Vikrama" 
        class="hero-bg-logo" 
      />
    </div>

    <!-- Teks Utama (Di depan Logo) -->
    <div class="hero-centered-container">
      <div class="hero-text-content">
        <h1 class="hero-title-main">
          HIMPUNAN <br />
          <span class="text-accent-highlight" style="font-size: 0.7em; color: var(--color-gold); display: block;">Mahasiswa</span>
          PTIK UNS
        </h1>
        <p class="hero-subtitle">
          Pendidikan Teknik Informatika dan Komputer <br />
          Fakultas Keguruan dan Ilmu Pendidikan, Universitas Sebelas Maret
        </p>
      </div>
    </div>

    <ScrollIndicator targetId="#about" />
  </section>


  <!-- =========================================================================
       SECTION 3: ABOUT / TENTANG KAMI
       ========================================================================= -->
  <section id="about" class="section bg-cream">
    <div class="container">
      <SectionHeading 
        titleMain="TENTANG" 
        titleAccent="Kami" 
        subtitle="Mengenal lebih dekat Himpunan Mahasiswa Pendidikan Teknik Informatika dan Komputer FKIP UNS"
        light={true}
      />

      <div class="about-grid" style="margin-top: 2rem;">
        <div>
          <h3 class="text-dark" style="font-size: 2rem; margin-bottom: 1rem;">
            WADAH ASPIRASI & KREATIFITAS MAHASISWA
          </h3>
          <p style="margin-bottom: 1rem; color: #444;">
            MIKROPTIK (Himpunan Mahasiswa Pendidikan Teknik Informatika dan Komputer) merupakan organisasi kemahasiswaan tingkat prodi di FKIP Universitas Sebelas Maret.
          </p>
          <p style="margin-bottom: 1.5rem; color: #444;">
            Pada periode 2025/2026, di bawah kepengurusan <strong style="color: var(--color-red-deep);">Kabinet Naya Vikrama</strong>, MIKROPTIK berkomitmen untuk beraksi dengan karya dan bersatu dalam kemajuan akademik maupun non-akademik.
          </p>
          <a href="#visi-misi" class="btn btn-primary">Lihat Visi & Misi</a>
        </div>

        <div class="about-card-visual">
          <h4 class="text-gold" style="margin-bottom: 1rem; text-align: center;">REKAM JEJAK KABINET</h4>
          <div class="about-stats-grid">
            <StatCounter number={45} label="Pengurus Aktif" />
            <StatCounter number={18} label="Program Kerja" />
            <StatCounter number={12} label="Prestasi Berhasil" />
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 4: FILOSOFI LOGO KABINET (CAROUSEL)
       ========================================================================= -->
  <section id="filosofi" class="section bg-dark">
    <div class="container">
      <SectionHeading 
        titleMain="FILOSOFI LOGO" 
        titleAccent="Naya Vikrama" 
        subtitle="Geser carousel di bawah untuk mengeksplorasi makna setiap elemen lambang Kabinet Naya Vikrama"
      />

      <FilosofiCarousel />
    </div>
  </section>


  <!-- =========================================================================
       SECTION 5: VISI & MISI
       ========================================================================= -->
  <section id="visi-misi" class="section bg-dark" style="border-top: 1px solid rgba(212, 179, 84, 0.2);">
    <div class="container">
      <SectionHeading 
        titleMain="VISI & MISI" 
        titleAccent="Organisasi" 
        subtitle="Arah gerak dan fondasi kepengurusan MIKROPTIK Kabinet Naya Vikrama"
      />

      <div class="visi-box">
        <span class="text-gold font-heading" style="font-size: 1.4rem; letter-spacing: 0.1em;">VISI UTAMA</span>
        <h3 class="text-white" style="font-size: 1.8rem; margin: 0.5rem 0 1rem;">
          "Mewujudkan MIKROPTIK sebagai Himpunan yang Kolaboratif, Inovatif, dan Berintegritas Tinggi dalam Mengabdi untuk Civitas Academica dan Masyarakat."
        </h3>
      </div>

      <div class="misi-grid">
        <div class="misi-card">
          <h4 class="text-gold" style="font-size: 1.3rem; margin-bottom: 0.5rem;">01. KEMAHASISWAAN</h4>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.8);">
            Meningkatkan kualitas akademik dan bakat non-akademik mahasiswa PTIK melalui pelatihan terstruktur dan kompetisi.
          </p>
        </div>

        <div class="misi-card">
          <h4 class="text-primary" style="font-size: 1.3rem; margin-bottom: 0.5rem;">02. ADVOKASI & KESEJAHTERAAN</h4>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.8);">
            Menjadi jembatan aspirasi yang responsif dan solutif antara mahasiswa dengan jajaran pengelola prodi dan fakultas.
          </p>
        </div>

        <div class="misi-card">
          <h4 class="text-gold" style="font-size: 1.3rem; margin-bottom: 0.5rem;">03. RELASI & PENGABDIAN</h4>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.8);">
            Membangun jejaring kolaborasi dengan alumni, industri IT, serta pengabdian masyarakat berbasis teknologi.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 6: PROGRAM KERJA / REKAM JEJAK
       ========================================================================= -->
  <section id="proker" class="section bg-cream">
    <div class="container">
      <SectionHeading 
        titleMain="PROGRAM" 
        titleAccent="Kerja Unggulan" 
        subtitle="Inisiatif strategis yang dilaksanakan oleh Kabinet Naya Vikrama"
        light={true}
      />

      <div class="proker-grid">
        <ProgramCard 
          title="INFORMATICS COMPASS 2025" 
          category="Internalization & Welcoming"
          description="Rangkaian pembekalan dan pengenalan dunia perkuliahan prodi PTIK bagi mahasiswa baru."
          image="https://picsum.photos/seed/proker1/600/400"
          date="Agustus 2025"
        />

        <ProgramCard 
          title="TECHNOFEST COMPETITION" 
          category="Akademik & Teknologi"
          description="Kompetisi nasional pengembangan web, UI/UX, dan competitive programming bagi pelajar & mahasiswa."
          image="https://picsum.photos/seed/proker2/600/400"
          date="Oktober 2025"
        />

        <ProgramCard 
          title="PTIK GOES TO COMMUNITY" 
          category="Pengabdian Masyarakat"
          description="Pelatihan literasi digital dan pembuatan website sederhana bagi UMKM desa binaan."
          image="https://picsum.photos/seed/proker3/600/400"
          date="November 2025"
        />
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 7: PRESTASI & MAHASISWA BERPRESTASI
       ========================================================================= -->
  <section id="prestasi" class="section bg-dark">
    <div class="container">
      <SectionHeading 
        titleMain="PRESTASI" 
        titleAccent="Mahasiswa PTIK" 
        subtitle="Bangga atas pencapaian dan kebanggaan civitas akademika PTIK UNS di kancah nasional"
      />

      <div class="misi-grid">
        <div class="misi-card" style="text-align: center;">
          <img src="https://picsum.photos/seed/mahasiswa1/300/300" alt="Mahasiswa Berprestasi" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 3px solid var(--color-gold);" />
          <h4 class="text-gold">Juara 1 Gemastik UI/UX 2025</h4>
          <p style="font-size: 0.85rem; color: #ccc;">Tim PTIK UNS Devs</p>
        </div>

        <div class="misi-card" style="text-align: center;">
          <img src="https://picsum.photos/seed/mahasiswa2/300/300" alt="Mahasiswa Berprestasi" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 3px solid var(--color-primary);" />
          <h4 class="text-primary">Best Paper National Conf</h4>
          <p style="font-size: 0.85rem; color: #ccc;">Ahmad & Tim Riset Data</p>
        </div>

        <div class="misi-card" style="text-align: center;">
          <img src="https://picsum.photos/seed/mahasiswa3/300/300" alt="Mahasiswa Berprestasi" style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 3px solid var(--color-gold);" />
          <h4 class="text-gold">Gold Medal Hackathon 2025</h4>
          <p style="font-size: 0.85rem; color: #ccc;">Siti & Tim Web Dev</p>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 8: TIPS & INSIGHT (MAHASISWA BARU - WITH LUCIDE ICONS)
       ========================================================================= -->
  <section id="tips" class="section bg-cream">
    <div class="container">
      <SectionHeading 
        titleMain="TIPS & INSIGHT" 
        titleAccent="Mahasiswa Baru" 
        subtitle="Panduan praktis agar adaptasi perkuliahan di PTIK UNS berjalan lancar dan berprestasi"
        light={true}
      />

      <div class="misi-grid">
        <div class="program-card" style="padding: 1.75rem; background: var(--color-white);">
          <div style="color: var(--color-red-deep); margin-bottom: 0.75rem;">
            <Code2 size={36} />
          </div>
          <h4 class="text-red-deep" style="font-size: 1.3rem; margin-bottom: 0.5rem;">FOKUS SKILL CODING & LOGIKA</h4>
          <p style="font-size: 0.9rem; color: #555;">Mulailah dari dasar algoritma dan pelajari bahasa pemrograman seperti Python, C++, atau JavaScript secara konsisten.</p>
        </div>

        <div class="program-card" style="padding: 1.75rem; background: var(--color-white);">
          <div style="color: var(--color-red-deep); margin-bottom: 0.75rem;">
            <Users2 size={36} />
          </div>
          <h4 class="text-red-deep" style="font-size: 1.3rem; margin-bottom: 0.5rem;">AKTIF BERORGANISASI</h4>
          <p style="font-size: 0.9rem; color: #555;">Gabung dengan MIKROPTIK untuk membangun soft skill, kemampuan kepemimpinan, dan jejaring teman sejawat.</p>
        </div>

        <div class="program-card" style="padding: 1.75rem; background: var(--color-white);">
          <div style="color: var(--color-red-deep); margin-bottom: 0.75rem;">
            <Clock3 size={36} />
          </div>
          <h4 class="text-red-deep" style="font-size: 1.3rem; margin-bottom: 0.5rem;">MANAJEMEN WAKTU EFISIEN</h4>
          <p style="font-size: 0.9rem; color: #555;">Seimbangkan antara tugas perkuliahan, proyek coding mandiri, kegiatan organisasi, dan waktu istirahat.</p>
        </div>
      </div>
    </div>
  </section>


  <!-- =========================================================================
       SECTION 9: PARTNERSHIP / CTA
       ========================================================================= -->
  <section id="cta" class="section bg-dark" style="background: radial-gradient(circle at center, var(--color-red-deep) 0%, var(--color-dark) 90%);">
    <div class="container" style="text-align: center;">
      <span class="text-gold font-heading" style="font-size: 1.5rem; letter-spacing: 0.1em;">KOLABORASI & SPONSORSHIP</span>
      <h2 style="font-size: clamp(2.5rem, 5vw, 4.5rem); margin: 0.5rem 0 1rem;">
        INDEPENDEN, KOLABORATIF, & BERDAMPINGAN
      </h2>
      <p style="max-width: 700px; margin: 0 auto 2rem; color: rgba(255,255,255,0.85); font-size: 1.1rem;">
        Ingin bermitra dengan MIKROPTIK dalam kegiatan perkuliahan, seminar teknologi, maupun media partner sponsorship? Hubungi tim kami sekarang!
      </p>

      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="https://wa.me/6287749444943" target="_blank" class="btn btn-primary">Hubungi Tim Partnership</a>
        <a href="#proker" class="btn btn-secondary">Proposal Kegiatan</a>
      </div>
    </div>
  </section>

</BaseLayout>
