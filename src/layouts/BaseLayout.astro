---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import '../styles/global.css';
import '../styles/sections.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  showPreloader?: boolean;
}

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const {
  title = "MIKROPTIK | Kabinet Naya Vikrama - HMP PTIK FKIP UNS 2026",
  description = "Official Website Himpunan Mahasiswa Pendidikan Teknik Informatika dan Komputer (HMP MIKROPTIK), Fakultas Keguruan dan Ilmu Pendidikan, Universitas Sebelas Maret (UNS). Kabinet Naya Vikrama 2026.",
  image = `${baseUrl}assets/logo-himpunan.png`,
  showPreloader = true
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : "https://mikroptik.ptik.uns.ac.id";
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).href;
const socialImageURL = new URL(image, siteOrigin).href;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "EducationalOrganization",
      "@id": `${siteOrigin}/#organization`,
      "name": "HMP MIKROPTIK FKIP UNS",
      "alternateName": ["MIKROPTIK", "HMP PTIK UNS", "Kabinet Naya Vikrama 2026"],
      "url": siteOrigin,
      "logo": `${siteOrigin}/assets/logo-himpunan.png`,
      "sameAs": [
        "https://www.instagram.com/mikroptik_uns",
        "https://www.youtube.com/@hmpmikroptikfkipuns",
        "https://tiktok.com/@mikroptik_uns"
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jl. Ahmad Yani No. 200, Pabelan, Kartasura",
        "addressLocality": "Surakarta",
        "addressRegion": "Jawa Tengah",
        "postalCode": "57161",
        "addressCountry": "ID"
      },
      "parentOrganization": {
        "@type": "CollegeOrUniversity",
        "name": "Universitas Sebelas Maret",
        "url": "https://uns.ac.id"
      }
    },
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "url": siteOrigin,
      "name": "MIKROPTIK FKIP UNS",
      "description": description,
      "publisher": {
        "@id": `${siteOrigin}/#organization`
      },
      "inLanguage": "id-ID"
    }
  ]
};
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Website Favicon Icon (Logo HMP MIKROPTIK) -->
  <link rel="icon" type="image/png" href={`${baseUrl}assets/logo-himpunan.png`} />
  <link rel="shortcut icon" type="image/png" href={`${baseUrl}assets/logo-himpunan.png`} />
  <link rel="apple-touch-icon" href={`${baseUrl}assets/logo-himpunan.png`} />
  
  <!-- FontAwesome 6 CDN for External Social Media Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content="HMP MIKROPTIK, MIKROPTIK, PTIK UNS, Pendidikan Teknik Informatika dan Komputer, Kabinet Naya Vikrama 2026, FKIP UNS, Universitas Sebelas Maret, Himpunan Mahasiswa PTIK" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="author" content="HMP MIKROPTIK FKIP UNS" />
  <meta name="generator" content={Astro.generator} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={socialImageURL} />
  <meta property="og:site_name" content="HMP MIKROPTIK FKIP UNS" />
  <meta property="og:locale" content="id_ID" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content={socialImageURL} />

  <!-- Preconnect Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Structured Data / JSON-LD for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</head>
<body>
  {showPreloader && <Preloader />}
  <Navbar />
  
  <main id="main-content">
    <slot />
  </main>

  <Footer />

  <script>
    import '../scripts/smooth-scroll.js';
    import '../scripts/preloader.js';
    import '../scripts/navbar.js';
    import '../scripts/animations.js';
  </script>
</body>
</html>
