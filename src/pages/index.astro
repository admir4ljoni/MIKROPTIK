---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StatCounter from "../components/StatCounter.astro";
import ProgramCard from "../components/ProgramCard.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import FilosofiCarousel from "../components/FilosofiCarousel.astro";
import ProkerBento from "../components/ProkerBento.astro";
---

<BaseLayout title="MIKROPTIK | Kabinet Naya Vikrama - HMP PTIK FKIP UNS">
  <!-- =========================================================================
       SECTION 2: HERO SECTION (100vh) - CENTERED & ARTISTIC
       ========================================================================= -->
  <section id="hero" class="hero-section">
    <div class="hero-bg-overlay"></div>

    <!-- Logo Background (Di belakang Teks Utama) -->
    <div class="hero-bg-logo-wrapper">
      <img
        src="/assets/logo-kabinet.png"
        alt="Logo Kabinet Naya Vikrama"
        class="hero-bg-logo"
      />
    </div>

    <!-- Teks Utama (Di depan Logo) -->
    <div class="hero-centered-container">
      <div class="hero-text-content">
        <h1 class="hero-title-main">
          HIMPUNAN <br />
          <span
            class="text-accent-highlight"
            style="font-size: 0.7em; color: var(--color-gold); display: block;"
            >Mahasiswa</span
          >
          PTIK UNS
        </h1>
        <p class="hero-subtitle">
          Pendidikan Teknik Informatika dan Komputer <br />
          Fakultas Keguruan dan Ilmu Pendidikan, Universitas Sebelas Maret
        </p>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 3: ABOUT / TENTANG KAMI (SLICED BENTO MOSAIC GRID)
       ========================================================================= -->
  <!-- =========================================================================
       SECTION 3: ABOUT / TENTANG KAMI (EXPANDING VERTICAL SLICED ACCORDION)
       ========================================================================= -->
  <section id="about" class="section about-accordion-section">
    <div class="container">
      <SectionHeading
        titleMain="TENTANG"
        titleAccent="Kami"
        subtitle="Geser kursor atau sentuh bilah di bawah untuk mengeksplorasi profil, pengurus, proker, dan prestasi MIKROPTIK"
      />

      <div class="sliced-accordion-container" id="about-accordion">
        <!-- Stripe 1: Profil Himpunan -->
        <div class="sliced-stripe stripe-1">
          <div class="stripe-img"></div>
          <div class="stripe-collapsed-label">SEKUM</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <span class="stripe-badge">PROFIL & SEJARAH</span>
              <h3 class="stripe-title">WADAH ASPIRASI & KARYA MAHASISWA</h3>
              <p class="stripe-description">
                MIKROPTIK (Himpunan Mahasiswa Pendidikan Teknik Informatika dan
                Komputer) merupakan organisasi eksekutif mahasiswa prodi di FKIP
                Universitas Sebelas Maret yang berfokus pada pengembangan
                potensi akademik, keterampilan teknologi, dan karakter
                integritas mahasiswa.
              </p>
            </div>
          </div>
        </div>

        <!-- Stripe 2: Kepengurusan Kabinet -->
        <div class="sliced-stripe stripe-2">
          <div class="stripe-img"></div>
          <div class="stripe-collapsed-label">BENDUM</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <span class="stripe-badge">KABINET 2025/2026</span>
              <h3 class="stripe-title">NAYA VIKRAMA (45+ PENGURUS)</h3>
              <p class="stripe-description">
                Di bawah kepengurusan Kabinet Naya Vikrama, 45+ pengurus aktif
                berdedikasi tinggi mengusung semangat "Beraksi dengan Karya,
                Bersatu dalam Kemajuan" demi kejayaan himpunan dan prodi PTIK
                UNS.
              </p>
            </div>
          </div>
        </div>

        <!-- Stripe 3: Program Kerja -->
        <div class="sliced-stripe stripe-3">
          <div class="stripe-img"></div>
          <div class="stripe-collapsed-label">PSDM</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <span class="stripe-badge">INISIATIF STRATEGIS</span>
              <h3 class="stripe-title">18+ PROGRAM KERJA UNGGULAN</h3>
              <p class="stripe-description">
                Meliputi kegiatan penerimaan mahasiswa baru (Informatics
                Compass), kompetisi IT skala nasional (Technofest Competition),
                workshop pengkodean, serta berbagai program pembekalan karier
                teknologi.
              </p>
            </div>
          </div>
        </div>

        <!-- Stripe 4: Advokasi & Aspirasi -->
        <div class="sliced-stripe stripe-4">
          <div class="stripe-img"></div>
          <div class="stripe-collapsed-label">HUMAS</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <span class="stripe-badge">ADVOKASI RESPONSIF</span>
              <h3 class="stripe-title">JEMBATAN ASPIRASI MAHASISWA</h3>
              <p class="stripe-description">
                Menyediakan layanan advokasi akademik & fasilitas kampus yang
                responsif, terpercaya, serta menjadi jembatan solusi antara
                mahasiswa dengan jajaran pengelola prodi dan fakultas.
              </p>
            </div>
          </div>
        </div>

        <!-- Stripe 5: Prestasi & Kejuaraan -->
        <div class="sliced-stripe stripe-5">
          <div class="stripe-img"></div>
          <div class="stripe-collapsed-label">MEDINFO</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <span class="stripe-badge">KEBANGGAAN KAMPUS</span>
              <h3 class="stripe-title">12+ PRESTASI NASIONAL</h3>
              <p class="stripe-description">
                Capaian kejuaraan dan penghargaan bergengsi mahasiswa PTIK UNS
                dalam ajang nasional seperti Gemastik UI/UX, Hackathon,
                Competitive Programming, dan Call for Papers.
              </p>
            </div>
          </div>
        </div>

        <!-- Stripe 6: Pengabdian Masyarakat -->
        <div class="sliced-stripe stripe-6">
          <div class="stripe-img"></div>
          <div class="stripe-collapsed-label">MIKAT</div>
          <div class="stripe-overlay">
            <div class="stripe-expanded-content">
              <span class="stripe-badge">PENGABDIAN MASYARAKAT</span>
              <h3 class="stripe-title">PTIK GOES TO COMMUNITY</h3>
              <p class="stripe-description">
                Wujud nyata kepedulian sosial mahasiswa melalui program
                pelatihan literasi digital, pemberdayaan UMKM desa binaan, dan
                sosialisasi pemanfaatan teknologi informasi bagi masyarakat.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const stripes = document.querySelectorAll(
        "#about-accordion .sliced-stripe",
      );
      stripes.forEach((stripe) => {
        stripe.addEventListener("click", () => {
          stripes.forEach((s) => s.classList.remove("active"));
          stripe.classList.add("active");
        });
      });
    });
  </script>

  <!-- =========================================================================
       SECTION 4: FILOSOFI LOGO KABINET (CAROUSEL)
       ========================================================================= -->
  <section id="filosofi" class="section bg-dark">
    <div class="container">
      <SectionHeading
        titleMain="FILOSOFI LOGO"
        titleAccent="Naya Vikrama"
        subtitle="Geser carousel di bawah untuk mengeksplorasi makna setiap elemen lambang Kabinet Naya Vikrama"
      />

      <FilosofiCarousel />
    </div>
  </section>

  <!-- =========================================================================
       SECTION 5: VISI & MISI
       ========================================================================= -->
  <!-- =========================================================================
       SECTION 5: VISI & MISI
       ========================================================================= -->
  <section id="visi-misi" class="section bg-dark">
    <div class="container">
      <SectionHeading
        titleMain="VISI & MISI"
        titleAccent="Organisasi"
        subtitle="Arah gerak dan fondasi kepengurusan MIKROPTIK Kabinet Naya Vikrama"
      />

      <div class="visi-box">
        <span
          class="text-gold font-heading"
          style="font-size: 1.4rem; letter-spacing: 0.1em;">VISI UTAMA</span
        >
        <h3
          class="text-white"
          style="font-size: 1.8rem; margin: 0.5rem 0 1rem;"
        >
          "Mewujudkan MIKROPTIK sebagai Himpunan yang Kolaboratif, Inovatif, dan
          Berintegritas Tinggi dalam Mengabdi untuk Civitas Academica dan
          Masyarakat."
        </h3>
      </div>

      <div class="misi-grid">
        <div class="misi-card">
          <h4
            class="text-gold"
            style="font-size: 1.3rem; margin-bottom: 0.5rem;"
          >
            01. KEMAHASISWAAN
          </h4>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.8);">
            Meningkatkan kualitas akademik dan bakat non-akademik mahasiswa PTIK
            melalui pelatihan terstruktur dan kompetisi.
          </p>
        </div>

        <div class="misi-card">
          <h4
            class="text-primary"
            style="font-size: 1.3rem; margin-bottom: 0.5rem;"
          >
            02. ADVOKASI & KESEJAHTERAAN
          </h4>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.8);">
            Menjadi jembatan aspirasi yang responsif dan solutif antara
            mahasiswa dengan jajaran pengelola prodi dan fakultas.
          </p>
        </div>

        <div class="misi-card">
          <h4
            class="text-gold"
            style="font-size: 1.3rem; margin-bottom: 0.5rem;"
          >
            03. RELASI & PENGABDIAN
          </h4>
          <p style="font-size: 0.9rem; color: rgba(255,255,255,0.8);">
            Membangun jejaring kolaborasi dengan alumni, industri IT, serta
            pengabdian masyarakat berbasis teknologi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 6: PROGRAM KERJA / REKAM JEJAK
       ========================================================================= -->
  <section id="proker" class="section bg-dark">
    <div class="container">
      <SectionHeading
        titleMain="PROGRAM"
        titleAccent="Kerja Unggulan"
        subtitle="Inisiatif strategis yang dilaksanakan oleh Kabinet Naya Vikrama"
      />
    </div>

    <ProkerBento />
  </section>

  <!-- =========================================================================
       SECTION 7: PRESTASI & MAHASISWA BERPRESTASI
       ========================================================================= -->
  <section id="prestasi" class="section bg-dark">
    <div class="container">
      <SectionHeading
        titleMain="PRESTASI"
        titleAccent="Mahasiswa PTIK"
        subtitle="Bangga atas pencapaian dan kebanggaan civitas akademika PTIK UNS di kancah nasional"
      />

      <div class="misi-grid">
        <div class="misi-card" style="text-align: center;">
          <img
            src="https://picsum.photos/seed/mahasiswa1/300/300"
            alt="Mahasiswa Berprestasi"
            style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 3px solid var(--color-gold);"
          />
          <h4 class="text-gold">Juara 1 Gemastik UI/UX 2025</h4>
          <p style="font-size: 0.85rem; color: #ccc;">Tim PTIK UNS Devs</p>
        </div>

        <div class="misi-card" style="text-align: center;">
          <img
            src="https://picsum.photos/seed/mahasiswa2/300/300"
            alt="Mahasiswa Berprestasi"
            style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 3px solid var(--color-primary);"
          />
          <h4 class="text-primary">Best Paper National Conf</h4>
          <p style="font-size: 0.85rem; color: #ccc;">Ahmad & Tim Riset Data</p>
        </div>

        <div class="misi-card" style="text-align: center;">
          <img
            src="https://picsum.photos/seed/mahasiswa3/300/300"
            alt="Mahasiswa Berprestasi"
            style="width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 1rem; object-fit: cover; border: 3px solid var(--color-gold);"
          />
          <h4 class="text-gold">Gold Medal Hackathon 2025</h4>
          <p style="font-size: 0.85rem; color: #ccc;">Siti & Tim Web Dev</p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       SECTION 8: PARTNERSHIP / CTA
       ========================================================================= -->
  <section id="cta" class="section cta-section">
    <div class="cta-container">
      <span class="cta-subtitle">KOLABORASI & SPONSORSHIP</span>
      <h2 class="cta-title">
        INDEPENDEN, KOLABORATIF, & BERDAMPINGAN
      </h2>
      <p class="cta-description">
        Ingin bermitra dengan MIKROPTIK dalam kegiatan perkuliahan, seminar
        teknologi, maupun media partner sponsorship? Hubungi tim kami sekarang!
      </p>

      <div class="cta-buttons-wrapper">
        <a
          href="https://wa.me/6287749444943"
          target="_blank"
          class="btn btn-primary btn-xl">Hubungi Tim Partnership</a
        >
        <a href="#proker" class="btn btn-secondary btn-xl">Proposal Kegiatan</a>
      </div>
    </div>
  </section>
</BaseLayout>
