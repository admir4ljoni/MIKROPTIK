---

---

<footer class="footer-container">
  <!-- Marquee Ticker -->
  <div class="marquee-container">
    <div class="marquee-content">
      <span
        >NAYA VIKRAMA • MIKROPTIK 2025/2026 • HMP PTIK FKIP UNS • BERAKSI DENGAN
        KARYA • BERSATU DALAM KEMAJUAN • NAYA VIKRAMA • MIKROPTIK 2025/2026 •
        HMP PTIK FKIP UNS • BERAKSI DENGAN KARYA • BERSATU DALAM KEMAJUAN •
      </span>
    </div>
  </div>

  <div class="container footer-content-wrapper">
    <div class="footer-grid">
      <!-- Column 1: Info & Logos -->
      <div>
        <div class="footer-logo-row">
          <img src={`${import.meta.env.BASE_URL}assets/logo-himpunan.png`} alt="Logo Himpunan MIKROPTIK" />
          <img src={`${import.meta.env.BASE_URL}assets/logo-ptik.png`} alt="Logo PTIK UNS" />
        </div>
        <h3 class="text-red-deep" style="font-size: 1.8rem; margin-bottom: 0.5rem;">
          MIKROPTIK
        </h3>
        <p
          style="font-size: 0.95rem; color: var(--color-dark); max-width: 320px;"
        >
          Himpunan Mahasiswa Pendidikan Teknik Informatika dan Komputer,
          Fakultas Keguruan dan Ilmu Pendidikan, Universitas Sebelas Maret.
        </p>
      </div>

      <!-- Column 2: Navigasi Cepat -->
      <div>
        <h4 class="text-red-deep" style="font-size: 1.3rem; margin-bottom: 1rem;">
          Navigasi
        </h4>
        <ul
          style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.95rem; color: var(--color-dark);"
        >
          <li><a href="#hero">Beranda</a></li>
          <li><a href="#about">Tentang Kami</a></li>
          <li><a href="#filosofi">Filosofi Logo</a></li>
          <li><a href="#visi-misi">Visi & Misi</a></li>
          <li><a href="#proker">Program Kerja</a></li>
          <li><a href="#kalender">Kalender Agenda</a></li>
        </ul>
      </div>

      <!-- Column 3: Kontak & Social Media -->
      <div>
        <h4 class="text-red-deep" style="font-size: 1.3rem; margin-bottom: 1rem;">
          Sosial Media & Sekretariat
        </h4>
        <p
          style="font-size: 0.95rem; color: var(--color-dark); margin-bottom: 1rem;"
        >
          Gedung D FKIP UNS, Jl. Ir. Sutami No. 36A, Surakarta, Jawa Tengah
          57126
        </p>
        <div style="display: flex; gap: 1rem; font-size: 0.95rem;">
          <a
            href="https://instagram.com/mikroptik_uns"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            style="padding: 0.45rem 1.25rem; font-size: 0.9rem;"
          >
            Instagram
          </a>
          <a
            href="https://youtube.com/@mikroptikuns"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
            style="padding: 0.45rem 1.25rem; font-size: 0.9rem;"
          >
            YouTube
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
