---
import { Calendar as CalendarIcon, Clock, MapPin, Tag, ChevronLeft, ChevronRight, Filter, Sparkles } from '@lucide/astro';

const eventsList = [
  // Kahim Wakahim
  { id: 1, title: "BYTESFEST 2026", division: "Kahim & Wakahim", divKey: "kahim", month: 9, monthName: "September", date: "15-20 Sep 2026", category: "Big Event", location: "Gedung UNS & Online", desc: "Festival IT dan kompetisi berskala nasional bagi pelajar & mahasiswa se-Indonesia." },
  { id: 2, title: "Upgrading Pengurus", division: "Kahim & Wakahim", divKey: "kahim", month: 3, monthName: "Maret", date: "12 Maret 2026", category: "Internal", location: "Ruang Ormawa PTIK", desc: "Peningkatan kapabilitas dan soliditas pengurus HMP MIKROPTIK 2026." },
  { id: 3, title: "Monitoring Bulanan", division: "Kahim & Wakahim", divKey: "kahim", month: 4, monthName: "April", date: "28 April 2026", category: "Rutin", location: "Sekretariat HMP", desc: "Evaluasi kinerja berkala jajaran bidang dan divisi kepengurusan." },
  
  // Sekretaris Umum & Bendahara Umum
  { id: 4, title: "Rapat Kerja (Raker)", division: "Sekben", divKey: "sekben", month: 2, monthName: "Februari", date: "10 Feb 2026", category: "Wajib", location: "Aula FKIP UNS", desc: "Penetapan dan sosialisasi seluruh arah gerak serta proker 2026." },
  { id: 5, title: "Pelatihan Sekben", division: "Sekben", divKey: "sekben", month: 3, monthName: "Maret", date: "05 Maret 2026", category: "Internal", location: "Lab Komputer PTIK", desc: "Pelatihan administrasi dan tata kelola keuangan organisasi." },
  { id: 6, title: "Mikroptik Store Launch", division: "Sekben", divKey: "sekben", month: 4, monthName: "April", date: "18 April 2026", category: "Dana Usaha", location: "Online & Sekre", desc: "Peluncuran merchandise dan produk resmi HMP MIKROPTIK." },
  
  // PSDM
  { id: 7, title: "Open Recruitment 2026", division: "PSDM", divKey: "psdm", month: 2, monthName: "Februari", date: "01-15 Feb 2026", category: "Kaderisasi", location: "Kampus PTIK UNS", desc: "Perekrutan pengurus muda HMP MIKROPTIK Kabinet Naya Vikrama." },
  { id: 8, title: "SAMARU & OSMARU", division: "PSDM", divKey: "psdm", month: 8, monthName: "Agustus", date: "18-22 Aug 2026", category: "Kaderisasi", location: "Kampus UNS", desc: "Penyambutan dan pengenalan kampus bagi mahasiswa baru PTIK." },
  { id: 9, title: "LDKM Naya Vikrama", division: "PSDM", divKey: "psdm", month: 10, monthName: "Oktober", date: "10-12 Oct 2026", category: "Kaderisasi", location: "Outbound Camp", desc: "Latihan Dasar Kepemimpinan Mahasiswa untuk membentuk kepemimpinan progresif." },
  { id: 10, title: "PSDM Adventure", division: "PSDM", divKey: "psdm", month: 11, monthName: "November", date: "07 Nov 2026", category: "Internal", location: "Tawangmangu", desc: "Kegiatan keakraban dan penguatan karakter antar pengurus." },
  
  // Humas
  { id: 11, title: "Mikroptik Social Action (MSA)", division: "Humas", divKey: "humas", month: 3, monthName: "Maret", date: "24 Maret 2026", category: "Aksi Sosial", location: "Surakarta", desc: "Aksi berbagi takjil dan pengabdian masyarakat di bulan suci Ramadhan." },
  { id: 12, title: "Studi Banding Himpunan", division: "Humas", divKey: "humas", month: 5, monthName: "Mei", date: "16 Mei 2026", category: "Eksternal", location: "Universitas Mitra", desc: "Pertukaran wawasan dan studi budaya organisasi dengan HMP kampus lain." },
  { id: 13, title: "JPTK Berbagi & Sambung Rasa", division: "Humas", divKey: "humas", month: 6, monthName: "Juni", date: "10 Juni 2026", category: "Advokasi", location: "Ruang Diskusi PTIK", desc: "Ruang aspirasi mahasiswa dan sarasehan bersama pengelola prodi." },
  { id: 14, title: "Sambut Wisuda PTIK", division: "Humas", divKey: "humas", month: 8, monthName: "Agustus", date: "29 Aug 2026", category: "Apresiasi", location: "Gedung FKIP UNS", desc: "Apresiasi dan pelepasan wisudawan/wisudawati prodi PTIK UNS." },
  
  // Medinfo
  { id: 15, title: "Podcast Mikroptik Ep.1", division: "Medinfo", divKey: "medinfo", month: 4, monthName: "April", date: "20 April 2026", category: "Media", location: "Studio Podcast & YouTube", desc: "Bincang santai seputar dunia perkuliahan IT dan pengalaman alumni." },
  { id: 16, title: "Publikasi PDD & Sosmed", division: "Medinfo", divKey: "medinfo", month: 7, monthName: "Juli", date: "Setiap Bulan", category: "Media", location: "Instagram & TikTok", desc: "Pengelolaan konten informasi digital dan dokumentasi proker." },
  
  // Mikat
  { id: 17, title: "Study Club Tech", division: "Mikat", divKey: "mikat", month: 5, monthName: "Mei", date: "Mulai Mei 2026", category: "Skill Development", location: "Lab Komputer PTIK", desc: "Sesi intensif pemantapan coding, riset ilmiah, dan karya digital." },
  { id: 18, title: "JPTK CUP 2026", division: "Mikat", divKey: "mikat", month: 6, monthName: "Juni", date: "05-12 Juni 2026", category: "Olahraga & Seni", location: "Sport Center UNS", desc: "Pekan olahraga, E-Sports, dan seni antar angkatan civitas PTIK." },
  { id: 19, title: "Festival MIKAT & Seminar PKM", division: "Mikat", divKey: "mikat", month: 11, monthName: "November", date: "20 Nov 2026", category: "Akademik & Seni", location: "Aula UNS", desc: "Pameran bakat, seminar Program Kreativitas Mahasiswa, dan apresiasi prestasi." }
];

const monthNames = [
  "Januari", "Februari", "Maret", "April", "Mei", "Juni",
  "Juli", "Agustus", "September", "Oktober", "November", "Desember"
];
---

<div class="calendar-section-wrapper" id="kalender-event">
  <!-- Top Division Filter Tabs -->
  <div class="calendar-div-filters">
    <button class="div-tab active" data-div="all">Semua Agenda</button>
    <button class="div-tab" data-div="kahim">Kahim & Wakahim</button>
    <button class="div-tab" data-div="sekben">Sekben</button>
    <button class="div-tab" data-div="psdm">PSDM</button>
    <button class="div-tab" data-div="humas">Humas</button>
    <button class="div-tab" data-div="medinfo">Medinfo</button>
    <button class="div-tab" data-div="mikat">Mikat</button>
  </div>

  <div class="calendar-main-grid">
    <!-- SEBELAH KIRI: Interactive Month Selector & Mini Grid -->
    <div class="calendar-left-panel">
      <div class="month-selector-box">
        <div class="month-selector-header">
          <span class="calendar-year-title">AGENDA 2026</span>
          <span class="calendar-subtext">Pilih bulan untuk memfilter agenda</span>
        </div>

        <div class="month-buttons-grid">
          {monthNames.map((mName, idx) => (
            <button
              class={`month-btn ${idx === 2 ? 'active' : ''}`}
              data-month={idx + 1}
            >
              <span class="m-num">0{idx + 1}</span>
              <span class="m-name">{mName}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- SEBELAH KANAN: Agenda Cards Stream -->
    <div class="calendar-right-panel">
      <div class="agenda-stream-header">
        <h3 class="agenda-stream-title" id="agenda-stream-title">Agenda Bulan Maret 2026</h3>
        <span class="agenda-count-badge" id="agenda-count-badge">3 Agenda Terjadwal</span>
      </div>

      <div class="agenda-cards-list" id="agenda-cards-list">
        {eventsList.map((item) => (
          <article
            class="event-agenda-card"
            data-month={item.month}
            data-div={item.divKey}
          >
            <div class="event-card-left">
              <span class="event-category-badge">{item.category}</span>
              <span class="event-date-text">
                <CalendarIcon size={14} style="display: inline-block; vertical-align: middle; margin-right: 4px;" />
                {item.date}
              </span>
            </div>

            <div class="event-card-main">
              <div class="event-div-tag">{item.division}</div>
              <h4 class="event-title">{item.title}</h4>
              <p class="event-desc">{item.desc}</p>
              
              <div class="event-location-text">
                <MapPin size={14} style="display: inline-block; vertical-align: middle; margin-right: 4px; color: var(--color-gold);" />
                {item.location}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .calendar-section-wrapper {
    position: relative;
    width: 100%;
    margin-top: 1.5rem;
  }

  /* Division Filter Buttons */
  .calendar-div-filters {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
  }

  .div-tab {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 179, 84, 0.3);
    color: rgba(255, 255, 255, 0.82);
    font-family: var(--font-body);
    font-size: 0.88rem;
    padding: 0.55rem 1.25rem;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .div-tab:hover,
  .div-tab.active {
    background: linear-gradient(135deg, rgba(130, 9, 7, 0.85) 0%, rgba(28, 22, 20, 0.95) 100%);
    border-color: var(--color-gold);
    color: var(--color-gold);
    box-shadow: 0 6px 20px rgba(130, 9, 7, 0.4);
    transform: translateY(-2px);
  }

  /* Main Grid Layout */
  .calendar-main-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 2.5rem;
    align-items: start;
    width: 100%;
  }

  /* SEBELAH KIRI: Month Selector */
  .calendar-left-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .month-selector-box {
    background: var(--color-dark);
    border: 1.5px solid rgba(212, 179, 84, 0.3);
    border-radius: var(--radius-sm);
    padding: 2rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
  }

  .month-selector-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(212, 179, 84, 0.25);
  }

  .calendar-year-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--color-gold);
    letter-spacing: 0.08em;
  }

  .calendar-subtext {
    font-family: var(--font-body);
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .month-buttons-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .month-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .month-btn:hover,
  .month-btn.active {
    background: rgba(130, 9, 7, 0.8);
    border-color: var(--color-gold);
    color: var(--color-gold);
    box-shadow: 0 4px 15px rgba(130, 9, 7, 0.35);
  }

  .m-num {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    opacity: 0.7;
  }

  .m-name {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
  }

  /* SEBELAH KANAN: Agenda Stream */
  .calendar-right-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 440px;
  }

  .agenda-stream-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1.5px solid rgba(212, 179, 84, 0.3);
  }

  .agenda-stream-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    color: var(--color-gold);
    letter-spacing: 0.05em;
  }

  .agenda-count-badge {
    background: rgba(130, 9, 7, 0.75);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(212, 179, 84, 0.4);
  }

  .agenda-cards-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Event Agenda Card - Dark Gold Style */
  .event-agenda-card {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-dark);
    border: 1.5px solid rgba(212, 179, 84, 0.25);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.45);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .event-agenda-card:hover {
    transform: translateX(6px);
    border-color: var(--color-gold);
    box-shadow: 0 15px 35px rgba(130, 9, 7, 0.4);
  }

  .event-agenda-card.is-hidden {
    display: none;
  }

  .event-card-left {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .event-category-badge {
    background: linear-gradient(135deg, #d4b354 0%, #820907 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.6rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    text-align: center;
  }

  .event-date-text {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    color: var(--color-gold);
    line-height: 1.3;
  }

  .event-card-main {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .event-div-tag {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-white);
    line-height: 1.2;
  }

  .event-desc {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.5;
  }

  .event-location-text {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    margin-top: 0.25rem;
  }

  @media (max-width: 900px) {
    .calendar-main-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .event-agenda-card {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const monthBtns = document.querySelectorAll('.month-btn');
    const divTabs = document.querySelectorAll('.div-tab');
    const eventCards = document.querySelectorAll('.event-agenda-card');
    const streamTitle = document.getElementById('agenda-stream-title');
    const countBadge = document.getElementById('agenda-count-badge');

    const monthNames = [
      "Januari", "Februari", "Maret", "April", "Mei", "Juni",
      "Juli", "Agustus", "September", "Oktober", "November", "Desember"
    ];

    let selectedMonth = 3; // Default Maret
    let selectedDiv = 'all';

    function updateAgendaStream() {
      let visibleCount = 0;

      eventCards.forEach(card => {
        const cardMonth = parseInt(card.getAttribute('data-month') || '0', 10);
        const cardDiv = card.getAttribute('data-div');

        const monthMatch = (selectedMonth === 0 || cardMonth === selectedMonth);
        const divMatch = (selectedDiv === 'all' || cardDiv === selectedDiv);

        if (monthMatch && divMatch) {
          card.classList.remove('is-hidden');
          visibleCount++;
        } else {
          card.classList.add('is-hidden');
        }
      });

      if (streamTitle) {
        if (selectedMonth === 0) {
          streamTitle.textContent = "Seluruh Agenda Kepengurusan 2026";
        } else {
          streamTitle.textContent = `Agenda Bulan ${monthNames[selectedMonth - 1]} 2026`;
        }
      }

      if (countBadge) {
        countBadge.textContent = `${visibleCount} Agenda Terjadwal`;
      }
    }

    // Month Selector Buttons Listener
    monthBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const month = parseInt(btn.getAttribute('data-month') || '0', 10);
        selectedMonth = month;

        monthBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        updateAgendaStream();
      });
    });

    // Division Filter Tabs Listener
    divTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const divKey = tab.getAttribute('data-div') || 'all';
        selectedDiv = divKey;

        divTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        updateAgendaStream();
      });
    });

    // Initial Filter Update
    updateAgendaStream();
  });
</script>
