---
import DivisiLayout from '../../layouts/DivisiLayout.astro';
import DivisiHero from '../../components/DivisiHero.astro';
import DivisiProker from '../../components/DivisiProker.astro';
import DivisiFotoGaleri from '../../components/DivisiFotoGaleri.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const divisiData = {
  name: "MEDINFO",
  badge: "DIVISI MEDINFO",
  tagline: "Media Informasi, Publikasi & Dokumentasi Digital",
  slug: "medinfo",
  bgImage: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO BERSAMA.JPG",
  description: "Divisi Medinfo HMP MIKROPTIK adalah divisi yang bertanggung jawab dalam pengelolaan media informasi dan dokumentasi HMP MIKROPTIK. Program kerjanya meliputi Pengelolaan Media Sosial, dokumentasi kegiatan, PDD (Publikasi, Dokumentasi, dan Desain), Podcast sebagai media informasi dan edukasi. Divisi ini juga menjadi wadah bagi mahasiswa untuk mengembangkan kemampuan di bidang desain grafis, fotografi, dan videografi. Bergabung di Divisi Medinfo HMP MIKROPTIK memberikan kesempatan untuk meningkatkan kreativitas, mengasah keterampilan, dan memperoleh pengalaman baru.",
  kepala: {
    nama: "Adinda Putri Utami",
    jabatan: "KADIV MEDINFO"
  },
  staff: [
    { nama: "Aghniya Adz-Dzikri", jabatan: "STAFF MEDINFO" },
    { nama: "Anisa Ramadhani", jabatan: "STAFF MEDINFO" },
    { nama: "Dhafin Rifki Bayu Santoso", jabatan: "STAFF MEDINFO" },
    { nama: "Muhammad Ramdhani", jabatan: "STAFF MEDINFO" },
    { nama: "Aksya Nayla Fitriana", jabatan: "STAFF MEDINFO" },
    { nama: "Awang Bintang Muhammad Lazuardi", jabatan: "STAFF MEDINFO" },
    { nama: "Dafa Syahrul Syah Baharudin", jabatan: "STAFF MEDINFO" },
    { nama: "Fathma Daniswara Tyaswa Putri", jabatan: "STAFF MEDINFO" },
    { nama: "Sabrosa Noval Rachmadhani", jabatan: "STAFF MEDINFO" },
    { nama: "Sheva Jalu Atmaja", jabatan: "STAFF MEDINFO" }
  ],
  proker: [
    "DOKUMENTASI KEGIATAN",
    "PDD (PUBLIKASI, DOKUMENTASI, & DESAIN)",
    "PENGELOLAAN SOSIAL MEDIA",
    "PODCAST MIKROPTIK"
  ],
  galeri: [
    { title: "Foto Bersama Divisi MEDINFO", src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO BERSAMA.JPG", isFeatured: true },
    { title: "Kadiv MEDINFO", src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO KADIV.JPG" },
    { title: "Staff Ahli MEDINFO", src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF AHLI.JPG" },
    { title: "Staff Muda MEDINFO 1", src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF MUDA 1.JPG" },
    { title: "Staff Muda MEDINFO 2", src: "/assets/Foto Kabinet/Foto Divisi/MEDINFO/FOTO STAFF MUDA 2.JPG" }
  ]
};
---

<DivisiLayout
  divisiName={divisiData.name}
  divisiBadge={divisiData.badge}
  divisiTagline={divisiData.tagline}
  divisiSlug={divisiData.slug}
  prevDivisi={{ name: "HUMAS", slug: "humas" }}
>
  <!-- Hero Section -->
  <DivisiHero
    title={divisiData.name}
    badge={divisiData.badge}
    tagline={divisiData.tagline}
    description="Pusat media digital, publikasi visual, PDD, dokumentasi fotografi & videografi, serta podcast edukasi HMP MIKROPTIK."
    bgImage={divisiData.bgImage}
  />

  <!-- Deskripsi Section -->
  <section class="divisi-desc-section">
    <div class="container">
      <SectionHeading
        titleMain="PROFIL"
        titleAccent="Divisi"
        subtitle="Peran dan fokus utama Divisi Medinfo dalam menghadirkan konten kreatif & branding visual"
      />
      <div class="divisi-desc-box">
        <p class="divisi-desc-text">{divisiData.description}</p>
      </div>
    </div>
  </section>

  <!-- Proker Section -->
  <DivisiProker prokerList={divisiData.proker} />

  <!-- Foto Galeri Section -->
  <DivisiFotoGaleri fotoList={divisiData.galeri} />
</DivisiLayout>
