---
interface Props {
  title: string;
  badge?: string;
  tagline?: string;
  description: string;
  bgImage: string;
  bgPosition?: string;
}

const { 
  title, 
  tagline, 
  description, 
  bgImage, 
  bgPosition = "center 60%" 
} = Astro.props;
---

<section class="divisi-hero-section">
  <!-- Background Image with Parallax readiness -->
  <div 
    class="divisi-hero-bg" 
    style={`background-image: url('${bgImage}'); background-position: ${bgPosition};`}
  ></div>

  <!-- Dark Gradient Overlay -->
  <div class="divisi-hero-overlay"></div>

  <!-- Hero Content Box -->
  <div class="divisi-hero-content">
    <h1 class="divisi-hero-title">{title}</h1>
    {tagline && <p class="divisi-hero-tagline">{tagline}</p>}
    <p class="divisi-hero-desc">{description}</p>
  </div>
</section>
