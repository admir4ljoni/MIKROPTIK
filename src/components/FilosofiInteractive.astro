<style>
  .filosofi-interactive-container {
    position: relative;
    width: 100%;
    margin-top: 1rem;
  }

  .filosofi-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 3.5rem;
    align-items: center;
    width: 100%;
  }

  /* SEBELAH KIRI: SVG Artwork Container */
  .filosofi-visual-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .mobile-tap-hint {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-sm);
    background: rgba(130, 9, 7, 0.45);
    border: 1px solid rgba(212, 179, 84, 0.5);
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-size: 0.84rem;
    letter-spacing: 0.04em;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    animation: pulseHint 2s infinite ease-in-out;
  }

  @keyframes pulseHint {
    0%, 100% {
      transform: translateY(0);
      opacity: 0.9;
    }
    50% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    .filosofi-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .filosofi-dark-card {
      padding: 2rem 1.5rem;
    }

    .mobile-tap-hint {
      display: inline-flex;
    }
  }

  .logo-stack-box {
    position: relative;
    width: clamp(320px, 38vw, 480px);
    height: clamp(320px, 38vw, 480px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .interactive-logo-svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    overflow: visible;
    filter: drop-shadow(0 0 25px rgba(212, 179, 84, 0.5))
            drop-shadow(0 0 60px rgba(212, 179, 84, 0.25));
    transition: filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* SVG Vector Groups for 100% Precise Path Hit Testing */
  .svg-part-group {
    cursor: pointer;
    pointer-events: visiblePainted;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center center;
  }

  /* Hover state: dim non-hovered parts to grayscale */
  .interactive-logo-svg.is-hovered .svg-part-group {
    opacity: 0.25;
    filter: grayscale(100%);
  }

  /* Active hovered part lights up in 100% full vivid color with golden drop-shadow glow */
  .interactive-logo-svg.is-hovered .svg-part-group.active-part {
    opacity: 1;
    filter: grayscale(0%) drop-shadow(0 0 45px rgba(212, 179, 84, 0.95));
    transform: scale(1.03);
  }

  /* SEBELAH KANAN: Dark Background Card Panel (Per DESIGN.md) */
  .filosofi-content-right {
    display: flex;
    flex-direction: column;
    position: relative;
    min-height: 320px;
    justify-content: center;
  }

  .filosofi-dark-card {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: 2.75rem 2.25rem;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    background: var(--color-dark); /* #1c1614 */
    border: 1.5px solid var(--color-gold); /* #d4b354 */
    box-shadow: 0 20px 50px rgba(130, 9, 7, 0.45);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .filosofi-dark-card.active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .filosofi-card-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.2vw, 3rem);
    color: var(--color-gold); /* #d4b354 */
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .filosofi-card-desc {
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.15vw, 1.08rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .filosofi-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .filosofi-dark-card {
      padding: 2rem 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const svg = document.getElementById('interactive-logo-svg');
    const partGroups = document.querySelectorAll('.svg-part-group');
    const cards = document.querySelectorAll('.filosofi-dark-card');

    if (!svg || partGroups.length === 0) return;

    let activePartId = '0';

    function activatePart(partId: string) {
      if (activePartId === partId) return;
      activePartId = partId;

      if (partId === '0') {
        svg.classList.remove('is-hovered');
        partGroups.forEach(g => g.classList.remove('active-part'));
      } else {
        svg.classList.add('is-hovered');
        partGroups.forEach(g => {
          if (g.getAttribute('data-part') === partId) {
            g.classList.add('active-part');
          } else {
            g.classList.remove('active-part');
          }
        });
      }

      cards.forEach(card => {
        if (card.getAttribute('data-card') === partId) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }

    // Direct GPU Vector Path Mouse/Touch Event Listeners
    partGroups.forEach(group => {
      const partId = group.getAttribute('data-part') || '0';

      group.addEventListener('mouseenter', () => {
        activatePart(partId);
      });

      group.addEventListener('pointerenter', () => {
        activatePart(partId);
      });

      group.addEventListener('click', () => {
        activatePart(partId);
      });
    });

    svg.addEventListener('mouseleave', () => {
      activatePart('0');
    });

    svg.addEventListener('pointerleave', () => {
      activatePart('0');
    });
  });
</script>
