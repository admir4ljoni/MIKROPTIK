---
const bentoItems = [
  {
    id: 1,
    title: "INFORMATICS COMPASS 2025",
    subtitle: "Rangkaian Pembekalan & Adaptasi",
    description: "Program pembekalan dan pengenalan dunia perkuliahan, budaya akademik, serta kurikulum prodi PTIK UNS bagi seluruh mahasiswa baru.",
    image: "https://picsum.photos/seed/proker1/1000/700",
    gridClass: "bento-item-large" // Span 2 cols, height 480px
  },
  {
    id: 2,
    title: "TECHNOFEST COMPETITION",
    subtitle: "Ajang Kompetisi IT Nasional",
    description: "Kompetisi nasional Web Development, UI/UX Design, dan Competitive Programming untuk mencetak inovator muda.",
    image: "https://picsum.photos/seed/proker2/700/1000",
    gridClass: "bento-item-tall" // Span 1 col, height 480px
  },
  {
    id: 3,
    title: "PTIK GOES TO COMMUNITY",
    subtitle: "Pengabdian & Literasi Digital",
    description: "Pelatihan literasi digital, branding sosial media, dan pembuatan website bagi UMKM desa binaan secara berkelanjutan.",
    image: "https://picsum.photos/seed/proker3/800/600",
    gridClass: "bento-item-medium" // Span 1 col, height 300px
  },
  {
    id: 4,
    title: "WORKSHOP & STUDY CLUB TECH",
    subtitle: "Pengembangan Skill Software",
    description: "Sesi harian & bulanan pengasahan skill coding, cloud, dan AI bersama praktisi alumni industri teknologi.",
    image: "https://picsum.photos/seed/proker4/800/600",
    gridClass: "bento-item-medium" // Span 1 col, height 300px
  },
  {
    id: 5,
    title: "PTIK CAREER & ALUMNI EXPO",
    subtitle: "Jejaring Karir & Industri",
    description: "Ajang temu alumni dan perusahaan mitra IT untuk membuka wawasan karir dan peluang magang mahasiswa.",
    image: "https://picsum.photos/seed/proker5/800/600",
    gridClass: "bento-item-medium" // Span 1 col, height 300px
  }
];
---

<div class="proker-bento-grid">
  {bentoItems.map((item) => (
    <article class={`bento-card ${item.gridClass}`}>
      <!-- Background Full Image -->
      <img src={item.image} alt={item.title} class="bento-bg-img" loading="lazy" />

      <!-- Bottom Shadow Overlay Gradient -->
      <div class="bento-card-overlay">
        <div class="bento-card-content">
          <span class="bento-subtitle">{item.subtitle}</span>
          <h3 class="bento-title">{item.title}</h3>
          <p class="bento-desc">{item.description}</p>
        </div>
      </div>
    </article>
  ))}
</div>

<style>
  .proker-bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
    margin-top: 1rem;
  }

  /* Base Bento Card Style - Style Tegas (Corner Radius Kecil, Border-Free) */
  .bento-card {
    position: relative;
    border-radius: var(--radius-sm); /* Style tegas 4px */
    overflow: hidden;
    border: none;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
    cursor: pointer;
  }

  .bento-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 45px rgba(130, 9, 7, 0.45);
  }

  /* Variations by Grid Layout */
  .bento-item-large {
    grid-column: span 2;
    height: 480px;
  }

  .bento-item-tall {
    grid-column: span 1;
    height: 480px;
  }

  .bento-item-medium {
    grid-column: span 1;
    height: 320px;
  }

  /* Image Background Zoom */
  .bento-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .bento-card:hover .bento-bg-img {
    transform: scale(1.06);
  }

  /* Bottom Shadow Overlay Gradient */
  .bento-card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    background: linear-gradient(
      to top,
      rgba(28, 22, 20, 0.97) 0%,
      rgba(28, 22, 20, 0.82) 45%,
      rgba(28, 22, 20, 0.25) 75%,
      transparent 100%
    );
    z-index: 2;
  }

  .bento-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bento-subtitle {
    font-family: var(--font-heading);
    font-size: clamp(0.85rem, 1.2vw, 1.1rem);
    color: var(--color-gold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .bento-title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 2.5vw, 2.5rem);
    color: var(--color-white);
    line-height: 1.05;
    letter-spacing: 0.05em;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
  }

  .bento-desc {
    font-family: var(--font-body);
    font-size: clamp(0.88rem, 1vw, 1rem);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.55;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.8);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Responsive Mobile Adjustments */
  @media (max-width: 900px) {
    .proker-bento-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .bento-item-large,
    .bento-item-tall,
    .bento-item-medium {
      grid-column: span 1;
      height: 380px;
    }
  }
</style>
