---
interface Props {
  title: string;
  description: string;
  image?: string;
  date?: string;
}

const {
  title,
  description,
  image = "https://picsum.photos/seed/proker/600/400",
  date = "2025/2026",
} = Astro.props;
---

<article class="program-card gsap-card-item">
  <img src={image} alt={title} class="program-card-img" loading="lazy" />
  <div class="program-card-body">
    <div
      style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;"
    >
      <span style="font-size: 0.8rem; color: rgba(255, 255, 255, 0.6);"
        >{date}</span
      >
    </div>
    <h3
      style="font-size: 1.5rem; color: var(--color-gold); margin-bottom: 0.5rem; letter-spacing: 0.04em;"
    >
      {title}
    </h3>
    <p
      style="font-size: 0.9rem; color: rgba(255, 255, 255, 0.85); line-height: 1.5;"
    >
      {description}
    </p>
  </div>
</article>
